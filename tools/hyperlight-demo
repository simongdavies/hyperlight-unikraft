        demo_pid=""
    fi
    if [[ -n "$upstream_pid" ]]; then
        kill -TERM "$upstream_pid" 2>/dev/null || true
        wait "$upstream_pid" 2>/dev/null || true
        upstream_pid=""
    fi
    local pid
