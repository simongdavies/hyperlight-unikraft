stop_processes() {
    finish_progress
    # Two-phase shutdown: signal every tracked process first, then wait on
    # all of them. Each process's shutdown (closing its VM, flushing
    # hyperlight resources) then proceeds concurrently instead of being
    # queued one-at-a-time behind the previous process's wait — at
    # hundreds of `extra_pids` (one per benchmark-resident app) that
    # serialized kill-then-wait loop was the dominant teardown cost.
    local -a signaled_pids=()
    if [[ -n "$demo_pid" ]]; then
        kill -TERM "$demo_pid" 2>/dev/null || true
        signaled_pids+=("$demo_pid")
    fi
    if [[ -n "$upstream_pid" ]]; then
        kill -TERM "$upstream_pid" 2>/dev/null || true
        signaled_pids+=("$upstream_pid")
    fi
    local pid
    for pid in "${extra_pids[@]:-}"; do
        [[ -n "$pid" ]] || continue
        kill -TERM "$pid" 2>/dev/null || true
        signaled_pids+=("$pid")
    done
    for pid in "${signaled_pids[@]:-}"; do
        wait "$pid" 2>/dev/null || true
    done
    demo_pid=""
    upstream_pid=""
    extra_pids=()
}
trap stop_processes EXIT INT TERM

stop_demo() {
    if [[ -n "$demo_pid" ]]; then
        kill -TERM "$demo_pid" 2>/dev/null || true
        wait "$demo_pid" 2>/dev/null || true
        demo_pid=""
    fi
}

