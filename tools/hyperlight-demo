set -euo pipefail

configure_user_home() {
    local variable="$1"
    local fallback="$2"
    local value="${!variable:-$fallback}"
    local probe

    if ! mkdir -p "$value" 2>/dev/null ||
        ! probe="$(mktemp "$value/.hyperlight-write-test.XXXXXX" 2>/dev/null)"; then
        printf 'warning: %s=%s is not writable; using %s\n' \
            "$variable" "$value" "$fallback" >&2
        value="$fallback"
        mkdir -p "$value"
        probe="$(mktemp "$value/.hyperlight-write-test.XXXXXX")"
    fi
    rm -f -- "$probe"
    printf -v "$variable" '%s' "$value"
    export "$variable"
}

configure_user_home CARGO_HOME "$HOME/.cargo"
configure_user_home RUSTUP_HOME "$HOME/.rustup"

normalize_path() {
    local value
    value="$(realpath -m "$1")"
    if [[ "$value" =~ ^([A-Za-z]):/(.*)$ ]]; then
        value="/${BASH_REMATCH[1],,}/${BASH_REMATCH[2]}"
    fi
    printf '%s\n' "$value"
}

cpu_topology="$(LC_ALL=C lscpu 2>/dev/null || true)"
lscpu_value() {
    local label="$1"
    awk -F: -v label="$label" '
        $1 == label {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
            print $2
            exit
        }
    ' <<<"$cpu_topology"
}

logical_cpus="$(lscpu_value "CPU(s)")"
if [[ ! "$logical_cpus" =~ ^[1-9][0-9]*$ ]]; then
    logical_cpus="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)"
fi
cpu_sockets="$(lscpu_value "Socket(s)")"
[[ "$cpu_sockets" =~ ^[1-9][0-9]*$ ]] || cpu_sockets=1
cores_per_socket="$(lscpu_value "Core(s) per socket")"
[[ "$cores_per_socket" =~ ^[1-9][0-9]*$ ]] || cores_per_socket="$logical_cpus"
threads_per_core="$(lscpu_value "Thread(s) per core")"
[[ "$threads_per_core" =~ ^[1-9][0-9]*$ ]] || threads_per_core=1
physical_cores=$((cpu_sockets * cores_per_socket))

root="$(normalize_path "$(cd "$(dirname "$0")/.." && pwd)")"
output_dir="${HYPERLIGHT_DEMO_OUTPUT:-$root/demo-output}"
demo_pid=""
upstream_pid=""
verbose=false
capability_proof_ran=false
benchmark_requests="${HYPERLIGHT_BENCHMARK_REQUESTS:-$((logical_cpus * 100))}"
benchmark_concurrency="${HYPERLIGHT_BENCHMARK_CONCURRENCY:-$logical_cpus}"
benchmark_vms="${HYPERLIGHT_BENCHMARK_VMS:-$logical_cpus}"
benchmark_pool_vms="${HYPERLIGHT_BENCHMARK_POOL_VMS:-$((logical_cpus + physical_cores))}"
go_bin="${GOBIN:-}"
if [[ -z "$go_bin" ]] && command -v go >/dev/null; then
    go_bin="$(go env GOBIN 2>/dev/null || true)"
    if [[ -z "$go_bin" ]]; then
        go_path="$(go env GOPATH 2>/dev/null || true)"
        [[ -n "$go_path" ]] && go_bin="$go_path/bin"
    fi
fi
go_bin="${go_bin:-${GOPATH:-$HOME/go}/bin}"
export PATH="$go_bin:$CARGO_HOME/bin:$PATH"

demos=(
    isolation
    policy
    ingress
    kv
    cache
    sql
    durable-objects
    storage
    node
    core-wasm
    component
    wasi-p2
    wasi-p3
    tcp-tls
    udp
    websocket
    web-apis
    fetch
    benchmark-on-demand
    benchmark-prewarmed
)

usage() {
    cat <<'EOF'
Run the guided Workerd-on-Hyperlight feature demos.

Usage:
  tools/hyperlight-demo [--output-dir DIR] [--verbose] [--all]
  tools/hyperlight-demo [--output-dir DIR] [--verbose] --demo NAME
  tools/hyperlight-demo --list
  tools/hyperlight-demo --preview
  tools/hyperlight-demo --describe NAME
  tools/hyperlight-demo --clear
  tools/hyperlight-demo --help

With no selection, the runner presents each demo interactively. Logs and
ordinary demo output are written below demo-output/ by default.

Options:
  --all             Run every demo without presenter pauses
  --demo NAME       Run one named demo
  --list            Show the formatted feature menu
  --preview         Render the complete presenter narration without running
  --describe NAME   Render one demo's narration without running
  --clear           Remove this checkout's generated demo output and exit
  --output-dir DIR  Override the output directory
  --benchmark-requests N
                    Total requests (default: 100 x detected CPU(s))
  --benchmark-concurrency N
                    Concurrent hey requests (default: detected CPU(s))
  --benchmark-vms N Concurrent request VMs (default: detected CPU(s))
  --benchmark-pool-vms N
                    Prewarmed inventory (default: CPU(s) + physical cores)
  --verbose         Stream raw command output as well as saving it
  -h, --help        Show this help
EOF
}

title() {
    case "$1" in
        isolation) echo "Disposable isolation and timeout recovery" ;;
        policy) echo "Who is running, permissions, and usage limits" ;;
        ingress) echo "Scheduled events and message batches" ;;
        kv) echo "KV persistence" ;;
        cache) echo "Cache persistence" ;;
        sql) echo "SQL transactions" ;;
        durable-objects) echo "Durable Objects keep separate state" ;;
        storage) echo "Virtual filesystems and named storage" ;;
        node) echo "Node-style modules and file access" ;;
        core-wasm) echo "Core WebAssembly" ;;
        component) echo "Component Model fixture" ;;
        wasi-p2) echo "WASI Preview 2 portability" ;;
        wasi-p3) echo "WASI Preview 3 async streaming" ;;
        tcp-tls) echo "Controlled TCP and TLS connections" ;;
        udp) echo "Controlled UDP messages" ;;
        websocket) echo "Controlled WebSocket connections" ;;
        web-apis) echo "WinterTC and common Web APIs" ;;
        fetch) echo "Constrained outbound fetch" ;;
        benchmark-on-demand) echo "On-demand latency and throughput" ;;
        benchmark-prewarmed) echo "Prewarmed latency and throughput" ;;
        *) return 1 ;;
    esac
}

description() {
    case "$1" in
        isolation) echo "Force a timeout, then prove the next request succeeds in a fresh VM." ;;
        policy) echo "The host knows which Worker is running and applies that Worker's permissions and usage limits. The Worker cannot change those rules itself." ;;
        ingress) echo "A host can pass a scheduled event or message batch into a temporary VM and receive completion, acknowledge, or retry decisions. No scheduler or external queue service is connected." ;;
        kv) echo "Store a key and value outside the temporary VM, then read it after the VM is replaced." ;;
        cache) echo "Cache a response outside the temporary VM, then read it after the VM is replaced." ;;
        sql) echo "Commit a group of SQL changes together and keep them after the VM is replaced." ;;
        durable-objects) echo "Keep each Durable Object's data separate and available after VM replacement." ;;
        storage) echo "Use packaged files and named mounts while denied paths stay denied." ;;
        node) echo "Load included Node-style modules and allowed files; attempts to start processes, threads, or native add-ons remain unavailable." ;;
        core-wasm) echo "Compile and invoke packaged core Wasm inside disposable Workers." ;;
        component) echo "Build and run the WebAssembly Component example in Workerd on Hyperlight." ;;
        wasi-p2) echo "Exercise portable HTTP, streams, clock, and random-number support." ;;
        wasi-p3) echo "Exercise ordering, backpressure, deadlines, cancellation, and cleanup." ;;
        tcp-tls) echo "Exercise the host broker that will carry Workerd TCP and TLS traffic. It permits only configured destinations and encryption settings; Workerd socket-channel wiring remains separate." ;;
        udp) echo "Exercise the host broker that will carry bounded UDP messages for configured addresses and ports; Workerd UDP-channel wiring remains separate." ;;
        websocket) echo "Exercise the host broker that will carry WebSocket traffic and enforce endpoint, message-size, and lifetime limits; Workerd WebSocket-channel wiring remains separate." ;;
        web-apis) echo "Exercise timers, streams, handlers, MessagePort, and fresh state." ;;
        fetch) echo "Reach one declared loopback service while other destinations stay denied." ;;
        benchmark-on-demand) echo "Measure requests when VMs are created or restored as they are needed." ;;
        benchmark-prewarmed) echo "Measure the same requests when ready VMs are available and replacements are prepared." ;;
        *) return 1 ;;
    esac
}

action() {
    case "$1" in
        isolation) echo "Send a normal request, force a timeout, then send a recovery request." ;;
        policy) echo "Run permission, usage-limit, denial, activity-log, and reset checks." ;;
        ingress) echo "Pass a scheduled event and a named message batch into a temporary VM." ;;
        kv) echo "Write and read a deterministic KV entry before and after VM reset." ;;
        cache) echo "Populate a deterministic cache entry, replace the VM, and read it again." ;;
        sql) echo "Execute a transactional SQL batch, replace the VM, and verify committed rows." ;;
        durable-objects) echo "Write two objects' data, replace the VM, and verify the data stays separate." ;;
        storage) echo "Read and write declared paths, then probe traversal and quota boundaries." ;;
        node) echo "Load both common JavaScript module formats and use the supported file API." ;;
        core-wasm) echo "Invoke the packaged Wasm export across disposable request VMs." ;;
        component) echo "Run the included WebAssembly Component example." ;;
        wasi-p2) echo "Run portable HTTP, stream, clock, random, cleanup, and denial checks." ;;
        wasi-p3) echo "Run async ordering, backpressure, deadline, cancellation, and cleanup checks." ;;
        tcp-tls) echo "Connect to a host-listed TCP and TLS destination, then try one that is not listed." ;;
        udp) echo "Exchange UDP messages with an allowed address and port, then exceed the size limit." ;;
        websocket) echo "Open an allowed WebSocket, exchange messages, then exceed the message limit." ;;
        web-apis) echo "Call the timer, stream, handler, MessagePort, and fresh-state routes." ;;
        fetch) echo "Fetch one declared loopback endpoint and probe blocked network targets." ;;
        benchmark-on-demand) echo "Send $benchmark_requests requests, with up to $benchmark_concurrency requests and $benchmark_vms VMs running at once, while VMs are created as needed." ;;
        benchmark-prewarmed) echo "Send $benchmark_requests requests, with up to $benchmark_concurrency requests and $benchmark_vms VMs running at once, using a ready inventory of $benchmark_pool_vms VMs." ;;
        *) return 1 ;;
    esac
}

takeaway() {
    case "$1" in
        isolation) echo "A failed request VM is disposable and does not poison recovery." ;;
        policy) echo "The Worker cannot change its own permissions or usage limits." ;;
        ingress) echo "The result comes back out of the VM; another program must connect a real service." ;;
        kv) echo "Configuration and application state can outlive disposable request VMs." ;;
        cache) echo "Cached responses can be reused without coupling them to one request VM." ;;
        sql) echo "Relational updates remain atomic even though request VMs are disposable." ;;
        durable-objects) echo "Each Durable Object keeps its own data across temporary VMs." ;;
        storage) echo "Filesystem access remains named, bounded, and least-privileged." ;;
        node) echo "Node-style code can use included APIs and files but cannot control the host operating system." ;;
        core-wasm) echo "Core Wasm composes with the same disposable VM lifecycle." ;;
        component) echo "The WebAssembly Component example builds and runs in Workerd on Hyperlight." ;;
        wasi-p2|wasi-p3) echo "Portable interfaces remain narrow, bounded, and recoverable." ;;
        tcp-tls|udp|websocket|fetch) echo "Network access is denied by default; the host opens only listed destinations." ;;
        web-apis) echo "Common Web APIs remain useful across strict isolation boundaries." ;;
        benchmark-on-demand|benchmark-prewarmed) echo "The same local request run shows the difference between creating VMs when needed and keeping VMs ready." ;;
        *) return 1 ;;
    esac
}

result_lines() {
    case "$1" in
        isolation)
            echo "RESULT: The forced timeout returned HTTP 504."
            echo "RESULT: The following request succeeded with clean VM state."
            ;;
        policy)
            echo "RESULT: The host applied the correct Worker's permissions and reset its usage counters."
            echo "EXPECTED DENIAL: Changed Worker details, unknown actions, and excess use were rejected."
            ;;
        ingress)
            echo "RESULT: Scheduled-event completion and message acknowledge/retry decisions returned clearly."
            echo "LIMIT: No scheduler or external queue service is connected by this demo."
            ;;
        kv)
            echo "RESULT: The KV value round-tripped and remained available after VM replacement."
            ;;
        cache)
            echo "RESULT: The cached response survived a fresh VM reset."
            ;;
        sql)
            echo "RESULT: The SQL batch committed transactionally and rows persisted after reset."
            ;;
        durable-objects)
            echo "RESULT: Durable Object data survived VM replacement and stayed separate."
            ;;
        storage)
            echo "RESULT: Packaged files, temporary files, devices, and named mounts behaved as declared."
            echo "EXPECTED DENIAL: Other paths, folder escapes, read-only writes, and excess use were rejected."
            ;;
        node)
            echo "RESULT: Both common JavaScript module formats and the supported file API worked."
            echo "EXPECTED DENIAL: Unlisted packages, new processes, threads, and native add-ons stayed unavailable."
            ;;
        core-wasm)
            echo "RESULT: The packaged Wasm export returned the expected value in disposable VMs."
            ;;
        component)
            echo "RESULT: The WebAssembly Component example built and ran in Workerd on Hyperlight."
            ;;
        wasi-p2)
            echo "RESULT: Typed HTTP, streams, clock, random, and resource release behaved correctly."
            echo "EXPECTED DENIAL: Extra command-line, file, listener, and raw-socket access stayed unavailable."
            ;;
        wasi-p3)
            echo "RESULT: Ordering, backpressure, deadlines, cancellation, and cleanup all completed."
            ;;
        tcp-tls)
            echo "RESULT: The host broker completed real TCP and encrypted TLS exchanges."
            echo "EXPECTED DENIAL: An unlisted address or port failed before a connection was opened."
            echo "LIMIT: The current sandbox executor does not yet connect Workerd's standard socket API to this broker."
            ;;
        udp)
            echo "RESULT: The host broker exchanged real UDP messages with the configured address and port."
            echo "EXPECTED DENIAL: Unlisted destinations and oversized messages were rejected."
            echo "LIMIT: The current sandbox executor does not yet connect a Workerd UDP API to this broker."
            ;;
        websocket)
            echo "RESULT: The host broker completed real WebSocket exchanges and reset cleanly."
            echo "EXPECTED DENIAL: Oversized messages and unlisted endpoints were rejected."
            echo "LIMIT: The current sandbox executor does not yet connect Workerd's WebSocket channel to this broker."
            ;;
        web-apis)
            echo "RESULT: Timers, streams, handlers, MessagePort, and fresh-state routes completed."
            ;;
        fetch)
            echo "RESULT: The declared loopback endpoint returned the expected response."
            echo "EXPECTED DENIAL: Other hosts, ports, schemes, private ranges, and redirect following were blocked."
            ;;
        benchmark-on-demand)
            echo "RESULT: All $benchmark_requests requests succeeded."
            echo "RESULT: After the final response, no requests were running or waiting and cleanup was complete."
            ;;
        benchmark-prewarmed)
            echo "RESULT: All $benchmark_requests requests succeeded."
            echo "RESULT: The demo showed how many ready VMs remained and whether replacements were being prepared."
            ;;
        *) return 1 ;;
    esac
}

render_demo() {
    local demo="$1"
    printf '\n%b+--------------------------------------------------------------------+%b\n' \
        "$c_cyan" "$c_reset"
    printf '%b  %s%b\n' "$c_bold" "$(title "$demo")" "$c_reset"
    printf '%b+--------------------------------------------------------------------+%b\n\n' \
        "$c_cyan" "$c_reset"
    printf '%bDEMONSTRATES%b\n' "$c_cyan" "$c_reset"
    print_wrapped "  " "$(description "$demo")"
    printf '\n%bWHY IT MATTERS%b\n' "$c_cyan" "$c_reset"
    print_wrapped "  " "$(takeaway "$demo")"
    printf '\n%bACTION%b\n' "$c_cyan" "$c_reset"
    print_wrapped "  " "$(action "$demo")"
}

print_wrapped() {
    local prefix="$1"
    local text="$2"
    local first=true
    while IFS= read -r line; do
        if "$first"; then
            printf '%s%s\n' "$prefix" "$line"
            first=false
        else
            printf '%*s%s\n' "${#prefix}" "" "$line"
        fi
    done < <(printf '%s\n' "$text" | fold -s -w "$((96 - ${#prefix}))")
}

if [[ "${NO_COLOR:-}" == "" ]]; then
    c_bold=$'\033[1m'
    c_green=$'\033[32m'
    c_cyan=$'\033[36m'
    c_yellow=$'\033[33m'
    c_reset=$'\033[0m'
else
    c_bold=""
    c_green=""
    c_cyan=""
    c_yellow=""
    c_reset=""
fi

evidence_row() {
    local label="$1"
    local value="$2"
    printf '  %b%-18s%b %s\n' "$c_cyan" "$label" "$c_reset" "$value"
}

evidence_heading() {
    printf '\n%bEVIDENCE%b\n\n' "$c_bold$c_green" "$c_reset"
}

worker_code_heading() {
    printf '\n%bWORKER CODE%b\n\n' "$c_bold$c_green" "$c_reset"
}

write_bundle_worker_code() {
    local bundle="$1"
    local output="$2"
    jq '{
        modules: [
            .modules[] |
            select(.type == "esModule" or .type == "commonJsModule") |
            {name, type, source}
        ]
    }' "$bundle" >"$output"
}

write_source_worker_code() {
    local output="$1"
    shift
    local temporary="$output.modules.tmp"
    : >"$temporary"
    while (($#)); do
        local name="$1"
        local module_type="$2"
        local source="$3"
        shift 3
        jq -n \
            --arg name "$name" \
            --arg type "$module_type" \
            --rawfile source "$source" \
            '{name: $name, type: $type, source: $source}' >>"$temporary"
    done
    jq -s '{modules: .}' "$temporary" >"$output"
    rm -f -- "$temporary"
}

write_node_worker_code() {
    local output="$1"
    jq -n \
        --rawfile worker \
        "$root/examples/workerd-capability-workers/node-worker.js" \
        --rawfile legacy \
        "$root/examples/workerd-capability-workers/legacy.cjs" \
        --slurpfile vfs \
        "$root/examples/workerd-bundles/workerd-vfs-evidence.json" \
        '{
            modules: [
                {name: "worker.js", type: "esModule", source: $worker},
                {name: "legacy.cjs", type: "commonJsModule", source: $legacy},
                {
                    name: "vfs-worker.js",
                    type: "esModule",
                    source: (
                        $vfs[0].modules[] |
                        select(.name == "worker.js") |
                        .source
                    )
                }
            ]
        }' >"$output"
}

print_worker_code() {
    local demo="$1"
    local code_dir="$output_dir/worker-code"
    local artifact="$code_dir/$demo.json"
    local rendered="$artifact.rendered.tmp"
    mkdir -p "$code_dir"
    rm -f -- "$artifact" "$rendered"
    worker_code_heading
    case "$demo" in
        isolation)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/acceptance.json" "$artifact"
            ;;
        policy|kv|cache|sql|durable-objects)
            write_source_worker_code "$artifact" \
                "worker.js" "esModule" \
                "$root/examples/workerd-capability-workers/data-worker.js"
            ;;
        ingress)
            write_source_worker_code "$artifact" \
                "worker.js" "esModule" \
                "$root/examples/workerd-capability-workers/ingress-worker.js"
            ;;
        node)
            write_node_worker_code "$artifact"
            ;;
        storage)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/workerd-vfs-evidence.json" "$artifact"
            ;;
        core-wasm|web-apis)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/workerd-wintertc-demo.json" "$artifact"
            ;;
        component)
            write_source_worker_code "$artifact" \
                "worker.mjs" "esModule" \
                "$root/experiments/workerd-component-model/worker.mjs" \
                "generated/component.js" "esModule" \
                "$root/experiments/workerd-component-model/generated/component.js"
            ;;
        fetch)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/fetch-policy-demo.json" "$artifact"
            ;;
        benchmark-on-demand|benchmark-prewarmed)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/workerd-pool-benchmark.json" "$artifact"
            ;;
        wasi-p2|wasi-p3)
            printf '  No JavaScript runs in Workerd for this WASI host-contract demo.\n\n'
            return
            ;;
        tcp-tls|udp|websocket)
            printf '  No JavaScript runs in Workerd for this host-broker contract demo.\n\n'
            return
            ;;
        *)
            printf '  No Worker JavaScript source is associated with this demo.\n\n'
            return
            ;;
    esac
    jq -r '.modules[] | "// \(.name) (\(.type))\n\(.source)"' \
        "$artifact" >"$rendered"
    sed -n '1,20p' "$rendered" | sed 's/^/  /'
    local rendered_lines
    rendered_lines="$(wc -l <"$rendered")"
    if ((rendered_lines > 20)); then
        printf '  ... %d additional lines omitted ...\n' "$((rendered_lines - 20))"
    fi
    rm -f -- "$rendered"
    printf '\n  Full code: %s\n' "$artifact"
    printf "  Command: cat %q | jq -r '%s'\n\n" \
        "$artifact" '.modules[] | "// \(.name) (\(.type))\n\(.source)"'
}

print_result_lines() {
    local line
    while IFS= read -r line; do
        case "$line" in
            RESULT:*)
                printf '  %bRESULT%b %s\n' "$c_green" "$c_reset" "${line#RESULT: }"
                ;;
            "EXPECTED DENIAL:"*)
                printf '  %bDENIED%b %s\n' "$c_yellow" "$c_reset" \
                    "${line#EXPECTED DENIAL: }"
                ;;
            LIMIT:*)
                printf '  %bLIMIT%b %s\n' "$c_yellow" "$c_reset" "${line#LIMIT: }"
                ;;
            *) print_wrapped "  " "$line" ;;
        esac
    done < <(result_lines "$1")
}

print_demo_evidence() {
    local demo="$1"
    local proof="$output_dir/capability-proof.json"
    evidence_heading
    case "$demo" in
        policy)
            evidence_row "Trusted identity" "$(jq -r '.policy.trusted_identity' "$proof")"
            evidence_row "Wrong identity" "$(jq -r '.policy.identity_denied.code' "$proof")"
            evidence_row "Unknown binding" "$(jq -r '.policy.binding_denied.code' "$proof")"
            evidence_row "Operation budget" "$(jq -r '"2 allowed, third=\(.policy.quota_denied.status)"' "$proof")"
            ;;
        isolation)
            evidence_row "Before timeout" "$(jq -r '"HTTP route \(.path), method \(.method)"' "$output_dir/isolation/before.json")"
            evidence_row "Forced timeout" "HTTP 504"
            evidence_row "Recovery VM" "$(jq -r '"HTTP route \(.path), method \(.method)"' "$output_dir/isolation/after.json")"
            ;;
        ingress)
            evidence_row "Runtime" "$(jq -r '.runtime' "$proof")"
            evidence_row "Scheduled input" "$(jq -r '"time=\(.scheduled_input.scheduled_time_unix_ms), cron=\(.scheduled_input.cron), id=\(.scheduled_input.request_id)"' "$proof")"
            evidence_row "Scheduled output" "$(jq -r '"outcome=\(.scheduled.outcome), retry=\(.scheduled.retry), id=\(.scheduled.request_id)"' "$proof")"
            while IFS=$'\t' read -r id attempts body_base64; do
                evidence_row "Queue input" "$id: body=$(printf '%s' "$body_base64" | base64 -d), attempts=$attempts"
            done < <(jq -r '.queue_input.messages[] | [.id, (.attempts|tostring), .body_base64] | @tsv' "$proof")
            evidence_row "Queue metadata" "$(jq -r '"name=\(.queue_input.queue), backlog=\(.queue_input.metadata.backlog_count) messages / \(.queue_input.metadata.backlog_bytes) bytes"' "$proof")"
            evidence_row "Queue output" "$(jq -r '"ack=\(.queue.explicit_acks | join(",")); retry=\(.queue.retry_messages | map(.id + " after " + (.delay_seconds|tostring) + "s") | join(","))"' "$proof")"
            ;;
        kv)
            evidence_row "Runtime" "$(jq -r '.runtime' "$proof")"
            evidence_row "Write" "$(jq -r '"status=\(.kv.put.status), code=\(.kv.put.code)"' "$proof")"
            evidence_row "VM 1 teardown" "$(jq -r '"\(.kv.put_vm_profile.vm_teardown_ms) ms"' "$proof")"
            evidence_row "Fresh VM read" "$(jq -r '.kv.get_after_fresh_vm.value_base64' "$proof" | base64 -d)"
            evidence_row "VM 2 teardown" "$(jq -r '"\(.kv.get_vm_profile.vm_teardown_ms) ms"' "$proof")"
            evidence_row "Backing file" "$(jq -r '.kv.backing_file' "$proof")"
            evidence_row "Clear down" "tools/hyperlight-demo --clear"
            evidence_row "Before command" "$(cat "$output_dir/kv-before-command.txt")"
            evidence_row "Before result" "0 application tables"
            evidence_row "Database SHA-256" "$(cut -d' ' -f1 "$output_dir/kv-cli.sha256")"
            evidence_row "External CLI" "$(sqlite3 --version | awk '{print "sqlite3 " $1}')"
            evidence_row "Rerun command" "$(cat "$output_dir/kv-cli-command.txt")"
            evidence_row "CLI SQL" "SELECT key, value FROM _hluk_kv"
            while IFS=$'\t' read -r key value; do
                evidence_row "CLI row" "$key=$value"
            done <"$output_dir/kv-cli.tsv"
            ;;
        cache)
            evidence_row "Runtime" "$(jq -r '.runtime' "$proof")"
            evidence_row "Populate" "$(jq -r '"status=\(.cache.put.status), code=\(.cache.put.code)"' "$proof")"
            evidence_row "VM 1 teardown" "$(jq -r '"\(.cache.put_vm_profile.vm_teardown_ms) ms"' "$proof")"
