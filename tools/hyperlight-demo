# start_workerd_host_extra SERVER_LOG CONFIG_PATH BIND [EXTRA_ARGS...]
#
# Like start_workerd_host, but for an ADDITIONAL concurrently-running
# `hluk workerd-host` process (used by benchmark-resident's M independent,
# simultaneously-up apps): does not call stop_demo or touch $demo_pid, and
# tracks its PID in extra_pids so stop_processes cleans it up alongside the
# primary process.
start_workerd_host_extra() {
    local server_log="$1" config="$2" bind="$3"
    local shift_count=$#
