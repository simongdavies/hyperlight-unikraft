run_one() {
    local demo="$1"
    local log="$output_dir/$demo.log"
    mkdir -p "$output_dir"
    render_demo "$demo"
    print_worker_code "$demo"
    printf '\n%bRUNNING%b\n' "$c_yellow" "$c_reset"
    printf '  Raw log: %s\n\n' "$log"
    local status=0
    # NOTE: deliberately not `(...) || status=$?`. Bash disables `errexit`
    # for everything executed inside a compound command (and every nested
    # function call within it, transitively) whenever that compound
    # command is the left-hand side of `||`/`&&`/an `if` condition — even
    # though the subshell re-enables `set -e` internally. That silently
    # turned every demo's internal `[[ ]]`/`jq -e`/`grep -Eq` assertion
    # into a no-op: a failing assertion would not abort the subshell, so
    # the demo would still reach its last command and report PASS. Toggling
    # `errexit` off/on around a *plain* (non-conditional) invocation avoids
    # that exemption, so `$?` below reflects the first real failure.
    set +e
    if "$verbose"; then
        (
            trap stop_processes EXIT INT TERM
            set -e
            run_demo_command "$demo"
        ) > >(tee "$log") 2>&1
    else
        (
            trap stop_processes EXIT INT TERM
            set -e
            run_demo_command "$demo"
        ) >"$log" 2>&1
    fi
    status=$?
    set -e
    if ((status == 0)); then
        printf '\n%bPASS%b  %s\n' "$c_green$c_bold" "$c_reset" "$(title "$demo")"
        print_demo_evidence "$demo"
        print_wrapped "TAKEAWAY: " "$(takeaway "$demo")"
        printf 'LOG: %s\n' "$log"
        return 0
    fi
    stop_processes
    printf '\n%bFAIL%b  %s\n\n' "$c_yellow$c_bold" "$c_reset" "$(title "$demo")" >&2
    printf 'LOG\n  %s\n\n' "$log" >&2
    printf '%bLAST 30 LOG LINES%b\n' "$c_yellow" "$c_reset" >&2
    tail -n 30 "$log" | sed 's/^/  /' >&2
    return 1
}

mode=interactive
selected=""
while (($#)); do
    case "$1" in
        --all)
            mode=all
            shift
            ;;
        --demo)
            (($# >= 2)) || {
                echo "--demo requires a name" >&2
                usage >&2
                exit 2
            }
            mode=one
            selected="$2"
            shift 2
            ;;
        --list)
            list_demos
            exit 0
            ;;
        --preview)
            mode=preview
            shift
            ;;
        --describe)
            (($# >= 2)) || {
                echo "--describe requires a name" >&2
                usage >&2
                exit 2
            }
            mode=describe
            selected="$2"
            shift 2
            ;;
        --clear)
            mode=clear
            shift
            ;;
        --self-test)
            mode=self-test
            shift
            ;;
        --output-dir)
            (($# >= 2)) || {
                echo "--output-dir requires a value" >&2
                usage >&2
                exit 2
            }
            output_dir="$2"
            shift 2
            ;;
        --benchmark-requests)
            (($# >= 2)) || {
                echo "--benchmark-requests requires a value" >&2
                exit 2
            }
            benchmark_requests="$2"
            shift 2
            ;;
        --benchmark-concurrency)
            (($# >= 2)) || {
                echo "--benchmark-concurrency requires a value" >&2
                exit 2
            }
            benchmark_concurrency="$2"
            shift 2
            ;;
        --benchmark-vms)
            (($# >= 2)) || {
                echo "--benchmark-vms requires a value" >&2
                exit 2
            }
            benchmark_vms="$2"
            shift 2
            ;;
        --benchmark-pool-vms)
            (($# >= 2)) || {
                echo "--benchmark-pool-vms requires a value" >&2
                exit 2
            }
            benchmark_pool_vms="$2"
            shift 2
            ;;
        --benchmark-apps)
            (($# >= 2)) || {
                echo "--benchmark-apps requires a value" >&2
                exit 2
            }
            benchmark_apps="$2"
            shift 2
            ;;
        --benchmark-load-requests)
            (($# >= 2)) || {
                echo "--benchmark-load-requests requires a value" >&2
                exit 2
            }
            benchmark_load_requests="$2"
            benchmark_load_requests_explicit=true
            shift 2
            ;;
        --benchmark-hey-parallel)
            (($# >= 2)) || {
                echo "--benchmark-hey-parallel requires a value" >&2
                exit 2
            }
            hey_max_parallel_jobs="$2"
            hey_max_parallel_jobs_explicit=true
            shift 2
            ;;
        --benchmark-hey-ramp-ms)
            (($# >= 2)) || {
                echo "--benchmark-hey-ramp-ms requires a value" >&2
                exit 2
            }
            hey_ramp_ms="$2"
            hey_ramp_ms_explicit=true
            shift 2
            ;;
        --verbose)
            verbose=true
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ "$benchmark_load_requests_explicit" != true ]]; then
    benchmark_load_requests=$((benchmark_apps * 1000))
fi
# Deferred defaults, same reasoning as benchmark_load_requests above:
# --benchmark-apps may change after these variables' initial (unset)
# values were set, so the real defaults are resolved here, once parsing
# is done. Synchronized-single-wave-with-ramp is the default for every
# benchmark demo (legacy benchmark-on-demand/benchmark-prewarmed only
# ever launch one hey job each, so this has no effect there).
if [[ "$hey_max_parallel_jobs_explicit" != true ]]; then
    hey_max_parallel_jobs="$benchmark_apps"
fi
if [[ "$hey_ramp_ms_explicit" != true ]]; then
    hey_ramp_ms=10
fi

for benchmark_value in \
    benchmark_requests \
    benchmark_concurrency \
    benchmark_vms \
    benchmark_pool_vms \
    benchmark_apps \
    benchmark_load_requests \
    hey_max_parallel_jobs; do
    if [[ ! "${!benchmark_value}" =~ ^[1-9][0-9]*$ ]]; then
        printf '%s must be a positive integer, got %q\n' \
            "$benchmark_value" "${!benchmark_value}" >&2
        exit 2
    fi
done
# hey_ramp_ms's valid default is 0 (no ramp), so it is checked separately
# as a non-negative integer rather than joining the positive-integer loop
# above.
if [[ ! "$hey_ramp_ms" =~ ^[0-9]+$ ]]; then
    printf 'hey_ramp_ms must be a non-negative integer, got %q\n' \
        "$hey_ramp_ms" >&2
    exit 2
fi
# --benchmark-requests/--benchmark-vms/--benchmark-pool-vms only apply to
# the legacy benchmark-on-demand/benchmark-prewarmed demos; --benchmark-
# apps/--benchmark-load-requests only apply to the three M-based load
# benchmarks (benchmark-resident/benchmark-multi-app/benchmark-
# orchestrator-contract). Gating the matching cross-checks on the
# actually-selected demo(s) keeps each pair's defaults and flag
# combinations independent of the other.
compute_benchmark_classes "$mode" "$selected"
validate_benchmark_flags "$benchmark_requests" "$benchmark_concurrency" \
    "$benchmark_pool_vms" "$benchmark_apps" "$benchmark_load_requests" \
    "$uses_benchmark_apps" "$uses_legacy_benchmark" || exit 2

if [[ "$mode" == one || "$mode" == describe ]] &&
    [[ ! " ${demos[*]} " =~ " $selected " ]]; then
    echo "unknown demo: $selected" >&2
    echo "run tools/hyperlight-demo --list to see valid names" >&2
    exit 2
fi
if [[ "$mode" == preview ]]; then
    print_scope_context
    for demo in "${demos[@]}"; do
        render_preview "$demo"
    done
    printf '\nPreview complete. The runbook contains the detailed compatibility boundaries.\n'
    exit 0
fi
if [[ "$mode" == clear ]]; then
    clear_output
    exit 0
fi
if [[ "$mode" == self-test ]]; then
    self_test
    exit $?
fi
if [[ "$mode" == describe ]]; then
    render_preview "$selected"
    print_worker_code "$selected"
    exit 0
fi
if [[ "$mode" == interactive ]] && [[ ! -t 0 ]]; then
    echo "interactive mode requires a terminal; use --all or --demo NAME" >&2
    exit 2
fi

require_runtime
cd "$root"

if [[ "$mode" == one ]]; then
    run_one "$selected"
    exit
fi

for demo in "${demos[@]}"; do
    if [[ "$mode" == interactive ]]; then
        printf '\nNext: %s\n%s\n' "$(title "$demo")" "$(description "$demo")"
        read -r -p "Enter=run, s=skip, q=quit: " choice
        case "$choice" in
            q) exit 0 ;;
            s) continue ;;
        esac
    fi
    run_one "$demo"
    if [[ "$mode" == interactive ]]; then
        read -r -p "Enter=continue, r=repeat, q=quit: " choice
        case "$choice" in
            q) exit 0 ;;
            r) run_one "$demo" ;;
        esac
    fi
done

printf '\nAll selected demos passed. Output: %s\n' "$output_dir"
