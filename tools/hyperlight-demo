description() {
    case "$1" in
        isolation) echo "Force a timeout, then prove the next request succeeds in a fresh VM." ;;
        policy) echo "The host knows which Worker is running and applies that Worker's permissions and usage limits. The Worker cannot change those rules itself." ;;
        ingress) echo "A host can pass a scheduled event or message batch into a temporary VM and receive completion, acknowledge, or retry decisions. No scheduler or external queue service is connected." ;;
        kv) echo "Store a key and value outside the temporary VM, then read it after the VM is replaced." ;;
        cache) echo "Cache a response outside the temporary VM, then read it after the VM is replaced." ;;
        sql) echo "Commit a group of SQL changes together and keep them after the VM is replaced." ;;
        durable-objects) echo "Keep each Durable Object's data separate and available after VM replacement." ;;
        storage) echo "Use packaged files and named mounts while denied paths stay denied." ;;
        node) echo "Load included Node-style modules and allowed files; attempts to start processes, threads, or native add-ons remain unavailable." ;;
        core-wasm) echo "Compile and invoke packaged core Wasm inside disposable Workers." ;;
        component) echo "Build and run the WebAssembly Component example in Workerd on Hyperlight." ;;
        wasi-p2) echo "Exercise portable HTTP, streams, clock, and random-number support." ;;
        wasi-p3) echo "Exercise ordering, backpressure, deadlines, cancellation, and cleanup." ;;
        tcp-tls) echo "Exercise the host broker that will carry Workerd TCP and TLS traffic. It permits only configured destinations and encryption settings; Workerd socket-channel wiring remains separate." ;;
        udp) echo "Exercise the host broker that will carry bounded UDP messages for configured addresses and ports; Workerd UDP-channel wiring remains separate." ;;
        websocket) echo "Exercise the host broker that will carry WebSocket traffic and enforce endpoint, message-size, and lifetime limits; Workerd WebSocket-channel wiring remains separate." ;;
        web-apis) echo "Exercise timers, streams, handlers, MessagePort, and fresh state." ;;
        fetch) echo "Reach one declared loopback service while other destinations stay denied." ;;
        resident) echo "A resident VM serves several requests without being torn down between them, then is explicitly retired once it crosses its configured request limit." ;;
        multi-app) echo "One workerd-host process serves two independently configured apps, routed by hostname, from a single listening port." ;;
        orchestrator-contract) echo "The workerd-host process exposes liveness, readiness, and status endpoints, and shuts down cleanly on SIGTERM." ;;
        benchmark-on-demand) echo "Measure requests when VMs are created or restored as they are needed." ;;
        benchmark-prewarmed) echo "Measure the same requests when ready VMs are available and replacements are prepared." ;;
        benchmark-resident) echo "Drive real $benchmark_load_driver load across $benchmark_apps independently running resident workerd-host processes, each on its own loopback port, and capture per-app and aggregate throughput." ;;
        benchmark-multi-app) echo "Drive real hey load across $benchmark_apps apps routed by hostname through one workerd-host process, and capture per-app fairness and routing/queue counters in demo output files." ;;
        benchmark-orchestrator-contract) echo "Drive real hey load across $benchmark_apps apps, then send SIGTERM mid-flight and prove admitted requests drain while new traffic is not admitted." ;;
        *) return 1 ;;
    esac
}

