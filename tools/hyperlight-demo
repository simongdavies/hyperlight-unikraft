    resolved="$(normalize_path "$output_dir")"
    case "$resolved" in
        "$root"/*) ;;
        *)
            printf 'refusing to clear output outside this checkout: output=%s root=%s\n' \
                "$resolved" "$root" >&2
            return 2
            ;;
    esac
    [[ "$resolved" != "$root" ]] || {
        echo "refusing to clear the repository root" >&2
        return 2
    }
    rm -rf -- "$resolved"
    mkdir -p "$resolved"
    printf 'Cleared generated demo output: %s\n' "$resolved"
}

