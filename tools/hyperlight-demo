        "$(seconds_between "$t_start" "$t_setup_done")" \
        "$(seconds_between "$t_setup_done" "$t_load_done")" \
        "$(seconds_between "$t_load_done" "$t_end")" \
        "$(seconds_between "$t_start" "$t_end")")"
    write_benchmark_summary "benchmark-multi-app" "$app_summaries" "$timing_json" \
        "$hey_max_parallel_jobs" "$dir/summary.json"
    log_line "$run_log" "benchmark-multi-app complete: total_elapsed=$(seconds_between "$t_start" "$t_end")s"
    echo "All $benchmark_load_requests requests across $benchmark_apps routed apps succeeded, one process and port; see $dir/summary.json, $dir/hey.txt, and $run_log"
}

run_benchmark_orchestrator_contract() {
    local dir="$output_dir/benchmark-orchestrator-contract"
    mkdir -p "$dir"
    local bind=127.0.0.1:8331

    local -a total_alloc
    allocate_evenly "$benchmark_load_requests" "$benchmark_apps" total_alloc

    local -a app_json_lines
    local i
    for ((i = 0; i < benchmark_apps; i++)); do
        local pool
        pool="$(jq -n '{kind:"disposable", max_concurrent_sandboxes:4, queue_capacity:64}')"
        app_json_lines+=("$(app_config "drain-$i" "drain-$i.bench" \
            "$root/examples/workerd-bundles/workerd-drain-benchmark.json" "$pool")")
    done
    local apps_json
    apps_json="$(printf '%s\n' "${app_json_lines[@]}" | jq -s '.')"
    write_host_config "$dir/config.json" "$apps_json"
    start_workerd_host "$dir/server.log" "$dir/config.json" "$bind" \
        --drain-timeout-ms 5000

    # Phase A/B split: ~75% of each app's allocation goes to the pre-drain
    # /sync reference load; the remaining ~25% (floor 1, borrowed from
    # Phase A when an app's total is very small) goes to /drain and is
    # launched right before SIGTERM, proving in-flight admitted work still
    # completes.
    local -a phase_a_alloc phase_b_alloc
    for ((i = 0; i < benchmark_apps; i++)); do
        local total="${total_alloc[i]}"
        local b=$((total / 4))
        ((b >= 1)) || b=1
        ((b <= total)) || b="$total"
        phase_a_alloc[i]=$((total - b))
        phase_b_alloc[i]="$b"
    done

    local -a conc_alloc
    allocate_evenly "$benchmark_concurrency" "$benchmark_apps" conc_alloc

    # Phase A: foreground, run to completion as the pre-drain reference.
    #
    # hey truncates its own request count to a multiple of -c when -n isn't
    # evenly divisible by -c (observed: `hey -n 75 -c 4` sends only 72, not
    # 75), so the allocated request count is snapped down to the nearest
    # multiple of its concurrency here, before launching hey or asserting on
    # its output, rather than asserting on the originally allocated count
    # and then failing against hey's own silent truncation.
    local -a a_reqs a_concs a_urls a_hosts a_timeouts a_outfiles a_statuses
    for ((i = 0; i < benchmark_apps; i++)); do
        local conc=$((conc_alloc[i] < phase_a_alloc[i] ? conc_alloc[i] : phase_a_alloc[i]))
        ((conc > 0)) || conc=1
        local reqs=$(((phase_a_alloc[i] / conc) * conc))
        ((reqs > 0)) || reqs="$conc"
        a_reqs[i]="$reqs"
        a_concs[i]="$conc"
        a_urls[i]="http://$bind/sync"
        a_hosts[i]="drain-$i.bench"
        a_timeouts[i]=30
        a_outfiles[i]="$dir/app-$i-phase-a.txt"
    done
    launch_hey_jobs a_reqs a_concs a_urls a_hosts a_timeouts a_outfiles a_statuses

    local pre_apps="[]"
    for ((i = 0; i < benchmark_apps; i++)); do
        [[ "${a_statuses[i]}" == 0 ]]
        if ((a_reqs[i] > 0)); then
            grep -Eq "\\[200\\][[:space:]]+${a_reqs[i]} responses" "${a_outfiles[i]}"
        fi
        local one
        one="$(build_app_summary "drain-$i" "${a_reqs[i]}" "${a_concs[i]}" "${a_outfiles[i]}")"
        pre_apps="$(jq -c --argjson one "$one" '. + [$one]' <<<"$pre_apps")"
    done
    write_benchmark_summary "pre-drain" "$pre_apps" null 0 "$dir/pre-drain-summary.json"

    curl --fail-with-body --silent --show-error \
        "http://$bind/__hyperlight/healthz" >"$dir/healthz.json"
    jq -e '.status == "ok"' "$dir/healthz.json" >/dev/null
    curl --fail-with-body --silent --show-error \
        "http://$bind/__hyperlight/readyz" >"$dir/readyz-before.json"
    jq -e '.status == "ready"' "$dir/readyz-before.json" >/dev/null
    curl --fail-with-body --silent --show-error \
        --header "Host: drain-0.bench" \
        "http://$bind/__hyperlight/status" >"$dir/status.json"
    jq -e --argjson expected "$benchmark_apps" 'length == $expected' "$dir/status.json" >/dev/null

    # Phase B: launch the in-flight /drain batch in the background, give it
    # a head start to actually connect and be accepted/dispatched before
    # signaling: workerd-host's accept loop checks its shutdown flag before
    # each `accept()`, so a connection that has not yet been accepted when
    # the flag flips is never admitted and fails with a connection error
    # instead of draining. `tests/workerd_host_contract.rs`'s equivalent
    # test gets away with a fixed 30ms sleep because it dispatches the
    # in-flight request from an in-process thread; here each app's head
    # start is an external `hey` process, whose fork/exec and Go-runtime
    # startup latency is not bounded by a fixed sleep (observed, under WSL2
    # load, to occasionally exceed 30ms for one app while a later-launched
    # app's process happens to start faster). So instead of sleeping a
    # fixed duration, poll each app's real `/status` admitted-work counters
    # (active+queued) and only signal once every app shows at least one
    # in-flight request, bounded by a generous timeout; a timeout here
    # means a real failure to admit, which the grep assertions below will
    # then correctly surface as a demo FAIL rather than mask. Every app's
    # hey is still spawned paused and released together via
    # spawn_hey_paused (plus the usual hey_ramp_ms stagger when set), but
    # M is bounded by --benchmark-apps and documented to stay small, and
    # this phase must return control immediately to poll admission state
    # rather than block until hey exits, so it intentionally does not
    # route through launch_hey_jobs itself (which always waits out a full
    # wave before returning, and would wave-split for M > hey_max_parallel_jobs).
    local -a b_pids b_reqs b_concs b_outfiles
    local b_gate
    b_gate="$(mktemp -u "${TMPDIR:-/tmp}/hyperlight-demo-hey-gate.XXXXXX")"
    rm -f "$b_gate" 2>/dev/null
    for ((i = 0; i < benchmark_apps; i++)); do
        local conc=$((conc_alloc[i] < phase_b_alloc[i] ? conc_alloc[i] : phase_b_alloc[i]))
        ((conc > 0)) || conc=1
        # Same floor(n/c)*c snapping as phase A above: keep the asserted
        # count honest with what hey will actually send.
        local reqs=$(((phase_b_alloc[i] / conc) * conc))
        ((reqs > 0)) || reqs="$conc"
        b_reqs[i]="$reqs"
        b_concs[i]="$conc"
        b_outfiles[i]="$dir/app-$i-phase-b.txt"
        local b_release_sleep="0"
        if ((hey_ramp_ms > 0)); then
            local b_offset_ms=$((i * hey_ramp_ms))
            b_release_sleep="$(printf '%d.%03d' \
                $((b_offset_ms / 1000)) $((b_offset_ms % 1000)))"
        fi
        spawn_hey_paused "${b_outfiles[i]}" "$b_gate" "$b_release_sleep" \
            -n "${b_reqs[i]}" -c "$conc" -t 30 \
            -host "drain-$i.bench" "http://$bind/drain"
        b_pids[i]=$!
    done
    : >"$b_gate"

    # workerd-host's accept loop admits at most one new TCP connection per
    # listener per polling tick (not a backlog-draining loop), so a burst of
    # b_concs[i] concurrent connections per app is admitted gradually, not
    # all at once. Waiting for just one admitted request per app (as before)
    # lets SIGTERM race the rest of that same burst while they are still
    # sitting unaccepted in the OS backlog: the accept loop exits on the
    # very next tick once shutting_down is observed and never accepts them,
    # so they get reset when the listener is dropped at process exit,
    # instead of draining as admitted in-flight work. Waiting for the full
    # per-app concurrency to be admitted (not merely >= 1) ensures the whole
    # intended "in flight at signal time" batch has actually been accepted
    # before SIGTERM fires, matching what this phase documents proving.
    local admit_deadline=$((SECONDS + 10))
    while true; do
        local admitted_status all_admitted=1
        admitted_status="$(curl --silent --show-error --max-time 1 \
            --header "Host: drain-0.bench" "http://$bind/__hyperlight/status" 2>/dev/null || echo '[]')"
        for ((i = 0; i < benchmark_apps; i++)); do
            local in_flight
            in_flight="$(jq -r --arg id "drain-$i" \
                '[.[] | select(.app_id == $id) | (.active + .queued)] | add // 0' \
                <<<"$admitted_status" 2>/dev/null || echo 0)"
            ((in_flight >= b_concs[i])) || all_admitted=0
        done
        ((all_admitted == 1)) && break
        ((SECONDS < admit_deadline)) || break
        sleep 0.01
    done

    local shutdown_start
    shutdown_start="$(date +%s%3N)"
    kill -TERM "$demo_pid"

    local post_signal_probe="no_response"
    local probe_body probe_exit=0
    probe_body="$(curl --silent --show-error --max-time 1 --output /dev/null \
        --write-out '%{http_code}' "http://$bind/__hyperlight/readyz")" || probe_exit=$?
    if ((probe_exit == 0)) && [[ "$probe_body" == 200 ]]; then
        post_signal_probe="unexpected_200"
    fi
    [[ "$post_signal_probe" == no_response ]]

    local -a b_statuses
    for ((i = 0; i < benchmark_apps; i++)); do
        local status=0
        wait "${b_pids[i]}" || status=$?
        b_statuses[i]="$status"
    done
    rm -f "$b_gate" 2>/dev/null

    local during_apps="[]"
    for ((i = 0; i < benchmark_apps; i++)); do
        [[ "${b_statuses[i]}" == 0 ]]
        if ((b_reqs[i] > 0)); then
            grep -Eq "\\[200\\][[:space:]]+${b_reqs[i]} responses" "${b_outfiles[i]}"
        fi
        local one
        one="$(build_app_summary "drain-$i" "${b_reqs[i]}" "${b_concs[i]}" "${b_outfiles[i]}")"
        during_apps="$(jq -c --argjson one "$one" '. + [$one]' <<<"$during_apps")"
    done
    write_benchmark_summary "during-drain" "$during_apps" null 0 "$dir/during-drain-summary.json"

    # Bounded poll for process exit (drain-timeout-ms 5000 + buffer), not a
    # blind wait: new connections after SIGTERM get no response until the
    # process actually exits, so this is the only reliable exit signal.
    local deadline=$((SECONDS + 15))
    while kill -0 "$demo_pid" 2>/dev/null; do
        if ((SECONDS >= deadline)); then
            echo "workerd-host did not exit within the drain timeout" >&2
            return 1
        fi
        sleep 0.05
    done
    local exit_code=0
    wait "$demo_pid" || exit_code=$?
    local shutdown_end
    shutdown_end="$(date +%s%3N)"
    demo_pid=""

    local shutdown_duration_ms=$((shutdown_end - shutdown_start))
    jq -n \
        --arg scenario "orchestrator-contract" \
        --slurpfile pre_drain "$dir/pre-drain-summary.json" \
        --slurpfile during_drain "$dir/during-drain-summary.json" \
        --arg post_signal_probe "$post_signal_probe" \
        --argjson shutdown_duration_ms "$shutdown_duration_ms" \
        --argjson exit_code "$exit_code" \
        '{
            scenario: $scenario,
            pre_drain: $pre_drain[0],
            during_drain: $during_drain[0],
            post_signal_probe: $post_signal_probe,
            shutdown_duration_ms: $shutdown_duration_ms,
            exit_code: $exit_code
        }' >"$dir/summary.json"

    [[ "$exit_code" == 0 ]]
    echo "$exit_code" >"$dir/exit-code.txt"
    echo "SIGTERM mid-flight drained admitted requests (post-signal probe: $post_signal_probe) and exited $exit_code within the drain timeout ($shutdown_duration_ms ms)."
}

run_demo_command() {
    case "$1" in
        isolation) run_isolation ;;
        policy) run_policy ;;
        ingress) run_ingress ;;
        kv) run_kv ;;
        cache) run_cache ;;
        sql) run_sql ;;
        durable-objects) run_durable_objects ;;
        storage) run_storage ;;
        node) run_node ;;
        core-wasm) run_core_wasm ;;
        component) run_component ;;
        wasi-p2) run_wasi_p2 ;;
        wasi-p3) run_wasi_p3 ;;
        tcp-tls) run_tcp_tls ;;
        udp) run_udp ;;
        websocket) run_websocket ;;
        web-apis) run_web_apis ;;
        fetch) run_fetch ;;
        resident) run_resident ;;
        multi-app) run_multi_app ;;
