# --- workerd-host (resident Workerd host) demo helpers -------------------
#
# These drive the `hluk workerd-host` binary (distinct from the single-app
# `workerd-demo` example `start_server` above), so they get their own
# config-writing, readiness-wait, and request helpers rather than reusing
# the `workerd-demo`-specific ones.

# write_host_config OUTPUT_PATH APPS_JSON
#
# Writes a `hyperlight_unikraft::workerd::HostConfig` JSON file at
# OUTPUT_PATH, filling in this checkout's shared rootfs/executor and
# wrapping the caller-provided apps array (already-built JSON, one element
# per `AppConfig`).
write_host_config() {
    local output="$1"
    local apps_json="$2"
    jq -n \
        --arg rootfs "$root/build-elfloader/workerd-executor/rootfs.img" \
        --arg executor "$root/build-elfloader/workerd-executor/executor" \
        --argjson apps "$apps_json" \
        '{rootfs_path: $rootfs, executor_path: $executor, apps: $apps}' \
        >"$output"
}

# app_config APP_ID HOSTNAME BUNDLE_PATH POOL_JSON [AFFINITY] [SNAPSHOT_DIR]
#
# Builds one `AppConfig` JSON object. POOL_JSON is an already-tagged
# `AppPoolConfig` object, e.g. `{"kind":"resident","capacity":1,...}`.
# SNAPSHOT_DIR, if non-empty, is written as the app's `snapshot_dir`
# (restore-from-prewarmed-snapshot instead of fresh boot+init); omitted
# entirely otherwise, which keeps today's fresh-boot behavior (the field
# defaults to `None` server-side).
app_config() {
    local app_id="$1" hostname="$2" bundle_path="$3" pool_json="$4"
    local affinity="${5:-none}"
    local snapshot_dir="${6:-}"
    jq -n \
        --arg app_id "$app_id" \
        --arg hostname "$hostname" \
        --arg bundle_path "$bundle_path" \
        --argjson pool "$pool_json" \
        --arg affinity "$affinity" \
        --arg snapshot_dir "$snapshot_dir" \
        '{
            route: {app_id: $app_id, hostnames: [$hostname], path_prefix: null},
            bundle_path: $bundle_path,
            scratch_memory_mb: 384,
            execute_timeout_secs: 30,
            capability_policy: {},
            pool: $pool,
            connection_affinity: $affinity
        } + (if $snapshot_dir == "" then {} else {snapshot_dir: $snapshot_dir} end)'
}

write_resident_benchmark_configs() {
    local dir="$1" bundle="$2" snapshot="$3"
    local -n capacities="$4"
    local template
    template="$(app_config bench-0 bench.resident.test "$bundle" \
        '{"kind":"resident","capacity":1,"queue_capacity":64,"max_requests_per_vm":null,"max_lifetime_secs":null}' \
        none "$snapshot")"
    write_host_config "$dir/config-template.json" "[$template]"
    python3 - "$dir" "${capacities[@]}" <<'PY'
import copy
import json
import pathlib
import sys

directory = pathlib.Path(sys.argv[1])
template = json.loads((directory / "config-template.json").read_text())
for index, value in enumerate(sys.argv[2:]):
    config = copy.deepcopy(template)
    app = config["apps"][0]
    app["route"]["app_id"] = f"bench-{index}"
    capacity = int(value)
    app["pool"]["capacity"] = capacity
    app["pool"]["queue_capacity"] = max(64, capacity * 4)
    app_dir = directory / f"app-{index}"
    app_dir.mkdir(parents=True, exist_ok=True)
    (app_dir / "config.json").write_text(json.dumps(config) + "\n")
PY
    rm -f "$dir/config-template.json"
}

# prewarm_shared_snapshot RUN_LOG BUNDLE_PATH SNAPSHOT_DIR
#
# Runs `hluk workerd-prewarm-snapshot` once to produce a verified,
# restorable snapshot at SNAPSHOT_DIR from BUNDLE_PATH (boot + guest
# `init` + save), so every app config.json generated afterwards can set
# `snapshot_dir` to it and restore instead of paying its own boot+init
# cost -- the load -> init -> snapshot -> restore x N pattern. One shared
# bundle/rootfs/executor/capability-policy means one prewarm covers every
# app in the run (the fail-closed check in
# `WorkerVersionSandbox::initialize_from_snapshot_dir` would reject a
# mismatched one anyway).
prewarm_shared_snapshot() {
    local run_log="$1" bundle_path="$2" snapshot_dir="$3"
    local t0 t1
    t0="$(now_seconds)"
    if ! "$root/target/release/hluk" workerd-prewarm-snapshot \
        --bundle "$bundle_path" \
        --rootfs "$root/build-elfloader/workerd-executor/rootfs.img" \
        --executor "$root/build-elfloader/workerd-executor/executor" \
        --scratch-mb 384 \
        --snapshot-dir "$snapshot_dir" \
        --log-level info >"$snapshot_dir.log" 2>&1; then
        log_line "$run_log" "FAILURE: prewarm snapshot failed; see $snapshot_dir.log"
        printf 'FAILURE: prewarm snapshot failed (see %s)\n' "$snapshot_dir.log" >&2
        return 1
    fi
    t1="$(now_seconds)"
    log_line "$run_log" "prewarm snapshot ready: elapsed=$(seconds_between "$t0" "$t1")s" \
        "snapshot_dir=$snapshot_dir"
}

wait_for_workerd_host_ready() {
    local server_log="$1"
    local bind="$2"
    local pid="${3:-$demo_pid}"
    local attempt
    for attempt in $(seq 1 600); do
        if curl --silent --fail "http://$bind/__hyperlight/readyz" >/dev/null; then
            return 0
        fi
        if ! kill -0 "$pid" 2>/dev/null; then
            tail -n 30 "$server_log" >&2
            return 1
        fi
        sleep 0.1
    done
    echo "workerd-host did not become ready; see $server_log" >&2
    return 1
}

# start_workerd_host SERVER_LOG CONFIG_PATH [BIND] [EXTRA_ARGS...]
start_workerd_host() {
    local server_log="$1"
    local bind="${3:-127.0.0.1:8080}"
    start_workerd_host_nowait "$@"
    wait_for_workerd_host_ready "$server_log" "$bind"
}

# start_workerd_host_nowait SERVER_LOG CONFIG_PATH [BIND] [EXTRA_ARGS...]
#
# Same fork as start_workerd_host, but returns immediately without
# polling for readiness (demo_pid is still set). Lets a caller fork
# several independent processes back-to-back (see benchmark-resident's
# setup loop) so their restores proceed concurrently across available
# cores instead of each one's full restore+ready-poll finishing before
# the next is even forked; the caller is responsible for calling
# wait_for_workerd_host_ready itself once it is ready to block.
start_workerd_host_nowait() {
    local server_log="$1"
    local config="$2"
    local bind="${3:-127.0.0.1:8080}"
    local shift_count=$#
    ((shift_count > 3)) && shift_count=3
    shift "$shift_count"
    stop_demo
    "$root/target/release/hluk" workerd-host \
        --config "$config" \
        --bind "$bind" \
        "$@" \
        >"$server_log" 2>&1 &
    demo_pid=$!
}

# start_workerd_host_extra SERVER_LOG CONFIG_PATH BIND [EXTRA_ARGS...]
#
# Like start_workerd_host, but for an ADDITIONAL concurrently-running
# `hluk workerd-host` process (used by benchmark-resident's M independent,
# simultaneously-up apps): does not call stop_demo or touch $demo_pid, and
# tracks its PID in extra_pids so stop_processes cleans it up alongside the
# primary process.
start_workerd_host_extra() {
    local server_log="$1" bind="$3"
    start_workerd_host_extra_nowait "$@"
    wait_for_workerd_host_ready "$server_log" "$bind" "${extra_pids[-1]}"
}

# start_workerd_host_extra_nowait SERVER_LOG CONFIG_PATH BIND [EXTRA_ARGS...]
#
# Same fork as start_workerd_host_extra (PID still tracked in extra_pids),
# but returns immediately without polling for readiness; see
# start_workerd_host_nowait's docstring for why.
start_workerd_host_extra_nowait() {
    local server_log="$1" config="$2" bind="$3"
    local shift_count=$#
    ((shift_count > 3)) && shift_count=3
    shift "$shift_count"
    "$root/target/release/hluk" workerd-host \
        --config "$config" \
        --bind "$bind" \
        "$@" \
        >"$server_log" 2>&1 &
    local pid=$!
    extra_pids+=("$pid")
}

# allocate_evenly TOTAL PARTS ARRNAME
#
# Deterministically splits TOTAL into PARTS non-negative integers summing
# to TOTAL: each part gets TOTAL/PARTS, and the remainder (TOTAL % PARTS)
# is assigned one-each to the first parts, so results are stable and
# reproducible regardless of divisibility. Writes the PARTS values into
# the caller's array ARRNAME.
allocate_evenly() {
    local total="$1" parts="$2"
    local -n out_arr="$3"
    local base=$((total / parts))
    local remainder=$((total % parts))
    out_arr=()
    local i share
    for ((i = 0; i < parts; i++)); do
        share="$base"
        ((i < remainder)) && share=$((share + 1))
        out_arr+=("$share")
    done
}

# snap_reqs_to_hey_achievable REQ_ALLOC_FOR_APP CONC
#
# hey (`rakyll/hey`) truncates its own request count to a multiple of its
# concurrency: it hands every one of its -c workers exactly n/c requests
# (integer division) with no remainder distribution, so `hey -n 31 -c 2`
# sends only 30 requests, not 31, whenever -n isn't an exact multiple of
# -c (confirmed directly: `hey -n 31 -c 2` against a plain HTTP server
# reports "[200] 30 responses"). Any demo that allocates per-app request
# counts via allocate_evenly and then asserts on hey's reported response
# count must snap the target down to what hey will actually send BEFORE
# launching hey or asserting on its output -- otherwise an allocation that
# happens to be a non-multiple of its app's concurrency share (e.g.
# apps=32, load-requests=1000, concurrency=64 gives some apps 31
# requests at concurrency 2) silently fails with "did not report N 200
# responses" even though hey exited 0 and the server served every request
# it received correctly. If the floor lands on 0 (alloc smaller than
# conc), round up to conc instead of asserting on zero requests.
snap_reqs_to_hey_achievable() {
    local req_alloc_for_app="$1" conc="$2"
    local reqs=$(((req_alloc_for_app / conc) * conc))
    ((reqs > 0)) || reqs="$conc"
    printf '%s\n' "$reqs"
}

# allocate_requests_hey_achievable TOTAL_REQUESTS PARTS CONC_ARRNAME
#                                  REQ_OUT_ARRNAME REMAINDER_VARNAME
#
# Like snap_reqs_to_hey_achievable, but jointly across every app instead
# of one app at a time: snapping each app's request count down to a
# multiple of its own concurrency independently (as the simpler
# per-app-only helper does) can under-deliver the caller's requested
# TOTAL_REQUESTS -- e.g. apps=32, load-requests=1000, concurrency=64
# gives 24 apps a (31 requests, concurrency 2) share, each of which snaps
# down to 30, so only 976 of the requested 1000 would ever be sent. This
# demo claims "All $benchmark_load_requests requests ... succeeded", so
# silently sending fewer is incorrect, not merely imprecise.
#
# Starts from allocate_evenly's proportional per-app target (which sums
# to TOTAL_REQUESTS exactly), floors each app down to the nearest
# multiple of CONC_ARRNAME[i] (the only direction a floor can go without
# exceeding what hey can actually deliver at that concurrency -- see
# snap_reqs_to_hey_achievable), then restores as much of the lost total
# as is mathematically expressible, distributing the restored chunks
# round-robin across apps sharing each concurrency denomination (rather
# than dumping it all on one app), which keeps the distribution close to
# even as the ACTION text promises.
#
# Restoring the lost total is a non-negative coin-change search: the
# distinct concurrency values actually present are the available "coin"
# denominations, each reusable any number of times across apps (bumping
# the same app more than once keeps its count a multiple of its own
# concurrency just as well as spreading across apps does). A GREEDY
# round-robin sweep (try each app in order, bump if it fits, repeat) was
# tried first and is wrong: it can burn a scarce denomination on an app
# visited early and leave a leftover that denomination can no longer
# complete, even though a full-coverage combination exists using only
# the OTHER denomination (confirmed live: apps=32, concurrency=65 gives
# 31 apps at concurrency 2 and 1 at concurrency 3; a deficit of 26 is
# fully expressible as thirteen 2s, but greedily bumping the lone
# concurrency-3 app first leaves an odd, concurrency-2-only leftover of
# 23, which is NOT expressible, producing a false nonzero remainder).
# So this instead runs an exact unbounded coin-change DP over
# 0..remaining using the distinct denominations present, to find the
# LARGEST amount of the deficit that is actually expressible by any
# combination (not just the first one a greedy sweep happens to try),
# and only reports whatever truly can't be expressed as the remainder.
#
# This always succeeds (remainder 0) when at least one denomination with
# value 1 is available (any app with concurrency 1 can absorb an
# arbitrary leftover one request at a time), and the DP correctly proves
# the smaller-scale case this replaces (3 apps all at concurrency 3, with
# a deficit of 1) is genuinely inexpressible rather than guessing. The
# true leftover is written to REMAINDER_VARNAME rather than silently
# dropped; the caller is expected to cover it with a dedicated extra
# concurrency-1 hey job (see the "conservation remainder" handling in
# run_benchmark_resident/run_benchmark_multi_app), since a concurrency-1
# invocation can always deliver any exact count with no truncation risk.
allocate_requests_hey_achievable() {
    local total_requests="$1" parts="$2"
    local -n _arha_conc="$3"
    local -n _arha_req_out="$4"
    local -n _arha_remainder="$5"

    local -a proportional
    allocate_evenly "$total_requests" "$parts" proportional

    local i c floor_i sum_floor=0
    _arha_req_out=()
    for ((i = 0; i < parts; i++)); do
        c="${_arha_conc[i]}"
        ((c > 0)) || c=1
        floor_i=$(((proportional[i] / c) * c))
        _arha_req_out+=("$floor_i")
        sum_floor=$((sum_floor + floor_i))
    done

    local remaining=$((total_requests - sum_floor))
    if ((remaining > 0)); then
        # Distinct denominations present, with how many apps share each
        # one. The DP below breaks reachability ties (several
        # denominations can express the same value) by trying the
        # denomination with the MOST matching apps first: with only this
        # change, ties would instead resolve in whatever order the
        # denominations were first encountered while scanning apps by
        # index, which can pick a denomination with very few (even just
        # one) matching apps purely because that app happens to come
        # first -- confirmed live for apps=32/requests=1000/concurrency=
        # 65 (31 apps at concurrency 2, 1 app at concurrency 3, with the
        # lone concurrency-3 app at index 0): encounter order tried
        # denomination 3 first, and since 2 and 3 can jointly express
        # every integer >= 2, via[] greedily kept choosing 3 for nearly
        # the whole deficit, piling eight +3 chunks onto that single app
        # (30 -> 54 requests, +22 over its target of 32) instead of
        # spreading the deficit across the 31 apps that share
        # concurrency 2. Preferring the more popular denomination first
        # fixes this: it reproduces the intended "thirteen 2s" combination
        # from this function's docstring, spreading the deficit across
        # many apps instead of concentrating it on one.
        local -a denoms=() denom_counts=()
        local d found di
        for ((i = 0; i < parts; i++)); do
            c="${_arha_conc[i]}"
            ((c > 0)) || c=1
            found=0
            for ((di = 0; di < ${#denoms[@]}; di++)); do
                if [[ "${denoms[di]}" == "$c" ]]; then
                    found=1
                    denom_counts[di]=$((denom_counts[di] + 1))
                    break
                fi
            done
            if ((!found)); then
                denoms+=("$c")
                denom_counts+=(1)
            fi
        done
        # Stable descending sort of denoms by denom_counts (insertion
        # sort; the number of distinct concurrency values is small).
        local a b tmp_d tmp_cnt
        for ((a = 1; a < ${#denoms[@]}; a++)); do
            tmp_d="${denoms[a]}"
            tmp_cnt="${denom_counts[a]}"
            b=$((a - 1))
            while ((b >= 0)) && ((denom_counts[b] < tmp_cnt)); do
                denoms[b + 1]="${denoms[b]}"
                denom_counts[b + 1]="${denom_counts[b]}"
                b=$((b - 1))
            done
            denoms[b + 1]="$tmp_d"
            denom_counts[b + 1]="$tmp_cnt"
        done

        # reachable[v]=1 if v is expressible as a non-negative combination
        # of the available denominations; via[v]=denomination last used to
        # reach v, for reconstructing the combination.
        local -a reachable via
        reachable[0]=1
        local v
        for ((v = 1; v <= remaining; v++)); do
            reachable[v]=0
            for d in "${denoms[@]}"; do
                if ((v >= d)) && [[ "${reachable[v - d]:-0}" == 1 ]]; then
                    reachable[v]=1
                    via[v]="$d"
                    break
                fi
            done
        done

        # Largest fully-expressible amount <= remaining; whatever is left
        # over after covering that amount is the genuine remainder.
        local covered=0
        for ((v = remaining; v >= 0; v--)); do
            if [[ "${reachable[v]:-0}" == 1 ]]; then
                covered="$v"
                break
            fi
        done
        _arha_remainder=$((remaining - covered))

        # Reconstruct the combination of denomination-chunks that sums to
        # "covered", then round-robin distribute those chunks across the
        # apps that share each denomination (bumping an app more than
        # once if a denomination's chunk count exceeds how many apps use
        # it).
        local -a chunk_counts=()
        for d in "${denoms[@]}"; do chunk_counts+=(0); done
        v="$covered"
        while ((v > 0)); do
            d="${via[v]}"
            local di=0
            for ((i = 0; i < ${#denoms[@]}; i++)); do
                [[ "${denoms[i]}" == "$d" ]] && di="$i" && break
            done
            chunk_counts[di]=$((chunk_counts[di] + 1))
            v=$((v - d))
        done

        local di
        for ((di = 0; di < ${#denoms[@]}; di++)); do
            d="${denoms[di]}"
            local need="${chunk_counts[di]}"
            ((need > 0)) || continue
            # Apps sharing this concurrency denomination, together with
            # each one's residual (how much of its allocate_evenly
            # proportional target was lost to the earlier floor step).
            # Chunks go to the greatest-residual apps first so a bump
            # moves an under-target app toward its target instead of
            # pushing an already-on-target app past it -- e.g. for
            # apps=32/requests=1000/concurrency=64 (uniform conc=2), 24
            # apps floor from target 31 to 30 (residual 1) and 8 apps
            # floor from target 32 to 32 (residual 0); preferring the
            # residual-1 apps for the 12 needed +2 chunks yields 20 apps
            # at 32 + 12 apps at 30 (max deviation 1 from target), not
            # the deviation-2 result of bumping residual-0 apps to 34
            # while leaving residual-1 apps at 30. Ties (equal residual)
            # break by ascending index for determinism.
            local -a matching_idx=() matching_residual=()
            for ((i = 0; i < parts; i++)); do
                c="${_arha_conc[i]}"
                ((c > 0)) || c=1
                if ((c == d)); then
                    matching_idx+=("$i")
                    matching_residual+=($((proportional[i] - _arha_req_out[i])))
                fi
            done
            local nmatch="${#matching_idx[@]}"
            # Stable descending sort by residual (insertion sort; nmatch
            # is bounded by the demo's app count, so this is cheap).
            local a b tmp_idx tmp_res
            for ((a = 1; a < nmatch; a++)); do
                tmp_idx="${matching_idx[a]}"
                tmp_res="${matching_residual[a]}"
                b=$((a - 1))
                while ((b >= 0)) && ((matching_residual[b] < tmp_res)); do
                    matching_idx[b + 1]="${matching_idx[b]}"
                    matching_residual[b + 1]="${matching_residual[b]}"
                    b=$((b - 1))
                done
                matching_idx[b + 1]="$tmp_idx"
                matching_residual[b + 1]="$tmp_res"
            done
            local k idx
            for ((k = 0; k < need; k++)); do
                idx="${matching_idx[k % nmatch]}"
                _arha_req_out[idx]=$((_arha_req_out[idx] + d))
            done
        done
    else
        _arha_remainder=0
    fi
}

# compute_benchmark_classes MODE SELECTED
#
# Decides which benchmark flag-validation class(es) apply to the demo
# selection that is about to run/preview/describe, and sets the globals
# uses_benchmark_apps and uses_legacy_benchmark accordingly. "one"/
# "describe" narrow to exactly one class based on the selected demo name;
# every other mode (all/preview/clear/self-test, or an unrecognized name
# later rejected elsewhere) conservatively enables both classes, since no
# single demo's scope narrows them. Kept separate from
# validate_benchmark_flags so self_test can exercise both independently.
compute_benchmark_classes() {
    local mode="$1" selected="${2:-}"
    uses_benchmark_apps=false
    uses_legacy_benchmark=false
    case "$mode" in
        one | describe)
            case "$selected" in
                benchmark-resident | benchmark-multi-app | benchmark-orchestrator-contract)
                    uses_benchmark_apps=true
                    ;;
                benchmark-on-demand | benchmark-prewarmed)
                    uses_legacy_benchmark=true
                    ;;
                *) ;;
            esac
            ;;
        *)
            uses_benchmark_apps=true
            uses_legacy_benchmark=true
            ;;
    esac
}

# validate_benchmark_flags REQUESTS CONCURRENCY POOL_VMS APPS LOAD_REQUESTS
#                          USES_APPS USES_LEGACY
#
# Pure validation: prints an error to stderr and returns 2 on the first
# violated constraint, else returns 0. USES_LEGACY gates the
# benchmark-on-demand/benchmark-prewarmed-only check (--benchmark-requests
# vs --benchmark-concurrency); USES_APPS gates the three load-benchmark
# checks (--benchmark-apps vs --benchmark-concurrency/--benchmark-load-
# requests). Regression guard: --benchmark-concurrency cannot exceed
# --benchmark-requests used to run unconditionally, so a load-benchmark
# invocation with a large --benchmark-concurrency intended for
# --benchmark-load-requests incorrectly tripped the legacy-only
# --benchmark-requests default. Kept standalone (no arg parsing, no
# launching) so self_test can exercise exact reported flag combinations
# deterministically.
validate_benchmark_flags() {
    local requests="$1" concurrency="$2" pool_vms="$3"
    local apps="$4" load_requests="$5" uses_apps="$6" uses_legacy="$7"
    if ((pool_vms < 2)); then
        echo "--benchmark-pool-vms must be at least 2" >&2
        return 2
    fi
    if "$uses_legacy" && ((concurrency > requests)); then
        echo "--benchmark-concurrency cannot exceed --benchmark-requests" >&2
        return 2
    fi
    if "$uses_apps"; then
        if ((concurrency < apps)); then
            echo "--benchmark-concurrency must be at least --benchmark-apps" >&2
            return 2
        fi
        if ((apps > load_requests)); then
            echo "--benchmark-apps cannot exceed --benchmark-load-requests" >&2
            return 2
        fi
        if ((concurrency > load_requests)); then
            echo "--benchmark-concurrency cannot exceed --benchmark-load-requests" >&2
            return 2
        fi
    fi
    return 0
}

# self_test: lightweight, offline (no demo processes, no network) coverage
# for allocate_evenly's determinism/remainder handling, plus targeted
# regression guards. Run via the hidden `--self-test` flag; exits
# non-zero on the first failed assertion.
self_test() {
    local failures=0

    assert_alloc() {
        local total="$1" parts="$2" expected="$3"
        local -a got
        allocate_evenly "$total" "$parts" got
        local actual="${got[*]}"
        if [[ "$actual" != "$expected" ]]; then
            printf 'FAIL allocate_evenly %s %s: expected [%s] got [%s]\n' \
                "$total" "$parts" "$expected" "$actual" >&2
            failures=$((failures + 1))
            return
        fi
        local sum=0 x
        for x in "${got[@]}"; do sum=$((sum + x)); done
        if ((sum != total)); then
            printf 'FAIL allocate_evenly %s %s: parts sum to %s, not %s\n' \
                "$total" "$parts" "$sum" "$total" >&2
            failures=$((failures + 1))
        fi
    }

    assert_alloc 100 4 "25 25 25 25"
    assert_alloc 10 3 "4 3 3"
    assert_alloc 1 1 "1"
    assert_alloc 1 3 "1 0 0"
    assert_alloc 7 7 "1 1 1 1 1 1 1"
    assert_alloc 0 4 "0 0 0 0"

    local driver_position driver_preview driver_preview_dir
    driver_preview_dir="$(mktemp -d)"
    for driver_position in before after; do
        local -a driver_args=(--benchmark-apps 512 --benchmark-load-requests 51200 --benchmark-concurrency 512)
        if [[ "$driver_position" == before ]]; then
            driver_args+=(--benchmark-load-driver vegeta --describe benchmark-resident)
        else
            driver_args+=(--describe benchmark-resident --benchmark-load-driver vegeta)
        fi
        driver_preview="$(HYPERLIGHT_DEMO_OUTPUT="$driver_preview_dir" \
            bash "$root/tools/hyperlight-demo" "${driver_args[@]}")"
        if [[ "$driver_preview" != *"LOAD DRIVER: vegeta"* ||
            "$driver_preview" != *"512 workers across 512 apps"* ||
            "$driver_preview" == *"real hey load"* ]]; then
            printf 'FAIL vegeta selection/display with driver argument %s demo\n' "$driver_position" >&2
            failures=$((failures + 1))
        fi
    done
    rm -f "$driver_preview_dir/worker-code/benchmark-resident.json"
    rmdir "$driver_preview_dir/worker-code" "$driver_preview_dir"
    local request_records
    request_records="$(filter_vegeta_request_results <<'JSON'
{"code":0,"method":"","url":"","error":"no targets to attack"}
{"code":200,"method":"GET","url":"http://example.test/","error":"","body":"b2s=","headers":{"Content-Length":["2"]},"bytes_in":2,"latency":123}
{"code":0,"method":"GET","url":"http://example.test/","error":"connection refused"}
JSON
)"
    if ! jq -s -e 'length == 2 and .[0].code == 200 and .[1].error == "connection refused"
        and .[0].bytes_in == 2 and .[0].latency == 123
        and (.[0] | has("body") or has("headers") | not)' \
        <<<"$request_records" >/dev/null; then
        echo "FAIL vegeta EOF filtering: real request successes/errors must remain" >&2
        failures=$((failures + 1))
    fi

    local config_test_dir config_index config_capacity config_pool config_app
    local -a config_capacities=(1 2 20)
    config_test_dir="$(mktemp -d)"
    write_resident_benchmark_configs "$config_test_dir" "bundle.json" "snapshot-dir" config_capacities
    for config_index in 0 1 2; do
        config_capacity="${config_capacities[config_index]}"
        config_pool="$(jq -n --argjson c "$config_capacity" \
            '{kind:"resident",capacity:$c,queue_capacity:([64,($c*4)]|max),
              max_requests_per_vm:null,max_lifetime_secs:null}')"
        config_app="$(app_config "bench-$config_index" bench.resident.test \
            bundle.json "$config_pool" none snapshot-dir)"
        write_host_config "$config_test_dir/expected.json" "[$config_app]"
        if ! diff <(jq -S . "$config_test_dir/expected.json") \
            <(jq -S . "$config_test_dir/app-$config_index/config.json") >/dev/null; then
            echo "FAIL batched resident config differs from standard config helpers" >&2
            failures=$((failures + 1))
        fi
        rm -f "$config_test_dir/app-$config_index/config.json"
        rmdir "$config_test_dir/app-$config_index"
    done
    rm -f "$config_test_dir/expected.json"
    rmdir "$config_test_dir"

    # Regression guard for run_one's fail-fast fix: bash disables errexit
    # for a compound command (and everything nested inside it, including
    # nested `set -e`) whenever that compound command is the left-hand
    # side of `||`. `run_one` avoids that by toggling errexit off/on
    # around a plain (non-conditional) subshell invocation instead of
    # `(...) || status=$?`. Prove both the broken and the fixed pattern
    # here, offline, so a future edit that reintroduces the `||` form is
    # caught without needing a real demo process.
    _self_test_fails() { local x=5; [[ "$x" == 0 ]]; echo "unreachable"; }

    local broken_status=0
    ( set -e; _self_test_fails >/dev/null 2>&1 ) || broken_status=$?
    if ((broken_status == 0)); then
        echo "self-test: confirmed the broken '(...) || status=\$?' pattern" \
            "masks a failing assertion (status=0, as expected for this negative check)"
    else
        printf 'FAIL run_one regression guard: the broken pattern unexpectedly' >&2
        printf ' reported status=%s; the pattern this guards against may have' "$broken_status" >&2
        printf ' changed and this guard needs to be re-reasoned about\n' >&2
        failures=$((failures + 1))
    fi

    set +e
    ( set -e; _self_test_fails >/dev/null 2>&1 )
    local fixed_status=$?
    set -e
    if ((fixed_status != 0)); then
        echo "self-test: run_one's fail-fast pattern reports a nonzero status" \
            "for a failing demo (status=$fixed_status)"
    else
        echo "FAIL run_one regression guard: the fail-fast pattern reported" \
            "status=0 for a deliberately failing assertion" >&2
        failures=$((failures + 1))
    fi
    unset -f _self_test_fails

    # Regression guard: `tools/hyperlight-demo --benchmark-apps 32
    # --benchmark-load-requests 32768 --benchmark-concurrency 2048 --demo
    # benchmark-resident` used to fail with "--benchmark-concurrency
    # cannot exceed --benchmark-requests" because that legacy-only check
    # ran unconditionally. Prove the exact reported values now pass for a
    # load-benchmark demo, and prove the legacy check still rejects the
    # equivalent invalid combination for a legacy demo and the apps check
    # still rejects an invalid load-benchmark combination -- so the fix
    # narrows the check instead of disabling it universally.
    assert_benchmark_validation() {
        local label="$1" mode="$2" selected="$3"
        local requests="$4" concurrency="$5" pool_vms="$6" apps="$7" load_requests="$8"
        local expect="$9"
        compute_benchmark_classes "$mode" "$selected"
        local msg status=0
        msg="$(validate_benchmark_flags "$requests" "$concurrency" "$pool_vms" \
            "$apps" "$load_requests" "$uses_benchmark_apps" "$uses_legacy_benchmark" 2>&1)" ||
            status=$?
        if [[ "$expect" == pass ]]; then
            if ((status != 0)); then
                printf 'FAIL %s: expected validation to pass, got: %s\n' "$label" "$msg" >&2
                failures=$((failures + 1))
            fi
        else
            if ((status == 0)); then
                printf 'FAIL %s: expected validation to reject, but it passed\n' "$label" >&2
                failures=$((failures + 1))
            fi
        fi
    }

    assert_benchmark_validation \
        "reported benchmark-resident regression" one benchmark-resident \
        100 2048 2 32 32768 pass
    assert_benchmark_validation \
        "legacy benchmark-on-demand still rejects concurrency > requests" one benchmark-on-demand \
        100 2048 2 32 32768 fail
    assert_benchmark_validation \
        "benchmark-multi-app still rejects concurrency < apps" one benchmark-multi-app \
        100 10 2 32 32768 fail
    unset -f assert_benchmark_validation

    # Regression guard: tools/hyperlight-demo invokes several tools/*.sh
    # helpers directly by path (e.g. "$root/tools/run-workerd-vfs-demo.sh"),
    # which relies on the shell honoring the file's executable permission
    # bit. git tracks that bit per-blob (100755 vs 100644) independently of
    # file content, so a helper can be syntactically perfect yet still fail
    # with "Permission denied" on a fresh clone if it was ever committed, or
    # re-added, without the executable bit. Catch that offline, without
    # launching any demo process, by checking every script this file is
    # known to invoke directly (helper_scripts_invoked_directly) both on
    # disk and (when git metadata is available) in the index/HEAD tree.
    assert_helper_executable() {
        local helper="$1"
        local path="$root/$helper"
        if [[ ! -e "$path" ]]; then
            printf 'FAIL helper executability %s: file does not exist at %s\n' \
                "$helper" "$path" >&2
            failures=$((failures + 1))
            return
        fi
        if [[ ! -x "$path" ]]; then
            printf 'FAIL helper executability %s: not executable on disk (chmod +x %s)\n' \
                "$helper" "$path" >&2
            failures=$((failures + 1))
        fi
        if command -v git >/dev/null && git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            local tracked_mode
            tracked_mode="$(git -C "$root" ls-files -s -- "$helper" 2>/dev/null | awk '{print $1}')"
            if [[ -n "$tracked_mode" && "$tracked_mode" != "100755" ]]; then
                printf 'FAIL helper executability %s: git-tracked mode is %s, not 100755\n' \
                    "$helper" "$tracked_mode" >&2
                failures=$((failures + 1))
            fi
        fi
    }

    local helper
    for helper in "${helper_scripts_invoked_directly[@]}"; do
        assert_helper_executable "$helper"
    done
    unset -f assert_helper_executable

    # Regression guard for the benchmark-orchestrator-contract post-signal
    # probe bug fix: curl exit 28 (and the other reproduced "no new
    # connection admitted" exit codes, 7/52/56) must classify as the
    # expected no_response outcome ONLY via this narrow, purpose-built
    # helper -- not via some broad "ignore all curl timeouts" rule. Any
    # curl exit not in that documented set, and any exit-0 response other
    # than a plain 200, must still be classified as a genuine, surfaced
    # failure so an unrelated/unexpected curl error is never silently
    # swallowed as "expected during drain".
    assert_post_signal_probe() {
        local label="$1" curl_exit="$2" http_code="$3" expected="$4"
        local got
        got="$(classify_post_signal_probe "$curl_exit" "$http_code")"
        if [[ "$got" != "$expected" ]]; then
            printf 'FAIL classify_post_signal_probe %s: expected %s got %s\n' \
                "$label" "$expected" "$got" >&2
            failures=$((failures + 1))
        fi
    }

    assert_post_signal_probe "timeout (28) during drain" 28 "000" no_response
    assert_post_signal_probe "connection refused (7) during drain" 7 "000" no_response
    assert_post_signal_probe "empty reply (52) during drain" 52 "000" no_response
    assert_post_signal_probe "connection reset (56) during drain" 56 "000" no_response
    assert_post_signal_probe "still answering 200 after SIGTERM" 0 200 unexpected_200
    assert_post_signal_probe "answering non-200 after SIGTERM" 0 503 unexpected_http_503
    assert_post_signal_probe "unrelated curl failure (e.g. DNS)" 6 "000" unexpected_error
    unset -f assert_post_signal_probe

    # Regression guard for the benchmark-orchestrator-contract phase-B
    # over-queueing bug: reqs must always equal conc (never a larger
    # phase_b_alloc share), including at the default scale where
    # benchmark_apps == benchmark_concurrency drives conc_alloc[i] down to
    # 1 while phase_b_alloc[i] is in the hundreds -- that combination is
    # exactly what let the old floor(phase_b_alloc/conc)*conc formula send
    # hundreds of requests when only the first could ever be in flight at
    # signal time.
    assert_phase_b_batch() {
        local label="$1" conc_alloc_for_app="$2" phase_b_alloc_for_app="$3" \
            expected_conc="$4" expected_reqs="$5"
        local got_conc got_reqs
        read -r got_conc got_reqs < <(resolve_phase_b_batch \
            "$conc_alloc_for_app" "$phase_b_alloc_for_app")
        if [[ "$got_conc" != "$expected_conc" || "$got_reqs" != "$expected_reqs" ]]; then
            printf 'FAIL resolve_phase_b_batch %s: expected conc=%s reqs=%s got conc=%s reqs=%s\n' \
                "$label" "$expected_conc" "$expected_reqs" "$got_conc" "$got_reqs" >&2
            failures=$((failures + 1))
        fi
    }

    assert_phase_b_batch \
        "default scale (apps == concurrency, conc_alloc 1, phase_b_alloc 250)" \
        1 250 1 1
    assert_phase_b_batch \
        "higher per-app concurrency (conc_alloc 3, phase_b_alloc 250)" \
        3 250 3 3
    assert_phase_b_batch \
        "tiny total caps conc below conc_alloc (conc_alloc 4, phase_b_alloc 2)" \
        4 2 2 2
    unset -f assert_phase_b_batch

    # Regression guard for the benchmark-resident/benchmark-multi-app
    # "did not report N 200 responses" bug: hey truncates -n to a multiple
    # of -c (confirmed live: `hey -n 31 -c 2` sends only 30 requests), so
    # any per-app request target computed via allocate_evenly must be
    # snapped down to what hey will actually send before it's used as both
    # hey's -n argument and the expected-response-count assertion.
    assert_snap_reqs() {
        local label="$1" req_alloc_for_app="$2" conc="$3" expected="$4"
        local got
        got="$(snap_reqs_to_hey_achievable "$req_alloc_for_app" "$conc")"
        if [[ "$got" != "$expected" ]]; then
            printf 'FAIL snap_reqs_to_hey_achievable %s: expected %s got %s\n' \
                "$label" "$expected" "$got" >&2
            failures=$((failures + 1))
        fi
    }

    # Exact reported repro: --benchmark-apps 32 --benchmark-load-requests
    # 1000 --benchmark-concurrency 64 -> allocate_evenly(1000,32) gives 8
    # apps 32 requests and 24 apps 31 requests; allocate_evenly(64,32)
    # gives every app conc=2 (C > M, non-divisible per-app share).
    assert_snap_reqs "exact repro, divisible share (alloc 32, conc 2)" 32 2 32
    assert_snap_reqs "exact repro, non-divisible share (alloc 31, conc 2)" 31 2 30
    assert_snap_reqs "alloc smaller than conc rounds up to conc (alloc 1, conc 4)" 1 4 4
    assert_snap_reqs "alloc exactly equal to conc (alloc 4, conc 4)" 4 4 4
    assert_snap_reqs "non-divisible large allocation (alloc 75, conc 4)" 75 4 72
    assert_snap_reqs "concurrency equal to requests, C == N (alloc 64, conc 64)" 64 64 64
    unset -f assert_snap_reqs

    # Regression guard for the follow-up bug: snap_reqs_to_hey_achievable
    # is correct per-app but, applied independently to every app, can
    # under-deliver the user's requested total (e.g. apps=32,
    # load-requests=1000, concurrency=64 only ever sends 976 of the
    # requested 1000). allocate_requests_hey_achievable must instead
    # conserve the exact total across all apps while keeping every app's
    # count hey-achievable, and must report an honest nonzero remainder
    # (never silently drop) when that is mathematically impossible with
    # the given per-app concurrency values.
    assert_conservation() {
        local label="$1" expected_remainder="$2" total_requests="$3" parts="$4"
        shift 4
        local -a conc_in=("$@")
        local -a req_out
        local remainder
        allocate_requests_hey_achievable "$total_requests" "$parts" conc_in req_out remainder
        if [[ "$remainder" != "$expected_remainder" ]]; then
            printf 'FAIL allocate_requests_hey_achievable %s: remainder expected %s got %s\n' \
                "$label" "$expected_remainder" "$remainder" >&2
            failures=$((failures + 1))
            return
        fi
        local sum=0 i c
        for ((i = 0; i < parts; i++)); do
            sum=$((sum + req_out[i]))
            c="${conc_in[i]}"
            ((c > 0)) || c=1
            if ((req_out[i] % c != 0)); then
                printf 'FAIL allocate_requests_hey_achievable %s: app %d req=%s not a multiple of conc=%s\n' \
                    "$label" "$i" "${req_out[i]}" "$c" >&2
                failures=$((failures + 1))
            fi
        done
        if ((sum + remainder != total_requests)); then
            printf 'FAIL allocate_requests_hey_achievable %s: sum(req)=%s + remainder=%s != total=%s\n' \
                "$label" "$sum" "$remainder" "$total_requests" >&2
            failures=$((failures + 1))
        fi
    }

    local -a conc_c64 conc_c32 conc_c65 conc_c9
    allocate_evenly 64 32 conc_c64
    allocate_evenly 32 32 conc_c32
    allocate_evenly 65 32 conc_c65
    allocate_evenly 9 3 conc_c9

    # Exact reported repro: apps=32, load-requests=1000, concurrency=64 --
    # every app gets concurrency 2 (uniform, 64/32); must still sum to
    # exactly 1000, with every per-app count divisible by 2.
    assert_conservation "M=32,N=1000,C=64 (uniform conc=2)" 0 1000 32 "${conc_c64[@]}"
    # Adjacent case: concurrency == apps, every app gets concurrency 1
    # (trivially hey-achievable at any count).
    assert_conservation "M=32,N=1000,C=32 (uniform conc=1)" 0 1000 32 "${conc_c32[@]}"
    # Adjacent case: non-divisible C/M gives 31 apps conc=2 and 1 app
    # conc=3 -- two different concurrency "denominations" in play.
    assert_conservation "M=32,N=1000,C=65 (non-uniform conc 2/3)" 0 1000 32 "${conc_c65[@]}"
    # Mathematically-impossible-without-a-remainder case: 3 apps all at
    # concurrency 3, total 10 -- allocate_evenly(10,3) gives [4,3,3],
    # flooring to [3,3,3] (sum 9); the missing 1 request cannot be formed
    # from any non-negative combination of concurrency-3 chunks, so the
    # function must report remainder=1 rather than silently returning a
    # sum of 9 and calling it done. The caller's "conservation remainder"
    # fallback (one extra concurrency-1 hey job) is what actually covers
    # this in run_benchmark_resident/run_benchmark_multi_app.
    assert_conservation "M=3,N=10,C=9 (all conc=3, impossible remainder)" 1 10 3 "${conc_c9[@]}"
    unset -f assert_conservation

    # Regression guard for the DP's denomination-choice fairness bug:
    # when several denominations could equally extend coverage, the
    # reconstruction must prefer the denomination with the MOST matching
    # apps, not whichever concurrency value happens to appear first by
    # app index -- otherwise it can pile the whole deficit onto one
    # scarce-denomination app instead of spreading it (confirmed live
    # for apps=32/concurrency=65: encounter order piled eight extra +3
    # chunks onto the lone concurrency-3 app, taking its actual count
    # from a target of 32 to 54). Flooring an app to a multiple of its
    # own concurrency can only ever move it down by less than its own
    # concurrency, and no correct reconstruction should need to move an
    # app further than one more concurrency unit past that, so
    # |actual - target| must never exceed the app's own concurrency.
    assert_fairness_bound() {
        local label="$1" total_requests="$2" parts="$3"
        shift 3
        local -a conc_in=("$@")
        local -a proportional req_out
        local remainder
        allocate_evenly "$total_requests" "$parts" proportional
        allocate_requests_hey_achievable "$total_requests" "$parts" conc_in req_out remainder
        local i c dev
        for ((i = 0; i < parts; i++)); do
            c="${conc_in[i]}"
            ((c > 0)) || c=1
            dev=$((req_out[i] - proportional[i]))
            ((dev < 0)) && dev=$((-dev))
            if ((dev > c)); then
                printf 'FAIL allocate_requests_hey_achievable %s: app %d deviates %s from target %s (conc=%s, max allowed %s)\n' \
                    "$label" "$i" "$((req_out[i] - proportional[i]))" "${proportional[i]}" "$c" "$c" >&2
                failures=$((failures + 1))
            fi
        done
    }
    assert_fairness_bound "M=32,N=1000,C=64 (uniform conc=2)" 1000 32 "${conc_c64[@]}"
    assert_fairness_bound "M=32,N=1000,C=32 (uniform conc=1)" 1000 32 "${conc_c32[@]}"
    assert_fairness_bound "M=32,N=1000,C=65 (non-uniform conc 2/3)" 1000 32 "${conc_c65[@]}"
    assert_fairness_bound "M=3,N=10,C=9 (all conc=3, impossible remainder)" 10 3 "${conc_c9[@]}"
    unset -f assert_fairness_bound

    # Regression guard specifically for the exact reported repro's
    # distribution: before the residual-priority fairness fix,
    # reconstruction bumped whichever 12 apps happened to come first in
    # index order -- which could be 8 apps already sitting exactly on
    # their proportional target (32) getting pushed to 34 (deviation 2),
    # while 12 of the 24 under-target apps (target 31, floored to 30)
    # were left there unfinished. Preferring the greatest-residual apps
    # first must instead finish exactly 12 of those 24 under-target apps
    # (30 -> 32), yielding 20 apps total at 32 requests (12 bumped + the
    # 8 already there) and 12 apps left at 30, with no app anywhere at 34.
    assert_exact_frequency() {
        local label="$1" total_requests="$2" parts="$3"
        shift 3
        local -a conc_in=("$@")
        local -a req_out
        local remainder
        allocate_requests_hey_achievable "$total_requests" "$parts" conc_in req_out remainder
        local i count_32=0 count_30=0 count_other=0
        for ((i = 0; i < parts; i++)); do
            case "${req_out[i]}" in
                32) count_32=$((count_32 + 1)) ;;
                30) count_30=$((count_30 + 1)) ;;
                *) count_other=$((count_other + 1)) ;;
            esac
        done
        if ((count_32 != 20 || count_30 != 12 || count_other != 0)); then
            printf 'FAIL allocate_requests_hey_achievable %s: expected 20 apps@32 + 12 apps@30 + 0 other, got %s@32 + %s@30 + %s other\n' \
                "$label" "$count_32" "$count_30" "$count_other" >&2
            failures=$((failures + 1))
        fi
    }
    assert_exact_frequency "M=32,N=1000,C=64 exact distribution" 1000 32 "${conc_c64[@]}"
    unset -f assert_exact_frequency

    # Regression guard for the launch_hey_jobs barrier-timing fix: before
    # this fix, a wave's timestamp was taken BEFORE the per-job forking
    # loop, so any slowness in forking/spawning N paused `hey` subshells
    # was silently folded into the reported load duration alongside the
    # actual request-serving time it was supposed to isolate. The fix
    # moves the timestamp to immediately before the barrier-release gate
    # file is created. Prove this with a fake `hey` binary (so this stays
    # offline -- no real demo process, no network) and a self-test-only
    # `_LHJ_TEST_PRE_RELEASE_SLEEP` hook that simulates slow pre-release
    # work: a pre-release delay must NOT show up in the reported
    # wave_active_seconds even though it does lengthen the function's own
    # real wall-clock duration, while a post-release delay (the fake
    # `hey`'s own sleep, standing in for real request-serving time) MUST
    # show up. Also proves multi-wave accumulation: two waves (forced via
    # hey_max_parallel_jobs=1) each contribute their own active duration
    # to the sum, and load_wall_seconds (first-release-to-last-finish)
    # is at least as large as that sum once an inter-wave gap exists.
    assert_barrier_timing() {
        local fake_bin work_dir
        fake_bin="$(mktemp -d)"
        work_dir="$(mktemp -d)"
        cat >"$fake_bin/hey" <<'FAKE_HEY'
#!/usr/bin/env bash
# Self-test stub standing in for the real `hey` binary: sleeps for
# HYPERLIGHT_DEMO_FAKE_HEY_SLEEP seconds (simulating real request-serving
# time happening strictly after launch_hey_jobs's barrier release), then
# prints just enough of a real hey report's shape that nothing downstream
# chokes on a missing field, ignoring all of its own arguments.
sleep "${HYPERLIGHT_DEMO_FAKE_HEY_SLEEP:-0}"
cat <<'REPORT'

Summary:
  Total:        0.0100 secs
  Average:      0.0050 secs
  Requests/sec: 100.0000

Status code distribution:
  [200]  1 responses
REPORT
FAKE_HEY
        chmod +x "$fake_bin/hey"

        # Case 1: a 0.3s delay injected after forking but before the
        # barrier release must not leak into wave_active_seconds, even
        # though it does lengthen launch_hey_jobs's own real duration.
        local -a reqs=(1) concs=(1) urls=("http://example.invalid/") hosts=("")
        local -a timeouts=(5) outfiles=("$work_dir/pre.txt") statuses
        local active_pre="" wall_pre="" outer_t0 outer_t1 outer_elapsed
        outer_t0="$(now_seconds)"
        PATH="$fake_bin:$PATH" HYPERLIGHT_DEMO_FAKE_HEY_SLEEP=0 \
            _LHJ_TEST_PRE_RELEASE_SLEEP=0.3 \
            launch_hey_jobs reqs concs urls hosts timeouts outfiles statuses \
            "" active_pre wall_pre
        outer_t1="$(now_seconds)"
        outer_elapsed="$(seconds_between "$outer_t0" "$outer_t1")"
        if ! awk -v o="$outer_elapsed" 'BEGIN { exit !(o >= 0.25) }'; then
            printf 'FAIL barrier-timing pre-release case: outer elapsed %ss did not reflect the 0.3s pre-release sleep\n' \
                "$outer_elapsed" >&2
            failures=$((failures + 1))
        fi
        if ! awk -v a="$active_pre" 'BEGIN { exit !(a < 0.15) }'; then
            printf 'FAIL barrier-timing pre-release case: wave_active_seconds=%ss unexpectedly absorbed the pre-release delay (expected < 0.15s)\n' \
                "$active_pre" >&2
            failures=$((failures + 1))
        fi

        # Case 2: a 0.3s delay in the fake hey process itself (strictly
        # after the barrier release) must show up in wave_active_seconds.
        local active_post="" wall_post=""
        local -a outfiles2=("$work_dir/post.txt") statuses2
        PATH="$fake_bin:$PATH" HYPERLIGHT_DEMO_FAKE_HEY_SLEEP=0.3 \
            launch_hey_jobs reqs concs urls hosts timeouts outfiles2 statuses2 \
            "" active_post wall_post
        if ! awk -v a="$active_post" 'BEGIN { exit !(a >= 0.25 && a < 1.2) }'; then
            printf 'FAIL barrier-timing post-release case: wave_active_seconds=%ss did not reflect the 0.3s post-release (hey-side) sleep\n' \
                "$active_post" >&2
            failures=$((failures + 1))
        fi

        # Case 3: two single-job waves (hey_max_parallel_jobs=1), each
        # with a 0.2s post-release sleep, must accumulate wave_active_
        # seconds across both waves (~0.4s), and load_wall_seconds must be
        # at least that much (it also spans the inter-wave gap).
        local -a reqs3=(1 1) concs3=(1 1)
        local -a urls3=("http://example.invalid/" "http://example.invalid/")
        local -a hosts3=("" "") timeouts3=(5 5)
        local -a outfiles3=("$work_dir/w1.txt" "$work_dir/w2.txt") statuses3
        local active_multi="" wall_multi=""
        local hey_max_parallel_jobs=1 hey_ramp_ms=0
        PATH="$fake_bin:$PATH" HYPERLIGHT_DEMO_FAKE_HEY_SLEEP=0.2 \
            launch_hey_jobs reqs3 concs3 urls3 hosts3 timeouts3 outfiles3 statuses3 \
            "" active_multi wall_multi
        if ! awk -v a="$active_multi" 'BEGIN { exit !(a >= 0.35 && a < 1.5) }'; then
            printf 'FAIL barrier-timing multi-wave case: wave_active_seconds=%ss did not reflect two accumulated 0.2s waves (expected >= 0.35s)\n' \
                "$active_multi" >&2
            failures=$((failures + 1))
        fi
        if ! awk -v w="$wall_multi" -v a="$active_multi" 'BEGIN { exit !(w >= a - 0.05) }'; then
            printf 'FAIL barrier-timing multi-wave case: load_wall_seconds=%ss is smaller than wave_active_seconds=%ss (wall must be >= sum of wave actives)\n' \
                "$wall_multi" "$active_multi" >&2
            failures=$((failures + 1))
        fi

        rm -rf "$fake_bin" "$work_dir"
    }
    assert_barrier_timing
    unset -f assert_barrier_timing

    # Regression guard for the monotonic-clock requirement behind the
    # barrier timings above: now_monotonic_seconds must never go
    # backwards across two successive reads (the defining property that
    # justifies using it over wall-clock now_seconds for interval
    # measurement), and must actually advance over a short real sleep so
    # it is not a frozen/constant stub.
    assert_monotonic_clock() {
        local t0 t1
        t0="$(now_monotonic_seconds)"
        sleep 0.05
        t1="$(now_monotonic_seconds)"
        if ! awk -v a="$t0" -v b="$t1" 'BEGIN { exit !(b >= a) }'; then
            printf 'FAIL now_monotonic_seconds: second read %s is before first read %s (not monotonic)\n' \
                "$t1" "$t0" >&2
            failures=$((failures + 1))
        fi
        if ! awk -v a="$t0" -v b="$t1" 'BEGIN { exit !(b > a) }'; then
            printf 'FAIL now_monotonic_seconds: second read %s did not advance past first read %s across a real 0.05s sleep\n' \
                "$t1" "$t0" >&2
            failures=$((failures + 1))
        fi
        if [[ -r /proc/uptime ]]; then
            local uptime_seconds
            read -r uptime_seconds _ </proc/uptime
            if ! awk -v u="$uptime_seconds" -v t="$t1" 'BEGIN { exit !((t - u < 1) && (t - u > -1)) }'; then
                printf 'FAIL now_monotonic_seconds: value %s is not close to /proc/uptime (%s) even though /proc/uptime is readable -- not using the monotonic source\n' \
                    "$t1" "$uptime_seconds" >&2
                failures=$((failures + 1))
            fi
        fi
    }
    assert_monotonic_clock
    unset -f assert_monotonic_clock

    # Regression guard for the benchmark-resident "is it hung?" progress
    # indicator (print_progress_bar): when stdout is NOT a terminal --
    # the only path self-test/CI can reliably capture via $(...); the
    # the pseudo-TTY regression below covers the interactive path;
    # captured output must emit periodic plain-line progress, always
    # including the very first and last step, and must not error on
    # TOTAL=0 (guards the division-by-zero edge case).
    # _LHJ_TEST_NO_TTY_ESCAPE forces print_progress_bar's fd-1 fallback
    # even when self-test happens to run in a real terminal, since
    # otherwise it would escape to /dev/tty (see print_progress_bar) and
    # bypass this `$(...)` capture entirely, making $out empty.
    assert_progress_bar() {
        local out
        out="$(export _LHJ_TEST_NO_TTY_ESCAPE=1; for ((i = 1; i <= 100; i++)); do print_progress_bar "$i" 100 "test" "$i"; done)"
        if ! grep -q '1/100' <<<"$out"; then
            printf 'FAIL print_progress_bar: first step (1/100) not printed\n' >&2
            failures=$((failures + 1))
        fi
        if ! grep -q '100/100' <<<"$out"; then
            printf 'FAIL print_progress_bar: last step (100/100) not printed\n' >&2
            failures=$((failures + 1))
        fi
        if [[ "$out" == *$'\r'* || "$out" == *$'\033'* ]]; then
            echo "FAIL print_progress_bar: terminal controls leaked into captured output" >&2
            failures=$((failures + 1))
        fi
        local large_out
        # shellcheck disable=SC2030,SC2031 # Captured rendering deliberately uses its own override.
        large_out="$(export _LHJ_TEST_NO_TTY_ESCAPE=1
            for ((i = 1; i <= 4096; i++)); do
                print_progress_bar "$i" 4096 "setup: resident hosts ready" "$i"
            done
            phase_message "next phase"
            stop_processes)"
        if [[ "$large_out" != *"4096/4096"* || "$large_out" == *$'\r'* ||
            "$large_out" == *$'\033'* ]]; then
            echo "FAIL 4096-host captured progress: missing completion or terminal controls" >&2
            failures=$((failures + 1))
        fi
        local lines
        lines=$(grep -c . <<<"$out")
        if ((lines < 2 || lines > 45)); then
            printf 'FAIL print_progress_bar: expected roughly ~40 throttled lines for TOTAL=100, got %d\n' "$lines" >&2
            failures=$((failures + 1))
        fi
        local zero_out
        if ! zero_out="$(_LHJ_TEST_NO_TTY_ESCAPE=1 print_progress_bar 0 0 "edge" 0 2>&1)"; then
            printf 'FAIL print_progress_bar: TOTAL=0 should not error, got: %s\n' "$zero_out" >&2
            failures=$((failures + 1))
        fi
    }
    assert_progress_bar
    unset -f assert_progress_bar
    if ! python3 - "$root/tools/hyperlight-demo" <<'PY'
import errno
import os
import pty
import subprocess
import sys

master, slave = pty.openpty()
script = r"""
set -euo pipefail
eval "$(sed '/^mode=interactive$/,$d' "$DEMO_SCRIPT")"
unset COLUMNS
stty cols 180 <&1
print_progress_bar 997 4096 "setup: resident hosts ready very long previous label" 12345
print_progress_bar 997 4096 "setup: resident hosts ready" 27
phase_message "next phase"
stty cols 60 <&1
print_progress_bar 1 4096 "shrinking terminal" 12345
stty cols 100 <&1
print_progress_bar 4096 4096 "complete" 15
print_progress_bar 1 4096 "failure in progress" 9
stop_processes
printf 'failure message\n'
"""
try:
    process = subprocess.Popen(
        ["bash"], stdin=subprocess.PIPE, stdout=slave, stderr=slave,
        env=dict(os.environ, DEMO_SCRIPT=sys.argv[1], _LHJ_TEST_NO_TTY_ESCAPE="1"),
    )
    os.close(slave)
    slave = None
    process.stdin.write(script.encode())
    process.stdin.close()
    chunks = []
    while True:
        try:
            chunk = os.read(master, 65536)
        except OSError as error:
            if error.errno != errno.EIO:
                raise
            break
        if not chunk:
            break
        chunks.append(chunk)
    assert process.wait(timeout=10) == 0
    text = b"".join(chunks).decode()
    rows, row, column, erased_rows = [], [], 0, []
    index = 0
    while index < len(text):
        if text.startswith("\x1b[2K", index):
            erased_rows.append("".join(row))
            row = []
            index += 4
            continue
        char = text[index]
        if char == "\r":
            column = 0
        elif char == "\n":
            rows.append("".join(row))
            row, column = [], 0
        else:
            while len(row) <= column:
                row.append(" ")
            row[column] = char
            column += 1
        index += 1
    assert rows[0] == "  setup: resident hosts ready [#######                       ] 997/4096 (24%, 27s)", rows
    assert rows[1] == "next phase", rows
    assert len(erased_rows[3]) == 59, erased_rows
    assert len(rows[2]) < 100 and rows[2].endswith("(100%, 15s)"), rows
    assert rows[3].endswith("(0%, 9s)") and rows[4] == "failure message", rows
    assert row == [], "completion/failure did not end on a clean newline"
    assert text.count("\r\x1b[2K") == 5, repr(text)
    print("self-test: pseudo-TTY 4096-app redraw, shorter text, width changes, phase messages and failure newline passed")
finally:
    os.close(master)
    if slave is not None:
        os.close(slave)
PY
    then
        echo "FAIL pseudo-TTY progress rendering" >&2
        failures=$((failures + 1))
    fi

    if ((failures == 0)); then
        echo "self-test: all allocate_evenly, benchmark-flag-validation, vegeta-selection/display, vegeta-EOF-filtering, helper-executability, post-signal-probe-classification, phase-b-batch-sizing, hey-request-snapping, request-conservation, request-conservation-fairness, launch_hey_jobs-barrier-timing, monotonic-clock, and progress-bar assertions passed"
        return 0
    fi
    echo "self-test: $failures assertion(s) failed" >&2
    return 1
}

# spawn_hey_paused OUTFILE GATE_FILE RELEASE_SLEEP -- HEY_ARGS...
#
# Forks a single `hey` invocation as a background subshell that blocks
# until GATE_FILE exists before it execs `hey HEY_ARGS...`, writing
# combined stdout/stderr to OUTFILE; sets no state of its own, the caller
# reads $! for the subshell's pid (status/wait handling is the caller's
# job). This is the one place that actually forks `hey`, used by every
# hey launch site in this script (legacy benchmark-on-demand/
# benchmark-prewarmed, launch_hey_jobs's per-wave batches, and the
# orchestrator-contract drain test's phase B) so a `hey` process is
# always pre-spawned *paused* and only starts sending requests once its
# gate file is created by the caller, rather than requests starting as a
# side effect of whatever order/speed forking happened to occur in. When
# RELEASE_SLEEP is non-zero (a fractional-seconds string, e.g. "0.050"),
# it is slept after the gate opens and before `hey` starts, letting a
# caller stagger several jobs that share one gate file.
spawn_hey_paused() {
    local outfile="$1" gate_file="$2" release_sleep="$3"
    shift 3
    (
        while [[ ! -e "$gate_file" ]]; do sleep 0.005; done
        [[ "$release_sleep" != 0 ]] && sleep "$release_sleep"
        exec hey "$@"
    ) >"$outfile" 2>&1 &
}

# launch_hey_jobs REQS_ARR CONC_ARR URL_ARR HOST_ARR TIMEOUT_ARR OUTFILE_ARR
#                 STATUS_ARRNAME [LOG_FILE] [ACTIVE_SECONDS_VARNAME]
#                 [WALL_SECONDS_VARNAME]
#
# Runs one `hey` invocation per index across the given parallel arrays, at
# most $hey_max_parallel_jobs concurrently (bounding heavy client
# processes in flight at any instant regardless of how many apps/indices
# there are), recording each job's exit status (0 = success) into
# STATUS_ARRNAME. A zero request count is treated as a trivial success
# (no `hey` invocation, empty output file): used by the
# orchestrator-contract benchmark's degenerate small-N per-app phase
# split. When the index count exceeds $hey_max_parallel_jobs, later
# indices only start once an earlier batch/wave has fully finished: each
# app's own hey-reported requests/sec reflects only its own wave, so
# summing every app's rate does not equal the true wall-clock aggregate
# throughput once more than one wave runs (see write_benchmark_summary's
# end_to_end_requests_per_sec/active_wave_requests_per_sec for the two
# honest aggregate numbers). IMPORTANT: the barrier below is scoped to
# ONE WAVE -- there is no single barrier spanning every app when more
# than one wave runs; only the jobs within a given wave are held and
# released together.
#
# Within one wave, every job is pre-spawned *paused*: each is forked as a
# subshell that blocks on a per-wave gate file before it execs `hey`, so
# the whole batch is already forked and ready before any of them starts
# sending requests. Once every job in the batch is forked, a timestamp is
# taken as THIS WAVE'S BARRIER-RELEASE INSTANT, immediately before the
# gate file is created, so forking cost itself is never counted as load.
# That timestamp is taken with `now_monotonic_seconds` (see its own
# docstring): on Linux/WSL this reads `/proc/uptime`, a true monotonic
# clock (time since boot, immune to wall-clock/NTP adjustments), at
# roughly 0.01s resolution; it falls back to the wall-clock `now_seconds`
# (`date +%s.%N`) ONLY when `/proc/uptime` is unreadable, which this
# function's self-test explicitly exercises/asserts. When $hey_ramp_ms is
# greater than 0, each job's release is additionally delayed by its
# position in the batch times that many milliseconds (job 0 starts
# immediately on release, job 1 after one ramp step, and so on),
# staggering actual request start without staggering (and thereby
# delaying) the forking itself; this adds roughly
# (batch_size - 1) * hey_ramp_ms to each wave's *active* wall-clock time
# (it happens after the barrier release, so it is correctly counted as
# load), which is folded into the reported phase timing like any other
# wave cost. When LOG_FILE is given, appends timestamped wave queue/
# release/finish and per-app hey start/finish (command, exit code, output
# path) entries to it.
#
# ACTIVE_SECONDS_VARNAME and WALL_SECONDS_VARNAME, if given, name caller
# variables that this function sets (via `printf -v`, not namerefs, since
# they are scalars) to two different honest timing numbers once every
# wave has finished:
#   - ACTIVE_SECONDS_VARNAME: the sum, across all waves, of each wave's
#     own (barrier-release -> that wave's last job finishing) duration.
#     Excludes every wave's pre-release forking/spawning cost AND excludes
#     the gaps between waves (post-signal teardown of one wave's gate
#     file, mktemp for the next, etc.) -- i.e. only time during which
#     `hey` processes were actually permitted to send requests. This is a
#     narrower "pure request-serving" number; it is what
#     aggregate.active_wave_requests_per_sec divides by, NOT what
#     "end to end" means in this codebase.
#   - WALL_SECONDS_VARNAME: (first wave's barrier-release instant -> last
#     wave's last job finishing), a single span covering every wave
#     including the inter-wave gaps, but still excluding the first wave's
#     own pre-release forking cost (since it starts at that wave's release
#     instant, identically to ACTIVE_SECONDS_VARNAME's first term). This
#     is the TRUE end-to-end span and is what
#     aggregate.end_to_end_requests_per_sec divides by: the number an
#     external observer watching the whole load phase actually
#     experiences, including every inter-wave gap. Equals
#     ACTIVE_SECONDS_VARNAME when hey_waves == 1.
#
# `_LHJ_TEST_PRE_RELEASE_SLEEP`, if set to a nonzero seconds value, sleeps
# for that long after a wave's jobs are all forked but before the barrier
# timestamp/release -- a self-test-only hook (see self_test's
# assert_barrier_timing) used to prove, deterministically and without a
# real demo process, that pre-release delay does not leak into
# ACTIVE_SECONDS_VARNAME/WALL_SECONDS_VARNAME. It is never set by any real
# caller and defaults to doing nothing.
launch_hey_jobs() {
    # Namerefs use a `_lhj_` prefix so they can never alias a caller-side
    # array of the same base name (bash namerefs otherwise self-reference
    # and fail with "circular name reference" when the caller's array
    # happens to share the parameter's name, e.g. `launch_hey_jobs reqs
    # concs ...`).
    local -n _lhj_reqs="$1" _lhj_concs="$2" _lhj_urls="$3" _lhj_hosts="$4"
    local -n _lhj_timeouts="$5" _lhj_outfiles="$6"
    local -n _lhj_statuses="$7"
    local _lhj_logfile="${8:-}"
    local _lhj_active_var="${9:-}" _lhj_wall_var="${10:-}"
    local max_parallel="$hey_max_parallel_jobs"
    local n="${#_lhj_reqs[@]}"
    _lhj_statuses=()
    local i=0
    local wave=0
    local total_active="0" first_release="" last_finish=""
    # Wall-clock start used only for the progress bar below (see
    # print_progress_bar's docstring): this is a long, otherwise-silent
    # phase in non-verbose mode (log_line above only writes to
    # _lhj_logfile, never stdout), so without this a multi-wave load
    # phase looks just as hung as the setup phase did before it gained
    # its own progress bar.
    local t_start="$(now_seconds)"
    # Count of hey jobs that have exited so far, across all waves; drives
    # the progress bar per-job (see below) instead of once per whole
    # wave. With the common single-wave case (hey_max_parallel_jobs
    # defaults to the app count), a once-per-wave update would print
    # nothing at all until every job in the only wave had finished --
    # indistinguishable from the setup phase looking hung before it
    # gained a progress bar.
    local completed=0
    # print_progress_bar's elapsed argument costs a handful of real
    # subprocess forks (now_seconds -> date, seconds_between -> awk, plus
    # the command-substitution subshells wrapping each), not pure bash:
    # calling it on every single job completion is fine at tens of jobs
    # but measurably expensive at thousands (confirmed: this inflated
    # wave_active_seconds enough to fail self-test's barrier-timing
    # assertions, and matches a live ~130ms/job overhead reported running
    # 2048 apps). Throttling to at most ~100 updates total regardless of
    # n keeps the bar responsive while bounding that cost; always still
    # updates every completion when n is small enough that step==1 (the
    # self-test's 1/2-app cases), matching prior exact output there.
    local progress_step=$(((n + 99) / 100))
    ((progress_step < 1)) && progress_step=1
    while ((i < n)); do
        wave=$((wave + 1))
        local -a batch_pids=() batch_indexes=()
        local batch_end=$((i + max_parallel))
        ((batch_end <= n)) || batch_end="$n"
        local gate_file
        gate_file="$(mktemp -u "${TMPDIR:-/tmp}/hyperlight-demo-hey-gate.XXXXXX")"
        rm -f "$gate_file" 2>/dev/null
        [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
            "hey wave $wave queue: apps $i-$((batch_end - 1)) of $n" \
            "${hey_ramp_ms:+ramp=${hey_ramp_ms}ms per job on release}"
        local wave_t0 wave_t1
        local launch_start
        launch_start="$(now_seconds)"
        local j
        for ((j = i; j < batch_end; j++)); do
            if ((_lhj_reqs[j] <= 0)); then
                _lhj_statuses[j]=0
                : >"${_lhj_outfiles[j]}"
                continue
            fi
            local -a host_args=()
            [[ -n "${_lhj_hosts[j]}" ]] && host_args=(-host "${_lhj_hosts[j]}")
            local release_sleep="0"
            if ((hey_ramp_ms > 0)); then
                local offset_ms=$(((j - i) * hey_ramp_ms))
                release_sleep="$(printf '%d.%03d' \
                    $((offset_ms / 1000)) $((offset_ms % 1000)))"
            fi
            [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
                "hey app #$j queued (paused): hey -n ${_lhj_reqs[j]} -c ${_lhj_concs[j]} -t ${_lhj_timeouts[j]} ${_lhj_hosts[j]:+-host ${_lhj_hosts[j]}} ${_lhj_urls[j]} ramp_offset=${release_sleep}s"
            spawn_hey_paused "${_lhj_outfiles[j]}" "$gate_file" "$release_sleep" \
                -n "${_lhj_reqs[j]}" -c "${_lhj_concs[j]}" -t "${_lhj_timeouts[j]}" \
                "${host_args[@]}" "${_lhj_urls[j]}"
            batch_pids+=("$!")
            batch_indexes+=("$j")
            if (((j - i + 1) % progress_step == 0 || j + 1 >= batch_end)); then
                print_progress_bar "$((j - i + 1))" "$((batch_end - i))" \
                    "startup: hey clients queued (wave $wave)" \
                    "$(printf '%.0f' "$(seconds_between "$launch_start" "$(now_seconds)")")"
            fi
        done
        # Zero-request apps above never get spawned/waited (skipped via
        # the `continue` above), so they would otherwise never be
        # counted towards the progress bar's total below, leaving it
        # permanently short of $n at the end of the last wave.
        completed=$((completed + (batch_end - i - ${#batch_pids[@]})))
        # Self-test-only hook: see this function's docstring. Sleeps
        # AFTER forking but BEFORE the barrier timestamp/release, proving
        # that slow spawning never leaks into the reported active/wall
        # timing. No real caller sets this.
        if [[ -n "${_LHJ_TEST_PRE_RELEASE_SLEEP:-}" && "${_LHJ_TEST_PRE_RELEASE_SLEEP}" != 0 ]]; then
            sleep "$_LHJ_TEST_PRE_RELEASE_SLEEP"
        fi
        # Barrier-release instant: captured immediately before the gate
        # file is created (the actual synchronized release), so every
        # job's own fork/setup cost above is excluded from the measured
        # wave duration -- only the time after every job in the wave was
        # simultaneously released to start sending requests counts as load.
        # Uses now_monotonic_seconds (see its docstring), not wall-clock
        # now_seconds, since this measures a short local interval, not an
        # absolute timestamp.
        wave_t0="$(now_monotonic_seconds)"
        [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
            "hey wave $wave release: ${#batch_pids[@]} jobs"
        : >"$gate_file"
        [[ -z "$first_release" ]] && first_release="$wave_t0"
        local k
        for ((k = 0; k < ${#batch_pids[@]}; k++)); do
            local pid="${batch_pids[k]}" idx="${batch_indexes[k]}"
            local status=0
            wait "$pid" || status=$?
            _lhj_statuses[idx]="$status"
            [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
                "hey app #$idx finished: exit=$status output=${_lhj_outfiles[idx]}"
            completed=$((completed + 1))
            if ((completed % progress_step == 0 || completed >= n)); then
                print_progress_bar "$completed" "$n" "load: hey apps completed" \
                    "$(printf '%.0f' "$(seconds_between "$t_start" "$(now_seconds)")")"
            fi
        done
        rm -f "$gate_file" 2>/dev/null
        wave_t1="$(now_monotonic_seconds)"
        last_finish="$wave_t1"
        total_active="$(awk -v a="$total_active" -v s="$wave_t0" -v e="$wave_t1" \
            'BEGIN { printf "%.6f", a + (e - s) }')"
        [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
            "hey wave $wave finish: elapsed=$(seconds_between "$wave_t0" "$wave_t1")s" \
            "(barrier-release to wave-finish; excludes this wave's own pre-release forking cost)"
        i="$batch_end"
    done
    [[ -n "$_lhj_active_var" ]] && printf -v "$_lhj_active_var" '%s' "$total_active"
    if [[ -n "$_lhj_wall_var" ]]; then
        if [[ -n "$first_release" ]]; then
            printf -v "$_lhj_wall_var" '%s' "$(seconds_between "$first_release" "$last_finish")"
        else
            printf -v "$_lhj_wall_var" '%s' "0"
        fi
    fi
}

# launch_vegeta_load REQS_ARR CONC_ARR URL_ARR HOST_ARR TIMEOUT_ARR OUTFILE_ARR
#                     STATUS_ARRNAME LOG_FILE WORK_DIR TOTAL_CONCURRENCY
#                     [ACTIVE_SECONDS_VARNAME] [WALL_SECONDS_VARNAME]
#
# Single-process alternative to launch_hey_jobs for `--benchmark-load-driver
# vegeta`: instead of forking one `hey` client process per app (the "2048
# hey processes" cost this flag exists to avoid), builds ONE shared vegeta
# target list covering every index's own REQS_ARR[i] requests -- an exact,
# finite, line-for-line target file, not a `-rate`/`-duration` approximation
# -- then runs exactly one `vegeta attack` against the whole list with
# TOTAL_CONCURRENCY workers and no artificial rate cap (`-rate=0`), relying
# on the attack finishing once the finite target list is exhausted
# (`-lazy -duration=0`) rather than on a wall-clock duration. This still
# guarantees each index's exact REQS_ARR[i] count, the same guarantee
# hey's own `-n` flag gives, just reconstructed from one process instead
# of N. Requests from every index are interleaved round-robin across the
# target file (not grouped index-by-index) so no single app's share is
# front- or back-loaded in time relative to the others.
#
# vegeta has no concept of "one app" -- it is one shared attack against a
# combined target list -- so there is no native per-index breakdown.
# Instead, `vegeta encode -to=json` is grouped by `.url` (unique per index,
# since each app binds its own loopback port) via one jq invocation
# covering every index at once (no per-index subprocess fork, matching
# this script's standing avoid-O(n)-forks discipline at thousands-of-apps
# scale), and the result is used to SYNTHESIZE one hey-report-shaped text
# file per index into OUTFILE_ARR[i] (matching the exact
# "Summary: Total:/Average:/Requests/sec:" + "Status code distribution:
# [200] N responses" text build_app_summary already parses) so every
# existing downstream consumer -- build_app_summary, the "[200] N
# responses" exact-count assertions, write_collected_hey_report -- keeps
# working completely unchanged regardless of which driver produced it.
# Every synthesized report's Total:/Requests/sec: fields use the ONE
# shared attack's overall duration (there is no independent per-app timer
# under this driver, unlike hey's per-process wave model), which is also
# what ACTIVE_SECONDS_VARNAME/WALL_SECONDS_VARNAME are both set to (equal
# to each other, since there is only one "wave" here).
#
# STATUS_ARRNAME[i] is 0 for every index unless the single vegeta attack
# process itself exits nonzero, in which case every index is marked
# failed together (there is no per-index process boundary to isolate a
# single app's failure from another's).
filter_vegeta_request_results() {
    jq -c 'select((.error == "no targets to attack" and
        .url == "" and .method == "" and .code == 0) | not)
        | del(.body, .headers)'
}

decode_vegeta_request_results() {
    vegeta encode -to=json "$1" | filter_vegeta_request_results
}

launch_vegeta_load() {
    local -n _lvl_reqs="$1" _lvl_concs="$2" _lvl_urls="$3" _lvl_hosts="$4"
    local -n _lvl_timeouts="$5" _lvl_outfiles="$6" _lvl_statuses="$7"
    local _lvl_logfile="$8" _lvl_workdir="$9" _lvl_total_conc="${10}"
    local _lvl_active_var="${11:-}" _lvl_wall_var="${12:-}"
    local n="${#_lvl_urls[@]}"
    _lvl_statuses=()

    local apps_list_file="$_lvl_workdir/vegeta-apps.jsonl"
    local targets_file="$_lvl_workdir/vegeta-targets.txt"
    local results_bin="$_lvl_workdir/vegeta-results.bin"
    local report_json="$_lvl_workdir/vegeta-report.json"
    local records_json="$_lvl_workdir/vegeta-records.jsonl"
    local per_app_stats_tsv="$_lvl_workdir/vegeta-per-app-stats.tsv"
    phase_message "load preparation: generating Vegeta targets for $n apps"

    # Built with plain `printf` (a bash builtin, no fork) rather than `jq
    # -R`/`jq -n` per index: safe because url/host are both entirely
    # constructed by this script itself (http://127.0.0.1:$port/sync and a
    # fixed hostname), never user/network-controlled, so they are
    # guaranteed free of characters that would need JSON string escaping.
    : >"$apps_list_file"
    local i total_requests=0
    for ((i = 0; i < n; i++)); do
        printf '{"idx":%d,"url":"%s","host":"%s","reqs":%d,"concurrency":%d}\n' \
            "$i" "${_lvl_urls[i]}" "${_lvl_hosts[i]}" "${_lvl_reqs[i]}" "${_lvl_concs[i]}" >>"$apps_list_file"
        total_requests=$((total_requests + _lvl_reqs[i]))
    done

    # One awk pass emits the whole finite target list: for each
    # round-robin slot r (0..max(reqs)-1), every app whose own request
    # count is still > r contributes exactly one target block this slot,
    # interleaving every app's requests fairly instead of running them
    # one app at a time. Fields are pulled straight out of each whole
    # line with sub()/substr() (never field-split on `:`/`,`): the url
    # itself contains both (http://127.0.0.1:PORT/sync), so splitting on
    # those characters would corrupt it.
    awk '
        {
            url = $0; sub(/^.*"url":"/, "", url); sub(/".*$/, "", url)
            host = $0; sub(/^.*"host":"/, "", host); sub(/".*$/, "", host)
            reqs = $0; sub(/^.*"reqs":/, "", reqs); sub(/[,}].*$/, "", reqs)
            n++; urls[n] = url; hosts[n] = host; reqs_arr[n] = reqs + 0
            if (reqs + 0 > maxreqs) maxreqs = reqs + 0
        }
        END {
            for (r = 0; r < maxreqs; r++)
                for (i = 1; i <= n; i++)
                    if (r < reqs_arr[i]) {
                        print "GET " urls[i]
                        print "Host: " hosts[i]
                        print ""
                    }
        }
    ' "$apps_list_file" >"$targets_file"

    [[ -n "$_lvl_logfile" ]] && log_line "$_lvl_logfile" \
        "vegeta load start: $n app(s), $total_requests total requests," \
        "concurrency=$_lvl_total_conc targets=$targets_file"

    local t0 t1 attack_status=0
    t0="$(now_monotonic_seconds)"
    if ((total_requests > 0)); then
        phase_message "load: starting one shared Vegeta client ($_lvl_total_conc workers, $n targets, $total_requests requests)"
        run_with_progress "Vegeta HTTP load" vegeta attack -targets="$targets_file" -lazy -duration=0 -rate=0 \
            -workers="$_lvl_total_conc" -max-workers="$_lvl_total_conc" -timeout=30s \
            >"$results_bin" 2>"$_lvl_workdir/vegeta-attack.stderr" || attack_status=$?
    else
        : >"$results_bin"
    fi
    t1="$(now_monotonic_seconds)"
    local elapsed
    elapsed="$(seconds_between "$t0" "$t1")"
    [[ -n "$_lvl_active_var" ]] && printf -v "$_lvl_active_var" '%s' "$elapsed"
    [[ -n "$_lvl_wall_var" ]] && printf -v "$_lvl_wall_var" '%s' "$elapsed"

    [[ -n "$_lvl_logfile" ]] && log_line "$_lvl_logfile" \
        "vegeta load finished: exit=$attack_status elapsed=${elapsed}s"

    if ((attack_status != 0)); then
        [[ -n "$_lvl_logfile" ]] && log_line "$_lvl_logfile" \
            "FAILURE: vegeta attack exited $attack_status;" \
            "see $_lvl_workdir/vegeta-attack.stderr"
        for ((i = 0; i < n; i++)); do
            _lvl_statuses[i]="$attack_status"
            : >"${_lvl_outfiles[i]}"
        done
        rm -f "$apps_list_file" "$targets_file"
        return
    fi

    if ((total_requests > 0)); then
        phase_message "load finished (${elapsed}s): decoding Vegeta results and generating native reports"
        # Lazy target exhaustion produces a synthetic result, not an HTTP
        # request. Keep real request errors, excluding only this EOF marker.
        run_with_progress "Vegeta result decoding" decode_vegeta_request_results "$results_bin" >"$records_json"
        run_with_progress "Vegeta JSON report" vegeta report -type=json "$records_json" >"$report_json"
        run_with_progress "Vegeta text report" vegeta report "$records_json" >"$_lvl_workdir/vegeta.txt"
        if ! jq -e --argjson expected "$total_requests" '.requests == $expected' "$report_json" >/dev/null; then
            printf 'FAILURE: Vegeta reported %s requests; expected %s (see %s)\n' \
                "$(jq -r '.requests' "$report_json")" "$total_requests" "$report_json" >&2
            return 1
        fi
    else
        : >"$records_json"
        printf '{"duration":0}' >"$report_json"
    fi
    local overall_duration_s
    overall_duration_s="$(jq -r '((.duration // 0) + (.wait // 0)) / 1000000000' "$report_json")"

    # One jq invocation covering every app at once: groups every observed
    # request record by its URL (unique per app), joins against the
    # apps list built above, and emits one TSV line per app --
    # idx/successes/mean_latency_s/rps -- so the loop below can write
    # every synthesized report with pure bash builtins (no per-app jq
    # fork) even at thousands of apps.
    phase_message "report processing: grouping Vegeta records across $n apps"
    # shellcheck disable=SC2016 # These variables belong to jq, not bash.
    run_with_progress "Vegeta per-app grouping" jq -n -r \
        --argjson duration_s "$overall_duration_s" \
        --slurpfile apps_arr "$apps_list_file" \
        --slurpfile records "$records_json" '
        ($records | group_by(.url) | map({
            key: .[0].url,
            value: {
                successes: (map(select(.code == 200)) | length),
                mean_latency_s: ((map(.latency) | add) / length / 1000000000)
            }
        }) | from_entries) as $by_url |
        $apps_arr[] |
        . as $app |
        ($by_url[$app.url] // {successes: 0, mean_latency_s: 0}) as $g |
        {
            app_id: ("bench-" + ($app.idx | tostring)),
            requests: $app.reqs, concurrency: $app.concurrency,
            successful_responses: $g.successes,
            average_latency_ms: ($g.mean_latency_s * 1000),
            hey_total_seconds: $duration_s,
            requests_per_sec: (if $duration_s > 0 then ($g.successes / $duration_s) else 0 end)
        } | tojson
    ' >"$per_app_stats_tsv"
    mv "$per_app_stats_tsv" "$_lvl_workdir/vegeta-app-summaries.jsonl"
    jq -r '[(.app_id | ltrimstr("bench-")), .successful_responses,
        (.average_latency_ms / 1000), .requests_per_sec] | @tsv' \
        "$_lvl_workdir/vegeta-app-summaries.jsonl" >"$per_app_stats_tsv"

    local idx successes mean_latency_s rps
    while IFS=$'\t' read -r idx successes mean_latency_s rps; do
        _lvl_statuses[idx]=0
        ((successes == _lvl_reqs[idx])) || _lvl_statuses[idx]=1
        {
            printf '\nSummary:\n'
            printf '  Total:        %s secs\n' "$overall_duration_s"
            printf '  Average:      %s secs\n' "$mean_latency_s"
            printf '  Requests/sec: %s\n' "$rps"
            printf '\nStatus code distribution:\n'
            printf '  [200]  %s responses\n' "$successes"
        } >"${_lvl_outfiles[idx]}"
    done <"$per_app_stats_tsv"

    rm -f "$apps_list_file" "$targets_file" "$results_bin" "$records_json" "$per_app_stats_tsv"
    phase_message "Vegeta reports ready; collecting resident host status"
}

# write_collected_hey_report OUTPUT APP_IDS_ARRNAME ADDR_ARRNAME CMD_ARRNAME
#                            HEY_FILE_ARRNAME
#
# Concatenates each app's independent raw `hey` report into one top-level
# file for quick human review, with a clear per-app separator naming the
# app, its address, and the exact `hey` command used. This is a collected
# raw report, not a combined statistical distribution: parallel
# independent `hey` runs cannot be merged into one set of
# percentiles/latency histogram, and this file does not attempt that --
# see summary.json for the computed aggregate (sum of throughput,
# weighted mean latency).
write_collected_hey_report() {
    local output="$1"
    local -n _wchr_ids="$2" _wchr_addrs="$3" _wchr_cmds="$4" _wchr_files="$5"
    local load_driver="${6:-hey}"
    {
        if [[ "$load_driver" == vegeta ]]; then
            echo "# Vegeta-derived per-app reports in hey-compatible format."
            echo "# One shared vegeta attack; native aggregate: vegeta-report.json."
        else
            echo "# Collected raw hey reports: one independent hey run per app below."
        fi
        echo "# NOT a combined statistical distribution -- see summary.json for"
        echo "# the computed aggregate (sum of throughput, weighted mean latency)."
        local i n="${#_wchr_ids[@]}"
        for ((i = 0; i < n; i++)); do
            echo
            echo "==== app: ${_wchr_ids[i]} ===================================="
            echo "address: ${_wchr_addrs[i]}"
            echo "command: ${_wchr_cmds[i]}"
            echo
            local report_line
            while IFS= read -r report_line || [[ -n "$report_line" ]]; do
                printf '%s\n' "$report_line"
            done <"${_wchr_files[i]}"
        done
    } >"$output"
}

# build_app_summary APP_ID REQUESTS CONCURRENCY HEY_OUTPUT_FILE
#
# Parses one `hey` text report into a per-app JSON summary object, using
# the requests/concurrency the caller already configured rather than
# re-deriving them from the report. Also extracts hey's own self-measured
# `Total:` duration and its actual (not configured/requested) count of
# [200] responses from the "Status code distribution" section: these let
# write_benchmark_summary compute an aggregate throughput number derived
# purely from hey's own per-process output (real observed successes over
# the slowest app's own observed duration), independent of this script's
# own wall-clock barrier instrumentation (wave_active_seconds/
# load_wall_seconds) -- a cross-check against, not a replacement for,
# those orchestrator-measured numbers. Missing fields (e.g. a skipped
# zero-request job) default to 0.
build_app_summary() {
    local app_id="$1" requests="$2" concurrency="$3" hey_file="$4"
    local rps avg_s total_s successes
    rps="$(grep -m1 'Requests/sec:' "$hey_file" | awk '{print $2}')"
    avg_s="$(grep -m1 '  Average:' "$hey_file" | awk '{print $2}')"
    total_s="$(grep -m1 '  Total:' "$hey_file" | awk '{print $2}')"
    successes="$(grep -oE '\[200\][[:space:]]+[0-9]+' "$hey_file" | grep -oE '[0-9]+$')"
    jq -n \
        --arg app_id "$app_id" \
        --argjson requests "$requests" \
        --argjson concurrency "$concurrency" \
        --argjson rps "${rps:-0}" \
        --argjson avg_s "${avg_s:-0}" \
        --argjson total_s "${total_s:-0}" \
        --argjson successes "${successes:-0}" \
        '{
            app_id: $app_id,
            requests: $requests,
            concurrency: $concurrency,
            requests_per_sec: $rps,
            average_latency_ms: ($avg_s * 1000),
            hey_total_seconds: $total_s,
            successful_responses: $successes
        }'
}

# now_seconds -> current wall-clock time, sub-second precision.
now_seconds() { date +%s.%N; }

# now_monotonic_seconds -> best-available monotonic time in seconds for
# measuring short local intervals (e.g. barrier-release-to-finish spans
# in launch_hey_jobs), immune to wall-clock adjustments (NTP steps,
# manual clock changes) that would otherwise corrupt an interval
# computed from two now_seconds() wall-clock reads. On Linux (including
# WSL, which is what every live validation in this repo runs under),
# reads the kernel's own monotonic "seconds since boot" counter from
# /proc/uptime's first field -- true CLOCK_MONOTONIC semantics, at
# /proc/uptime's roughly 0.01s resolution (coarser than now_seconds's
# nanosecond text but a real monotonic source, not an approximation of
# one). Falls back to the wall-clock now_seconds ONLY when /proc/uptime
# is unreadable (non-Linux); self_test's assert_barrier_timing exercises
# both the /proc/uptime path (when available) and asserts the function
# never goes backwards across two successive reads, so a real regression
# to a non-monotonic source would be caught.
now_monotonic_seconds() {
    if [[ -r /proc/uptime ]]; then
        local uptime_seconds
        read -r uptime_seconds _ </proc/uptime
        printf '%s' "$uptime_seconds"
    else
        now_seconds
    fi
}

# seconds_between START END -> (END - START) with 3 decimal places.
seconds_between() {
    awk -v start="$1" -v end="$2" 'BEGIN { printf "%.3f", end - start }'
}

# log_line LOGFILE MESSAGE...
#
# Appends one timestamped line to LOGFILE (created if missing). This is
# the orchestration-level log (phases, per-app launch/ready/hey/shutdown
# events, failures with the referenced per-app server log path) -- not a
# replacement for each app's own server.log, which keeps the raw workerd-
# host stdout/stderr untouched. Only written to the file: callers that
# also want the line on the terminal (e.g. a failure) should echo/printf
# it themselves in addition to calling this.
#
# Uses bash's own `printf '%(FORMAT)T'` time-formatting builtin (bash
# 4.2+; this script already requires 4.3+ for namerefs) instead of
# shelling out to `date`: this function is called at least twice per app
# in launch_hey_jobs's hot path (queued + finished), so at hundreds/
# thousands of apps a per-call `date` fork is not free -- measured at
# ~4.4ms/call via external `date` vs ~0.06ms/call via this builtin (a
# ~75x difference), i.e. real, attributable seconds of the gap between
# timing.load_seconds (whole-phase wall clock, includes this logging
# overhead) and timing.wave_active_seconds (pure barrier-release-to-
# finish request-serving time only, see launch_hey_jobs/
# make_phase_timing's docstrings) at the scale this script targets.
log_line() {
    local logfile="$1"
    shift
    printf '[%(%Y-%m-%dT%H:%M:%S%z)T] %s\n' -1 "$*" >>"$logfile"
}

phase_message() {
    finish_progress
    printf '%s\n' "$*"
    # shellcheck disable=SC2031 # The self-test override is intentionally subshell-local.
    if [[ ! -t 1 && -z "${_LHJ_TEST_NO_TTY_ESCAPE:-}" ]] &&
        { exec 3>/dev/tty; } 2>/dev/null; then
        printf '%s\n' "$*" >&3
        exec 3>&-
    fi
}

finish_progress() {
    [[ "${_progress_line_active:-false}" == true ]] || return 0
    local out_fd=1
    # shellcheck disable=SC2031 # The self-test override is intentionally subshell-local.
    if [[ -z "${_LHJ_TEST_NO_TTY_ESCAPE:-}" ]] &&
        { exec 3>/dev/tty; } 2>/dev/null; then
        out_fd=3
    fi
    [[ ! -t "$out_fd" ]] || printf '\n' >&"$out_fd"
    _progress_line_active=false
    if ((out_fd == 3)); then exec 3>&-; fi
}

render_progress_line() {
    local out_fd="$1" text="$2" complete="$3"
    local columns terminal_size terminal_fd
    exec {terminal_fd}<&"$out_fd"
    terminal_size="$(stty size <&"$terminal_fd" 2>/dev/null)" || terminal_size=""
    exec {terminal_fd}<&-
    columns="${terminal_size##* }"
    [[ "$columns" =~ ^[1-9][0-9]*$ ]] || columns="${COLUMNS:-80}"
    [[ "$columns" =~ ^[1-9][0-9]*$ ]] || columns=80
    # Leave the last column unused to prevent terminal auto-wrap.
    printf '\r\033[2K%s' "${text:0:columns-1}" >&"$out_fd"
    _progress_line_active=true
    if [[ "$complete" == true ]]; then
        printf '\n' >&"$out_fd"
        _progress_line_active=false
    fi
}

run_with_progress() {
    local label="$1"
    shift
    local started="$SECONDS" last_update="$SECONDS" pid status=0 tracked_index
    "$@" &
    pid=$!
    tracked_index="${#extra_pids[@]}"
    extra_pids+=("$pid")
    while kill -0 "$pid" 2>/dev/null; do
        sleep 0.1
        if ((SECONDS - last_update >= 5)); then
            phase_message "$label: still working ($((SECONDS - started))s)" >&2
            last_update="$SECONDS"
        fi
    done
    wait "$pid" || status=$?
    unset "extra_pids[$tracked_index]"
    if ((status != 0)); then
        phase_message "$label failed (exit $status, $((SECONDS - started))s)" >&2
        return "$status"
    fi
    phase_message "$label complete ($((SECONDS - started))s)" >&2
}

# print_progress_bar CURRENT TOTAL LABEL ELAPSED_SECONDS
#
# Renders CURRENT/TOTAL progress so a long blocking setup loop (e.g.
# benchmark-resident sequentially booting hundreds/thousands of resident
# apps -- see run_benchmark_resident) is visibly advancing, not hung,
# even though log_line only writes to run.log. run_one's non-verbose
# mode (the default) redirects the whole demo subshell's stdout+stderr
# into that same run.log, so writing this to fd 1 alone would make the
# bar invisible on a live terminal in the common case -- defeating this
# function's entire purpose. To escape that redirection, this writes
# straight to the controlling terminal (/dev/tty) when one exists,
# falling back to fd 1 (the log, in non-verbose mode; the terminal
# itself in --verbose/an interactive self-test) when there is none (a
# detached/nohup/cron/CI run with no controlling tty -- the common case
# the self-test's `$(...)` capture also relies on, since command
# substitution always makes fd 1 a pipe regardless of /dev/tty).
# _LHJ_TEST_NO_TTY_ESCAPE lets the self-test force the fd-1 fallback
# deterministically even when it happens to run in a real terminal.
# Chooses between an in-place "[####------] 12/50 (24%, 3s)" \r bar (a
# real terminal) and one plain line every ~1/40th of TOTAL steps, always
# including the first and last step (no terminal, where a \r bar would
# just look like line noise), based on whether the chosen destination is
# itself a terminal.
print_progress_bar() {
    local current="$1" total="$2" label="$3" elapsed="$4"
    ((total > 0)) || total=1
    local pct=$((current * 100 / total))
    local out_fd=1
    if [[ -z "${_LHJ_TEST_NO_TTY_ESCAPE:-}" ]] && { exec 3>/dev/tty; } 2>/dev/null; then
        out_fd=3
    fi
    if [[ -t "$out_fd" ]]; then
        local width=30
        local filled=$((current * width / total))
        ((filled > width)) && filled=$width
        local bar
        bar="$(printf '%*s' "$filled" '' | tr ' ' '#')$(printf '%*s' $((width - filled)) '')"
        local text complete=false
        printf -v text '  %s [%s] %d/%d (%d%%, %ds)' "$label" "$bar" "$current" "$total" "$pct" "$elapsed"
        ((current < total)) || complete=true
        render_progress_line "$out_fd" "$text" "$complete"
    else
        local step=$(((total + 39) / 40))
        ((step < 1)) && step=1
        if ((current == 1 || current % step == 0 || current >= total)); then
            printf '  %s: %d/%d (%d%%, %ds)\n' "$label" "$current" "$total" "$pct" "$elapsed" >&"$out_fd"
        fi
    fi
    if ((out_fd == 3)); then
        exec 3>&-
    fi
    return 0
}

# make_phase_timing SETUP_SECONDS LOAD_SECONDS TEARDOWN_SECONDS TOTAL_SECONDS
#                    WAVE_ACTIVE_SECONDS LOAD_WALL_SECONDS [RESULTS_SECONDS]
# -> prints the shared {setup_seconds, load_seconds, teardown_seconds,
#    total_seconds, wave_active_seconds, load_wall_seconds} JSON object
#    used by benchmark-resident/benchmark-multi-app's summary.json.
#    setup_seconds covers starting the workerd-host process(es) and
#    writing configs, up to (not including) the hey load; load_seconds is
#    the caller-measured wall-clock span around the entire
#    launch_hey_jobs call (includes the first wave's pre-release forking
#    cost, since the caller's clock starts before calling in); teardown_
#    seconds covers process shutdown when RESULTS_SECONDS is supplied;
#    otherwise it includes post-load status collection for compatibility.
#    total_seconds is the full run_benchmark_* function duration (may
#    exceed the sum of the other three by a small amount spent on
#    bookkeeping between phases).
#
# WAVE_ACTIVE_SECONDS and LOAD_WALL_SECONDS are launch_hey_jobs's own
# barrier-anchored measurements (see its docstring for the exact
# boundaries): WAVE_ACTIVE_SECONDS sums every wave's (barrier-release ->
# wave-finish) span, excluding all pre-release forking cost and every
# inter-wave gap -- this is pure request-serving time, and is what
# aggregate.active_wave_requests_per_sec divides by. LOAD_WALL_SECONDS
# spans (first wave's barrier-release -> last wave's finish), including
# inter-wave gaps but still excluding the first wave's own pre-release
# forking cost -- the number an external observer watching the whole
# multi-wave load phase actually sees, and what
# aggregate.end_to_end_requests_per_sec divides by. Both are 0/null when
# the caller has nothing to report (e.g. orchestrator-contract passes
# `null` for the whole TIMING_JSON).
make_phase_timing() {
    jq -n \
        --argjson setup_seconds "$1" \
        --argjson load_seconds "$2" \
        --argjson teardown_seconds "$3" \
        --argjson total_seconds "$4" \
        --argjson wave_active_seconds "${5:-0}" \
        --argjson load_wall_seconds "${6:-0}" \
        --argjson results_seconds "${7:-null}" \
        '{setup_seconds: $setup_seconds, load_seconds: $load_seconds, teardown_seconds: $teardown_seconds, total_seconds: $total_seconds, wave_active_seconds: $wave_active_seconds, load_wall_seconds: $load_wall_seconds}
        + (if $results_seconds != null then {results_seconds: $results_seconds} else {} end)'
}

# write_benchmark_summary SCENARIO PER_APP_ARRAY_JSON TIMING_JSON MAX_PARALLEL
#                         OUTPUT_PATH [LOAD_DRIVER]
#
# LOAD_DRIVER (default "hey") is recorded verbatim as aggregate.load_driver
# so a summary.json alone says which load generator produced it --
# relevant because the vegeta driver (see launch_vegeta_load) runs every
# app's load as ONE shared process/timeline instead of hey's per-app/
# per-wave model, so max_parallel_hey_jobs/hey_waves/barrier_scope are
# always null for a vegeta-driven run (the caller passes MAX_PARALLEL=0
# in that case) even though hey_self_measured_requests_per_sec and the
# other aggregate numbers remain meaningful for either driver.
#
# Builds the common {scenario, apps, timing, aggregate} shape shared by
# all three new benchmarks' summary.json.
#
# aggregate.sum_of_app_requests_per_sec sums each app's independently
# measured requests/sec from its own hey run: a reasonable approximation
# ONLY while every app's hey process actually ran concurrently. Once the
# app count exceeds MAX_PARALLEL, launch_hey_jobs runs later apps in
# sequential waves (see its docstring), so this sum silently keeps adding
# up rates from waves that did not overlap in wall-clock time and
# overstates true throughput by roughly the wave count.
#
# Two different, deliberately separately-named honest aggregate rates are
# reported instead of one ambiguous number (see launch_hey_jobs/
# make_phase_timing for the exact boundaries each is measured between).
# IMPORTANT: the barrier itself is scoped to ONE WAVE -- when hey_waves >
# 1 (apps exceed MAX_PARALLEL), there is no single barrier spanning every
# app; only the jobs within each wave are released together. Neither rate
# below implies all apps launched simultaneously unless hey_waves == 1
# (see aggregate.barrier_scope/hey_waves).
#
# aggregate.end_to_end_requests_per_sec divides total_requests by
# timing.load_wall_seconds -- (first wave's barrier-release -> last
# wave's finish). This is the true "end to end" number: it still excludes
# only the first wave's pre-release forking cost, but DOES include every
# inter-wave gap, matching what an external observer watching the whole
# load phase actually experiences. This is the number to report/compare
# as "the" throughput of a run.
#
# aggregate.active_wave_requests_per_sec divides total_requests by
# timing.wave_active_seconds -- the sum, across every wave, of
# (barrier-release -> that wave's finish). This excludes ALL per-wave
# forking/spawn cost AND every inter-wave gap, so it measures only the
# time `hey` processes were actually permitted to send requests: a
# narrower "pure request-serving" number, useful for isolating load
# generation cost from inter-wave orchestration overhead, but NOT the
# number to call "end to end" since it hides inter-wave gaps. Equals
# end_to_end_requests_per_sec when hey_waves == 1.
#
# Both are null when TIMING_JSON/MAX_PARALLEL are not supplied
# (orchestrator-contract's phase summaries do not currently measure
# this).
#
# aggregate.hey_self_measured_requests_per_sec is a THIRD, independent
# cross-check computed ENTIRELY from each app's own hey process output --
# no orchestrator wall-clock timestamps involved at all. It divides
# actual_successful_responses (the sum, across apps, of each app's own
# "Status code distribution: [200] N responses" count -- requests hey
# itself confirmed it received a 200 for, not the configured/requested
# count) by max_app_hey_total_seconds (the largest of each app's own
# self-reported "Summary: Total: X secs" duration -- the straggler app's
# own measured wall-clock span). Since every app in a wave is released
# from the same barrier at effectively the same instant, this should
# closely track active_wave_requests_per_sec/end_to_end_requests_per_sec;
# a large divergence between this and those orchestrator-measured numbers
# is a signal worth investigating (e.g. clock skew, barrier-release
# jitter, or a bug in the wall-clock instrumentation), whereas small
# differences are expected since hey's own clock and this script's
# monotonic-clock reads are independent measurements of almost (but not
# exactly) the same span. Both new aggregate fields are 0/null when no
# app reported any successful response.
write_benchmark_summary() {
    local scenario="$1" per_app_json="$2" timing_json="${3:-null}"
    local max_parallel="${4:-0}" output="$5" load_driver="${6:-hey}"
    # per_app_json scales with app count (one object per app): at
    # thousands of apps it can be several MB, which blows past the
    # kernel's execve() ARG_MAX if passed as a --argjson command-line
    # argument -- bash's own "Argument list too long", not a jq error,
    # since ARG_MAX bounds total argv+envp bytes regardless of whether
    # the oversized value is logically "one argument". Routing it
    # through a temp file + --slurpfile instead has no such limit, since
    # jq reads the file's bytes directly rather than via argv.
    local apps_tmpfile
    apps_tmpfile="$(mktemp "${TMPDIR:-/tmp}/hyperlight-demo-apps.XXXXXX")"
    printf '%s' "$per_app_json" >"$apps_tmpfile"
    jq -n \
        --arg scenario "$scenario" \
        --arg load_driver "$load_driver" \
        --slurpfile apps_file "$apps_tmpfile" \
        --argjson timing "$timing_json" \
        --argjson max_parallel "$max_parallel" '
        ($apps_file[0]) as $apps |
        ($apps | map(.requests) | add) as $total_requests |
        ($apps | map(.successful_responses // 0) | add) as $actual_successes |
        ($apps | map(.hey_total_seconds // 0) | max) as $max_hey_total_seconds |
        {
            scenario: $scenario,
            apps: $apps,
            timing: $timing,
            aggregate: {
                load_driver: $load_driver,
                total_requests: $total_requests,
                sum_of_app_requests_per_sec: ($apps | map(.requests_per_sec) | add),
                end_to_end_requests_per_sec: (
                    if ($timing | type) == "object" and (($timing.load_wall_seconds // 0) > 0) then
                        ($total_requests / $timing.load_wall_seconds)
                    else null end
                ),
                active_wave_requests_per_sec: (
                    if ($timing | type) == "object" and (($timing.wave_active_seconds // 0) > 0) then
                        ($total_requests / $timing.wave_active_seconds)
                    else null end
                ),
                hey_self_measured_requests_per_sec: (
                    if $max_hey_total_seconds > 0 then ($actual_successes / $max_hey_total_seconds)
                    else null end
                ),
                actual_successful_responses: $actual_successes,
                max_app_hey_total_seconds: (if $max_hey_total_seconds > 0 then $max_hey_total_seconds else null end),
                weighted_mean_latency_ms: (
                    ($apps | map(.average_latency_ms * .requests) | add) /
                    (if $total_requests > 0 then $total_requests else 1 end)
                ),
                max_parallel_hey_jobs: (if $max_parallel > 0 then $max_parallel else null end),
                hey_waves: (
                    if $max_parallel > 0 then
                        ((($apps | length) + $max_parallel - 1) / $max_parallel | floor)
                    else null end
                ),
                barrier_scope: (if $max_parallel > 0 then "per_wave" else null end)
            }
        }' >"$output"
    rm -f "$apps_tmpfile"
}

# host_http_get BIND HOST_HEADER PATH -> prints "STATUS\tBODY"
host_http_get() {
    local bind="$1" host_header="$2" path="$3"
    local body status
    body="$(curl --silent --show-error --output - --write-out '\n%{http_code}' \
        --header "Host: $host_header" "http://$bind$path")"
    status="${body##*$'\n'}"
    printf '%s\t%s\n' "$status" "${body%$'\n'*}"
}

run_resident() {
    local dir="$output_dir/resident"
    mkdir -p "$dir"
    local pool
    pool="$(jq -n '{kind:"resident", capacity:1, queue_capacity:4, max_requests_per_vm:5, max_lifetime_secs:null}')"
    local apps
    apps="$(jq -n --argjson app "$(app_config resident resident.test \
        "$root/examples/workerd-bundles/acceptance.json" "$pool")" '[$app]')"
    write_host_config "$dir/config.json" "$apps"
    start_workerd_host "$dir/server.log" "$dir/config.json" 127.0.0.1:8180
    local n
    for n in $(seq 1 6); do
        host_http_get 127.0.0.1:8180 resident.test "/resident/$n" \
            >"$dir/request-$n.txt"
        [[ "$(cut -f1 "$dir/request-$n.txt")" == 200 ]]
    done
    curl --fail-with-body --silent --show-error \
        --header "Host: resident.test" \
        http://127.0.0.1:8180/__hyperlight/status \
        | tee "$dir/status.json" \
        | jq -e '.[0].resident_requests_served == 6 and .[0].retirements == 1' \
        >/dev/null
    stop_processes
    echo "Six requests hit one resident VM; the sixth crossed max_requests_per_vm and retired it."
}

run_multi_app() {
    local dir="$output_dir/multi-app"
    mkdir -p "$dir"
    local resident_pool disposable_pool apps
    resident_pool="$(jq -n '{kind:"resident", capacity:1, queue_capacity:4, max_requests_per_vm:null, max_lifetime_secs:null}')"
    disposable_pool="$(jq -n '{kind:"disposable", max_concurrent_sandboxes:4, queue_capacity:16}')"
    apps="$(jq -n \
        --argjson a "$(app_config app-a a.test \
            "$root/examples/workerd-bundles/acceptance.json" "$resident_pool")" \
        --argjson b "$(app_config app-b b.test \
            "$root/examples/workerd-bundles/acceptance.json" "$disposable_pool")" \
        '[$a, $b]')"
    write_host_config "$dir/config.json" "$apps"
    start_workerd_host "$dir/server.log" "$dir/config.json" 127.0.0.1:8181
    host_http_get 127.0.0.1:8181 a.test /hello >"$dir/app-a.txt"
    host_http_get 127.0.0.1:8181 b.test /hello >"$dir/app-b.txt"
    [[ "$(cut -f1 "$dir/app-a.txt")" == 200 ]]
    [[ "$(cut -f1 "$dir/app-b.txt")" == 200 ]]
    curl --fail-with-body --silent --show-error \
        --header "Host: a.test" \
        http://127.0.0.1:8181/__hyperlight/status \
        | tee "$dir/status.json" \
        | jq -e '
            (map(select(.app_id == "app-a"))[0].kind == "resident") and
            (map(select(.app_id == "app-b"))[0].kind == "disposable")
        ' >/dev/null
    stop_processes
    echo "Both apps were served correctly and independently from one process and port."
}

run_orchestrator_contract() {
    local dir="$output_dir/orchestrator-contract"
    mkdir -p "$dir"
