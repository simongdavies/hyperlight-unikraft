        --upstream-port 18080 \
        all
    stop_processes
}

wait_for_pool_quiescence() {
    local mode="$1"
    local status_file="$2"
    local attempt
    for attempt in $(seq 1 600); do
        curl --fail-with-body --silent --show-error \
            http://127.0.0.1:8787/__hyperlight/pool-status >"$status_file"
        if jq -e --arg mode "$mode" '
            .admitted == 0 and
            .active == 0 and
            .queued == 0 and
            .execution_slots_in_use == 0 and
            .restore_slots_in_use == 0 and
            .recycle_queue_depth == 0 and
            .teardown_in_flight == 0 and
            .completion_queue_depth == 0 and
            .completion_in_flight == 0 and
            (
                $mode == "on-demand" or
                (
                    .prewarmed_replenishing == 0 and
                    .restore_permits_outstanding == 0 and
                    .refill_active == false and
                    .prewarmed_ready == .prewarmed_inventory
                )
            )
        ' "$status_file" >/dev/null; then
            return 0
        fi
        sleep 0.1
    done
    echo "pool did not become quiescent; see $status_file" >&2
    return 1
}

run_benchmark() {
    local mode="$1"
    local dir="$output_dir/benchmark-$mode"
    local queue_capacity=256
    local ready_high_watermark="$benchmark_pool_vms"
    local ready_low_watermark
    ((benchmark_concurrency > queue_capacity)) &&
        queue_capacity="$benchmark_concurrency"
    ready_low_watermark=$((ready_high_watermark / 2))
    ((ready_low_watermark > 1)) || ready_low_watermark=2
    local args=(
        --bundle "$root/examples/workerd-bundles/workerd-pool-benchmark.json"
        --scratch-mb 384
        --request-timeout-ms 30000
        --restore-mode "$mode"
        --max-concurrent-sandboxes "$benchmark_vms"
        --queue-capacity "$queue_capacity"
        --profile-log-every 64
    )
    if [[ "$mode" == prewarmed ]]; then
        args+=(
            --prewarmed-sandboxes "$benchmark_pool_vms"
            --max-concurrent-restores 1
            --warm-floor 1
            --ready-low-watermark "$ready_low_watermark"
            --ready-high-watermark "$ready_high_watermark"
            --max-replenish-batch 2
        )
    fi
    mkdir -p "$dir"
    LC_ALL=C lscpu |
        grep -E '^(CPU\(s\)|Socket|Core|Thread)' >"$dir/lscpu.txt"
    start_server "$dir/server.log" "${args[@]}"
    # Routed through the same spawn_hey_paused pause/release primitive as
    # every other hey launch site (see launch_hey_jobs), even though a
    # single job has nothing to stagger against itself: this keeps the
    # mechanism identical everywhere rather than special-casing the
    # legacy single-process benchmarks. Output is dumped to the console
    # after it completes (see print_demo_evidence's HEY OUTPUT section
    # too) rather than streamed live, matching how benchmark-resident/
    # benchmark-multi-app/benchmark-orchestrator-contract already present
    # their hey output.
    local legacy_hey_gate
    legacy_hey_gate="$(mktemp -u "${TMPDIR:-/tmp}/hyperlight-demo-hey-gate.XXXXXX")"
    rm -f "$legacy_hey_gate" 2>/dev/null
    spawn_hey_paused "$dir/hey.txt" "$legacy_hey_gate" 0 \
        -n "$benchmark_requests" -c "$benchmark_concurrency" \
        http://127.0.0.1:8787/sync
    local legacy_hey_pid=$!
    : >"$legacy_hey_gate"
    wait "$legacy_hey_pid"
    rm -f "$legacy_hey_gate" 2>/dev/null
    cat "$dir/hey.txt"
    grep -Eq "\\[200\\][[:space:]]+${benchmark_requests} responses" "$dir/hey.txt"
    wait_for_pool_quiescence "$mode" "$dir/pool-status.json"
    jq '{
            restore_mode,
            admitted,
            active,
            queued,
            ready,
            warm_floor,
            ready_low_watermark,
            ready_high_watermark,
            execution_slots_in_use,
            restore_slots_in_use,
            recycle_queue_depth,
            teardown_in_flight,
            completion_queue_depth,
            completion_in_flight,
            replenishment_paused,
            replenishment_pause_reason,
            refill_active,
            prewarmed_inventory,
            prewarmed_ready,
            prewarmed_replenishing
        }' "$dir/pool-status.json"
    stop_processes
    printf 'Compare demo-output/benchmark-on-demand/hey.txt and '
    printf 'demo-output/benchmark-prewarmed/hey.txt on this same host.\n'
}

run_benchmark_resident() {
    local dir="$output_dir/benchmark-resident"
    mkdir -p "$dir"
    LC_ALL=C lscpu | grep -E '^(CPU\(s\)|Socket|Core|Thread)' >"$dir/lscpu.txt"
    local t_start t_setup_done t_load_done t_end
    t_start="$(now_seconds)"
    local run_log="$dir/run.log"
    : >"$run_log"
    log_line "$run_log" "benchmark-resident start: apps=$benchmark_apps" \
        "load_requests=$benchmark_load_requests concurrency=$benchmark_concurrency" \
        "hey_max_parallel_jobs=$hey_max_parallel_jobs hey_ramp_ms=$hey_ramp_ms max_requests_per_vm=unset(unbounded)" \
        "max_lifetime_secs=unset(unbounded)"

    local -a req_alloc conc_alloc
    allocate_evenly "$benchmark_load_requests" "$benchmark_apps" req_alloc
    allocate_evenly "$benchmark_concurrency" "$benchmark_apps" conc_alloc

    local -a reqs concs urls hosts timeouts outfiles statuses status_files
    local i
    for ((i = 0; i < benchmark_apps; i++)); do
        local app_dir="$dir/app-$i"
        mkdir -p "$app_dir"
        local port=$((8320 + i))
        local bind="127.0.0.1:$port"
        local conc=$((conc_alloc[i] < req_alloc[i] ? conc_alloc[i] : req_alloc[i]))
        ((conc > 0)) || conc=1
        local queue_capacity=64
        ((conc * 4 > queue_capacity)) && queue_capacity=$((conc * 4))
        local pool
        pool="$(jq -n --argjson capacity "$conc" --argjson qc "$queue_capacity" \
            '{kind:"resident", capacity:$capacity, queue_capacity:$qc, max_requests_per_vm:null, max_lifetime_secs:null}')"
        local apps_json
        apps_json="$(jq -n --argjson app "$(app_config "bench-$i" bench.resident.test \
            "$root/examples/workerd-bundles/workerd-pool-benchmark.json" "$pool")" '[$app]')"
        write_host_config "$app_dir/config.json" "$apps_json"
        log_line "$run_log" "app bench-$i config generated: pool=resident capacity=$conc" \
            "queue_capacity=$queue_capacity bind=$bind requests=${req_alloc[i]}"
        local app_t0 app_t1
        app_t0="$(now_seconds)"
        if ((i == 0)); then
            start_workerd_host "$app_dir/server.log" "$app_dir/config.json" "$bind"
        else
            start_workerd_host_extra "$app_dir/server.log" "$app_dir/config.json" "$bind"
        fi
        app_t1="$(now_seconds)"
        local app_pid=$((i == 0 ? demo_pid : extra_pids[-1]))
        log_line "$run_log" "app bench-$i launched: pid=$app_pid bind=$bind" \
            "server_log=$app_dir/server.log"
        log_line "$run_log" "app bench-$i ready: elapsed=$(seconds_between "$app_t0" "$app_t1")s"
        reqs[i]="${req_alloc[i]}"
        concs[i]="$conc"
        urls[i]="http://$bind/sync"
        hosts[i]="bench.resident.test"
        timeouts[i]=30
        outfiles[i]="$app_dir/hey.txt"
        status_files[i]="$app_dir/status.json"
    done

    t_setup_done="$(now_seconds)"
    log_line "$run_log" "setup phase complete: elapsed=$(seconds_between "$t_start" "$t_setup_done")s"
    log_line "$run_log" "load phase start: $benchmark_apps apps, $benchmark_load_requests total requests"
    launch_hey_jobs reqs concs urls hosts timeouts outfiles statuses "$run_log"
    t_load_done="$(now_seconds)"
    log_line "$run_log" "load phase complete: elapsed=$(seconds_between "$t_setup_done" "$t_load_done")s"

    local -a app_ids cmds
    local app_summaries="[]"
    for ((i = 0; i < benchmark_apps; i++)); do
        if [[ "${statuses[i]}" != 0 ]]; then
            log_line "$run_log" "FAILURE: app bench-$i hey exit=${statuses[i]}" \
                "see ${outfiles[i]} and $dir/app-$i/server.log"
        fi
        [[ "${statuses[i]}" == 0 ]]
        if ((reqs[i] > 0)); then
            if ! grep -Eq "\\[200\\][[:space:]]+${reqs[i]} responses" "${outfiles[i]}"; then
                log_line "$run_log" "FAILURE: app bench-$i did not report ${reqs[i]} 200 responses" \
                    "see ${outfiles[i]} and $dir/app-$i/server.log"
            fi
            grep -Eq "\\[200\\][[:space:]]+${reqs[i]} responses" "${outfiles[i]}"
        fi
        local port=$((8320 + i))
        curl --fail-with-body --silent --show-error \
            "http://127.0.0.1:$port/__hyperlight/status" >"${status_files[i]}"
        log_line "$run_log" "app bench-$i pool status: $(jq -c . "${status_files[i]}")"
        local one
        one="$(build_app_summary "bench-$i" "${reqs[i]}" "${concs[i]}" "${outfiles[i]}")"
        app_summaries="$(jq -c --argjson one "$one" '. + [$one]' <<<"$app_summaries")"
        app_ids[i]="bench-$i"
        cmds[i]="hey -n ${reqs[i]} -c ${concs[i]} -t ${timeouts[i]} -host ${hosts[i]} ${urls[i]}"
    done

    write_collected_hey_report "$dir/hey.txt" app_ids urls cmds outfiles
    jq -s '.' "$dir"/app-*/status.json >"$dir/status.json"
    log_line "$run_log" "shutdown start"
    stop_processes
    t_end="$(now_seconds)"
    log_line "$run_log" "shutdown complete: elapsed=$(seconds_between "$t_load_done" "$t_end")s"
    local timing_json
    timing_json="$(make_phase_timing \
        "$(seconds_between "$t_start" "$t_setup_done")" \
        "$(seconds_between "$t_setup_done" "$t_load_done")" \
        "$(seconds_between "$t_load_done" "$t_end")" \
        "$(seconds_between "$t_start" "$t_end")")"
    write_benchmark_summary "benchmark-resident" "$app_summaries" "$timing_json" \
        "$hey_max_parallel_jobs" "$dir/summary.json"
    log_line "$run_log" "benchmark-resident complete: total_elapsed=$(seconds_between "$t_start" "$t_end")s"
    echo "All $benchmark_load_requests requests across $benchmark_apps independent resident apps succeeded; see $dir/summary.json, $dir/hey.txt, and $run_log"
}

