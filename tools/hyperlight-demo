    worker_code_heading
    case "$demo" in
        isolation|resident|multi-app|orchestrator-contract)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/acceptance.json" "$artifact"
            ;;
        policy|kv|cache|sql|durable-objects)
            write_source_worker_code "$artifact" \
                "worker.js" "esModule" \
                "$root/examples/workerd-capability-workers/data-worker.js"
            ;;
        ingress)
            write_source_worker_code "$artifact" \
                "worker.js" "esModule" \
                "$root/examples/workerd-capability-workers/ingress-worker.js"
            ;;
        node)
            write_node_worker_code "$artifact"
            ;;
        storage)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/workerd-vfs-evidence.json" "$artifact"
            ;;
        core-wasm|web-apis)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/workerd-wintertc-demo.json" "$artifact"
            ;;
        component)
            write_source_worker_code "$artifact" \
                "worker.mjs" "esModule" \
                "$root/experiments/workerd-component-model/worker.mjs" \
                "generated/component.js" "esModule" \
                "$root/experiments/workerd-component-model/generated/component.js"
            ;;
        fetch)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/fetch-policy-demo.json" "$artifact"
            ;;
        benchmark-on-demand|benchmark-prewarmed|benchmark-resident|benchmark-multi-app)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/workerd-pool-benchmark.json" "$artifact"
            ;;
        benchmark-orchestrator-contract)
            write_bundle_worker_code \
                "$root/examples/workerd-bundles/workerd-drain-benchmark.json" "$artifact"
            ;;
        wasi-p2|wasi-p3)
            printf '  No JavaScript runs in Workerd for this WASI host-contract demo.\n\n'
            return
            ;;
        tcp-tls|udp|websocket)
            printf '  No JavaScript runs in Workerd for this host-broker contract demo.\n\n'
            return
            ;;
        *)
            printf '  No Worker JavaScript source is associated with this demo.\n\n'
            return
            ;;
    esac
    jq -r '.modules[] | "// \(.name) (\(.type))\n\(.source)"' \
        "$artifact" >"$rendered"
    sed -n '1,20p' "$rendered" | sed 's/^/  /'
    local rendered_lines
    rendered_lines="$(wc -l <"$rendered")"
    if ((rendered_lines > 20)); then
        printf '  ... %d additional lines omitted ...\n' "$((rendered_lines - 20))"
    fi
    rm -f -- "$rendered"
    printf '\n  Full code: %s\n' "$artifact"
    printf "  Command: cat %q | jq -r '%s'\n\n" \
        "$artifact" '.modules[] | "// \(.name) (\(.type))\n\(.source)"'
}

print_result_lines() {
    local line
    while IFS= read -r line; do
        case "$line" in
            RESULT:*)
                printf '  %bRESULT%b %s\n' "$c_green" "$c_reset" "${line#RESULT: }"
                ;;
            "EXPECTED DENIAL:"*)
                printf '  %bDENIED%b %s\n' "$c_yellow" "$c_reset" \
                    "${line#EXPECTED DENIAL: }"
                ;;
            LIMIT:*)
                printf '  %bLIMIT%b %s\n' "$c_yellow" "$c_reset" "${line#LIMIT: }"
                ;;
            *) print_wrapped "  " "$line" ;;
        esac
    done < <(result_lines "$1")
}

