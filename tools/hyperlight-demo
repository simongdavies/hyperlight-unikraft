require_runtime() {
    local required
    for required in \
        target/release/examples/workerd-demo \
        build-elfloader/workerd-executor/executor \
        examples/workerd-bundles/acceptance.json
    do
        [[ -e "$root/$required" ]] || {
            echo "missing $required; run tools/setup-workerd-demo.sh first" >&2
            exit 2
        }
    done
    for required in cargo curl docker hey jq lscpu python3 sha256sum sqlite3; do
        command -v "$required" >/dev/null || {
            echo "missing required command: $required" >&2
            exit 2
        }
    done
}

wait_for_server() {
    local server_log="$1"
    local attempt
    for attempt in $(seq 1 600); do
        if curl --silent --fail \
            http://127.0.0.1:8787/__hyperlight/pool-status >/dev/null; then
            return 0
        fi
        if ! kill -0 "$demo_pid" 2>/dev/null; then
            tail -n 30 "$server_log" >&2
            return 1
        fi
        sleep 1
    done
    echo "workerd-demo did not become ready; see $server_log" >&2
    return 1
}

start_server() {
    local server_log="$1"
    shift
    stop_demo
    "$root/target/release/examples/workerd-demo" \
        --executor "$root/build-elfloader/workerd-executor/executor" \
        --rootfs "$root/build-elfloader/workerd-executor/rootfs.img" \
        --bind 127.0.0.1:8787 \
        "$@" >"$server_log" 2>&1 &
    demo_pid=$!
    wait_for_server "$server_log"
}

run_exact_test() {
    cargo +1.98.0 test --locked --lib "$1" -- --exact --nocapture
}

run_isolation() {
    local dir="$output_dir/isolation"
    mkdir -p "$dir"
    start_server "$dir/server.log" \
        --bundle "$root/examples/workerd-bundles/acceptance.json" \
        --scratch-mb 384 \
        --request-timeout-ms 500 \
        --restore-mode on-demand \
        --max-concurrent-sandboxes 1 \
        --queue-capacity 1
    curl --fail-with-body --silent --show-error \
        http://127.0.0.1:8787/before |
        tee "$dir/before.json" |
        jq -e '.path == "/before" and .method == "GET"' >/dev/null
    local status
    status="$(curl --silent --show-error --output "$dir/timeout.json" \
        --write-out '%{http_code}' http://127.0.0.1:8787/busy)"
    [[ "$status" == 504 ]]
    curl --fail-with-body --silent --show-error \
        http://127.0.0.1:8787/after |
        tee "$dir/after.json" |
        jq -e '.path == "/after" and .method == "GET"' >/dev/null
    stop_processes
    echo "HTTP 504 was isolated; the following fresh-VM request succeeded."
}

run_policy() {
    ensure_capability_proof || return
