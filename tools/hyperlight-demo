            return 0
        fi
        if ! kill -0 "$demo_pid" 2>/dev/null; then
            tail -n 30 "$server_log" >&2
            return 1
        fi
        sleep 1
    done
    echo "workerd-demo did not become ready; see $server_log" >&2
    return 1
