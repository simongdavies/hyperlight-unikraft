            evidence_row "Unknown version" "$(jq -r '"\(.imports.unsupported.category): \(.imports.unsupported.interface)"' "$wasi_p3")"
            evidence_row "Process spawn" "$(jq -r '"\(.imports.capability_denied.category): \(.imports.capability_denied.interface)"' "$wasi_p3")"
            ;;
        *)
