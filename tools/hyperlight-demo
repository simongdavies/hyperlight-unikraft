run_fetch() {
    local dir="$output_dir/fetch"
    mkdir -p "$dir"
    python3 - <<'PY' >"$dir/upstream.log" 2>&1 &
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
BODY = b"allowed-upstream\n"
class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/redirect":
            self.send_response(302)
            self.send_header("location", "/ok")
            self.send_header("content-length", "0")
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("content-length", str(len(BODY)))
        self.end_headers()
        self.wfile.write(BODY)
    def log_message(self, *_):
        pass
ThreadingHTTPServer(("127.0.0.1", 18080), Handler).serve_forever()
PY
    upstream_pid=$!
    local attempt
    for attempt in $(seq 1 100); do
        curl --silent --fail http://127.0.0.1:18080/ok >/dev/null && break
        kill -0 "$upstream_pid" 2>/dev/null || return 1
        sleep 0.1
    done
    curl --silent --fail http://127.0.0.1:18080/ok >/dev/null
    start_server "$dir/server.log" \
        --bundle "$root/examples/workerd-bundles/fetch-policy-demo.json" \
        --scratch-mb 384 \
        --restore-mode on-demand \
        --fetch-loopback-port 18080
    "$root/tools/run-workerd-fetch-policy-demo.sh" \
        --output-dir "$dir/checks" \
        --upstream-port 18080 \
        all
    stop_processes
}

wait_for_pool_quiescence() {
    local mode="$1"
    local status_file="$2"
    local attempt
    for attempt in $(seq 1 600); do
        curl --fail-with-body --silent --show-error \
            http://127.0.0.1:8787/__hyperlight/pool-status >"$status_file"
        if jq -e --arg mode "$mode" '
            .admitted == 0 and
            .active == 0 and
            .queued == 0 and
            .execution_slots_in_use == 0 and
            .restore_slots_in_use == 0 and
            .recycle_queue_depth == 0 and
            .teardown_in_flight == 0 and
            .completion_queue_depth == 0 and
            .completion_in_flight == 0 and
            (
                $mode == "on-demand" or
                (
                    .prewarmed_replenishing == 0 and
                    .restore_permits_outstanding == 0 and
                    .refill_active == false and
                    .prewarmed_ready == .prewarmed_inventory
                )
            )
        ' "$status_file" >/dev/null; then
            return 0
        fi
        sleep 0.1
    done
    echo "pool did not become quiescent; see $status_file" >&2
    return 1
}

run_benchmark() {
    local mode="$1"
    local dir="$output_dir/benchmark-$mode"
    local args=(
        --bundle "$root/examples/workerd-bundles/workerd-pool-benchmark.json"
        --scratch-mb 384
        --request-timeout-ms 30000
        --restore-mode "$mode"
        --max-concurrent-sandboxes 32
        --queue-capacity 256
        --profile-log-every 64
    )
    if [[ "$mode" == prewarmed ]]; then
        args+=(
            --prewarmed-sandboxes 48
            --max-concurrent-restores 1
            --warm-floor 1
            --ready-low-watermark 16
            --ready-high-watermark 32
            --max-replenish-batch 2
        )
    fi
    mkdir -p "$dir"
    start_server "$dir/server.log" "${args[@]}"
    hey -n 320 -c 32 http://127.0.0.1:8787/sync | tee "$dir/hey.txt"
    grep -Eq '\[200\][[:space:]]+320 responses' "$dir/hey.txt"
    wait_for_pool_quiescence "$mode" "$dir/pool-status.json"
    jq '{
            restore_mode,
            admitted,
            active,
            queued,
            ready,
            warm_floor,
            ready_low_watermark,
            ready_high_watermark,
            execution_slots_in_use,
            restore_slots_in_use,
            recycle_queue_depth,
            teardown_in_flight,
            completion_queue_depth,
            completion_in_flight,
            replenishment_paused,
            replenishment_pause_reason,
            refill_active,
            prewarmed_inventory,
            prewarmed_ready,
            prewarmed_replenishing
        }' "$dir/pool-status.json"
    stop_processes
    printf 'Compare demo-output/benchmark-on-demand/hey.txt and '
    printf 'demo-output/benchmark-prewarmed/hey.txt on this same host.\n'
}

run_demo_command() {
    case "$1" in
        isolation) run_isolation ;;
        policy) run_policy ;;
        ingress) run_ingress ;;
        kv) run_kv ;;
        cache) run_cache ;;
        d1) run_d1 ;;
        durable-objects) run_durable_objects ;;
        storage) run_storage ;;
        node) run_node ;;
        core-wasm) run_core_wasm ;;
        component) run_component ;;
        wasi-p2) run_wasi_p2 ;;
        wasi-p3) run_wasi_p3 ;;
        tcp-tls) run_tcp_tls ;;
        udp) run_udp ;;
        websocket) run_websocket ;;
        web-apis) run_web_apis ;;
        fetch) run_fetch ;;
        benchmark-on-demand) run_benchmark on-demand ;;
        benchmark-prewarmed) run_benchmark prewarmed ;;
        *) return 2 ;;
    esac
}

run_one() {
    local demo="$1"
    local log="$output_dir/$demo.log"
    mkdir -p "$output_dir"
    render_demo "$demo"
    printf 'Running... raw output is being saved to %s\n' "$log"
    local status=0
    if "$verbose"; then
        (
            trap stop_processes EXIT INT TERM
            set -e
            run_demo_command "$demo"
        ) > >(tee "$log") 2>&1 || status=$?
    else
        (
            trap stop_processes EXIT INT TERM
            set -e
            run_demo_command "$demo"
        ) >"$log" 2>&1 || status=$?
    fi
    if ((status == 0)); then
        printf '\nPASS: %s\n' "$(title "$demo")"
        print_result_lines "$demo"
        print_wrapped "TAKEAWAY: " "$(takeaway "$demo")"
        printf 'LOG: %s\n' "$log"
        return 0
    fi
    stop_processes
    printf '\nFAIL: %s\n' "$(title "$demo")" >&2
    printf 'LOG: %s\n' "$log" >&2
    printf 'LAST OUTPUT:\n' >&2
    tail -n 8 "$log" | sed 's/^/  /' >&2
    return 1
}

mode=interactive
selected=""
while (($#)); do
    case "$1" in
        --all)
            mode=all
            shift
            ;;
        --demo)
            (($# >= 2)) || {
                echo "--demo requires a name" >&2
                usage >&2
                exit 2
            }
            mode=one
            selected="$2"
            shift 2
            ;;
        --list)
            list_demos
            exit 0
            ;;
        --preview)
            mode=preview
            shift
            ;;
        --describe)
            (($# >= 2)) || {
                echo "--describe requires a name" >&2
                usage >&2
                exit 2
            }
            mode=describe
            selected="$2"
            shift 2
            ;;
        --output-dir)
            (($# >= 2)) || {
                echo "--output-dir requires a value" >&2
                usage >&2
                exit 2
            }
            output_dir="$2"
            shift 2
            ;;
        --verbose)
            verbose=true
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ "$mode" == one || "$mode" == describe ]] &&
    [[ ! " ${demos[*]} " =~ " $selected " ]]; then
    echo "unknown demo: $selected" >&2
    echo "run tools/hyperlight-demo --list to see valid names" >&2
    exit 2
fi
if [[ "$mode" == preview ]]; then
    print_scope_context
    for demo in "${demos[@]}"; do
        render_preview "$demo"
    done
    printf '\nPreview complete. The runbook contains the detailed compatibility boundaries.\n'
    exit 0
fi
if [[ "$mode" == describe ]]; then
    render_preview "$selected"
    exit 0
fi
if [[ "$mode" == interactive ]] && [[ ! -t 0 ]]; then
    echo "interactive mode requires a terminal; use --all or --demo NAME" >&2
    exit 2
fi

require_runtime
cd "$root"

if [[ "$mode" == one ]]; then
    run_one "$selected"
    exit
fi

for demo in "${demos[@]}"; do
    if [[ "$mode" == interactive ]]; then
        printf '\nNext: %s\n%s\n' "$(title "$demo")" "$(description "$demo")"
        read -r -p "Enter=run, s=skip, q=quit: " choice
        case "$choice" in
            q) exit 0 ;;
            s) continue ;;
        esac
    fi
    run_one "$demo"
    if [[ "$mode" == interactive ]]; then
        read -r -p "Enter=continue, r=repeat, q=quit: " choice
        case "$choice" in
            q) exit 0 ;;
            r) run_one "$demo" ;;
        esac
    fi
done

printf '\nAll selected demos passed. Output: %s\n' "$output_dir"
