                    printf ' per-app reports remain on disk in %s and each app-N/hey.txt)\n' "$dir/hey.txt"
                else
                    sed 's/^/  /' "$dir/hey.txt"
                fi
            fi
            ;;
        benchmark-multi-app)
            local dir="$output_dir/benchmark-multi-app"
            evidence_row "Apps" "$benchmark_apps routed apps, one process and port"
            evidence_row "Total requests" "$benchmark_load_requests / aggregate concurrency $benchmark_concurrency"
            evidence_row "Sum-of-rates throughput" "$(jq -r '.aggregate.sum_of_app_requests_per_sec' "$dir/summary.json") req/s (sum of each app's own hey rate; overstates true throughput once hey_waves > 1)"
            evidence_row "End-to-end throughput" "$(jq -r '.aggregate.end_to_end_requests_per_sec' "$dir/summary.json") req/s (total_requests / first-wave-release-to-last-wave-finish seconds; includes inter-wave gaps -- the number to report/compare as this run's throughput)"
            evidence_row "Active-wave throughput" "$(jq -r '.aggregate.active_wave_requests_per_sec' "$dir/summary.json") req/s (total_requests / sum of each wave's barrier-release-to-finish seconds; excludes all forking/spawn overhead AND inter-wave gaps -- narrower than end-to-end once hey_waves > 1, same value when hey_waves == 1)"
            evidence_row "Hey waves / barrier scope" "$(jq -r '.aggregate.hey_waves' "$dir/summary.json") wave(s), barrier_scope=$(jq -r '.aggregate.barrier_scope' "$dir/summary.json") (apps=$benchmark_apps, max $(jq -r '.aggregate.max_parallel_hey_jobs' "$dir/summary.json") concurrent hey processes; the barrier only holds jobs within ONE wave together -- apps do not all launch simultaneously when hey_waves > 1)"
            evidence_row "Phase timing" "$(jq -c '.timing' "$dir/summary.json")"
            evidence_row "Per-app status" "$dir/status.json"
            evidence_row "Per-app summary" "$dir/summary.json (.apps; $benchmark_apps targets)"
            evidence_row "Raw hey output" "$dir/hey.txt (collected per-app reports; each app also keeps its own app-N-hey.txt)"
            evidence_row "Log" "$dir/run.log (orchestration: config, launch/ready, hey waves, status, shutdown, phase totals)"
            printf '\n%bLSCPU OUTPUT%b\n\n' "$c_bold$c_green" "$c_reset"
            sed 's/^/  /' "$dir/lscpu.txt"
            printf '\n%bSUMMARY JSON%b\n\n' "$c_bold$c_green" "$c_reset"
            jq 'del(.apps)' "$dir/summary.json" | sed 's/^/  /'
            printf '\n%bRAW HEY OUTPUT%b\n\n' "$c_bold$c_green" "$c_reset"
            if ((benchmark_apps > 1)); then
                printf '  (omitted from terminal/log display: %d hey clients; full raw' \
                    "$benchmark_apps"
                printf ' per-app reports remain on disk in %s and each app-N-hey.txt)\n' "$dir/hey.txt"
            else
                sed 's/^/  /' "$dir/hey.txt"
            fi
            ;;
        benchmark-orchestrator-contract)
            local dir="$output_dir/benchmark-orchestrator-contract"
            evidence_row "Apps" "$benchmark_apps apps under load"
            evidence_row "Pre-drain throughput" "$(jq -r '.pre_drain.aggregate.aggregate_requests_per_sec' "$dir/summary.json") req/s"
            evidence_row "During-drain requests" "$(jq -r '.during_drain.aggregate.total_requests' "$dir/summary.json") completed after SIGTERM"
            local psp_outcome psp_exit psp_http psp_message
            psp_outcome="$(jq -r '.post_signal_probe' "$dir/summary.json")"
            psp_exit="$(jq -r '.post_signal_probe_detail.curl_exit_code' "$dir/summary.json")"
            psp_http="$(jq -r '.post_signal_probe_detail.http_code' "$dir/summary.json")"
            case "$psp_outcome" in
                no_response)
                    psp_message="PASS post-signal new connection: no response within 1s (expected during drain; curl exit $psp_exit)" ;;
                unexpected_200)
                    psp_message="FAIL post-signal new connection unexpectedly got HTTP 200 (admitted after SIGTERM)" ;;
                unexpected_error)
                    psp_message="FAIL post-signal probe hit an unexpected curl error (exit $psp_exit); see $dir/post-signal-probe-stderr.txt" ;;
                *)
                    psp_message="FAIL post-signal probe got unexpected HTTP $psp_http (curl exit $psp_exit)" ;;
            esac
            evidence_row "Post-signal probe" "$psp_message"
            evidence_row "Shutdown duration" "$(jq -r '.shutdown_duration_ms' "$dir/summary.json") ms"
            evidence_row "Exit code" "$(jq -r '.exit_code' "$dir/summary.json") (0 = clean shutdown)"
            printf '\n%bSUMMARY JSON%b\n\n' "$c_bold$c_green" "$c_reset"
            evidence_row "Per-app details" "$dir/summary.json (pre_drain.apps / during_drain.apps)"
            jq 'del(.pre_drain.apps, .during_drain.apps)' "$dir/summary.json" | sed 's/^/  /'
            ;;
        component)
            local component="$output_dir/component/proof.json"
            evidence_row "Runtime" "workerd-on-hyperlight"
            while IFS=$'\t' read -r url status body; do
                evidence_row "HTTP $status" "$url -> $body"
            done < <(jq -r '.routes[] | [.url, (.status|tostring), .body] | @tsv' "$component")
            evidence_row "Iterations" "$(jq -r '.iterations' "$component") deterministic fresh-VM requests"
            evidence_row "Digest" "$(jq -r '.deterministic_response_sha256' "$component")"
            ;;
        tcp-tls)
            local network_log="$output_dir/tcp-tls.log"
            local tcp tls denied
            tcp="$(grep -o 'DEMO_EVIDENCE=.*' "$network_log" | sed 's/^DEMO_EVIDENCE=//' | jq -rs 'map(select(.demo == "tcp"))[0]')"
            tls="$(grep -o 'DEMO_EVIDENCE=.*' "$network_log" | sed 's/^DEMO_EVIDENCE=//' | jq -rs 'map(select(.demo == "tls"))[0]')"
            denied="$(grep -o 'DEMO_EVIDENCE=.*' "$network_log" | sed 's/^DEMO_EVIDENCE=//' | jq -rs 'map(select(.demo == "tcp-denial"))[0]')"
            evidence_row "Proof path" "real host-broker sockets"
            evidence_row "TCP" "$(jq -r '"sent \(.sent_bytes) bytes, received \(.received), audit=\(.audit_events)"' <<<"$tcp")"
            evidence_row "Fresh assignment" "$(jq -r '.after_reset' <<<"$tcp")"
            evidence_row "TLS" "$(jq -r '"v\(.tls_version), roots=\(.trust_roots), received \(.received)"' <<<"$tls")"
            evidence_row "Denied connect" "$(jq -r '"\(.code), connected=\(.connected)"' <<<"$denied")"
            evidence_row "LIMIT" "Workerd socket channel not yet wired"
            ;;
        udp)
            local udp_log="$output_dir/udp.log"
            local udp limit
            udp="$(grep -o 'DEMO_EVIDENCE=.*' "$udp_log" | sed 's/^DEMO_EVIDENCE=//' | jq -rs 'map(select(.demo == "udp"))[0]')"
            limit="$(grep -o 'DEMO_EVIDENCE=.*' "$udp_log" | sed 's/^DEMO_EVIDENCE=//' | jq -rs 'map(select(.demo == "udp-limit"))[0]')"
            evidence_row "Proof path" "real host-broker datagrams"
            evidence_row "Datagram" "$(jq -r '"sent \(.sent_bytes) bytes, received \(.received), audit=\(.audit_events)"' <<<"$udp")"
            evidence_row "Fresh assignment" "$(jq -r '.after_reset' <<<"$udp")"
            evidence_row "Size limit" "$(jq -r '"\(.code), host_send=\(.host_send)"' <<<"$limit")"
            evidence_row "LIMIT" "Workerd UDP channel not yet wired"
            ;;
        websocket)
            local websocket_log="$output_dir/websocket.log"
            local websocket ws_limit secure
            websocket="$(grep -o 'DEMO_EVIDENCE=.*' "$websocket_log" | sed 's/^DEMO_EVIDENCE=//' | jq -rs 'map(select(.demo == "websocket"))[0]')"
            ws_limit="$(grep -o 'DEMO_EVIDENCE=.*' "$websocket_log" | sed 's/^DEMO_EVIDENCE=//' | jq -rs 'map(select(.demo == "websocket-limit"))[0]')"
            secure="$(grep -o 'DEMO_EVIDENCE=.*' "$websocket_log" | sed 's/^DEMO_EVIDENCE=//' | jq -rs 'map(select(.demo == "websocket-secure"))[0]')"
            evidence_row "Proof path" "real host-broker WebSockets"
            evidence_row "WebSocket" "$(jq -r '"sent \(.sent.type)/\(.sent.bytes)B, received \(.received.type)/\(.received.body)"' <<<"$websocket")"
            evidence_row "Fresh assignment" "$(jq -r '.after_reset' <<<"$websocket")"
            evidence_row "Message limit" "$(jq -r '"\(.code), host_send=\(.host_send)"' <<<"$ws_limit")"
            evidence_row "Secure socket" "$(jq -r '"\(.tls), roots=\(.trust_roots), received \(.received)"' <<<"$secure")"
            evidence_row "LIMIT" "Workerd WebSocket channel not yet wired"
            ;;
        wasi-p2)
            local wasi_p2="$output_dir/wasi-p2-proof.json"
            evidence_row "Proof path" "$(jq -r '.proof_path' "$wasi_p2")"
            evidence_row "HTTP ingress" "$(jq -r '"id=\(.http.request_id), HTTP \(.http.status)"' "$wasi_p2")"
            evidence_row "Input stream" "$(jq -r '"chunk=\(.streams.input_chunk), closed=\(.streams.closed_read)"' "$wasi_p2")"
            evidence_row "Output stream" "$(jq -r '"wrote=\(.streams.first_write_bytes)B, limit=\(.streams.quota_write)"' "$wasi_p2")"
            evidence_row "Clock" "$(jq -r '"wall=\(.clock.wall_ns)ns, monotonic=\(.clock.monotonic_ns), zone=\(.clock.timezone)"' "$wasi_p2")"
            evidence_row "Random" "$(jq -r '"bytes=\(.random.secure_bytes), limit=\(.random.quota)"' "$wasi_p2")"
            evidence_row "CLI" "$(jq -r '"env=\(.cli.environment), args=\(.cli.arguments), stdout=\(.cli.stdout_bytes)B"' "$wasi_p2")"
            evidence_row "Denied imports" "$(jq -r '"unknown=\(.denials.unknown_import); udp=\(.denials.udp)"' "$wasi_p2")"
            ;;
        wasi-p3)
            local wasi_p3="$output_dir/wasi-p3-proof.json"
            evidence_row "Proof path" "$(jq -r '.proof_path' "$wasi_p3")"
            evidence_row "Future pending" "$(jq -r '.future.pending_step' "$wasi_p3")"
            evidence_row "Future completed" "$(jq -r '"\(.future.completed_step), value=\(.future.value)"' "$wasi_p3")"
            evidence_row "Cancellation" "$(jq -r '"producer_cancelled=\(.future.producer_cancelled)"' "$wasi_p3")"
            evidence_row "Stream order" "$(jq -r '"received=\(.stream.received), steps=\(.stream.steps)"' "$wasi_p3")"
            evidence_row "Stream tasks" "$(jq -r '"producer=\(.stream.producer_state), consumer=\(.stream.consumer_state)"' "$wasi_p3")"
