# Scripts this file invokes directly by path (e.g. "$root/tools/foo.sh" ...,
# not "bash $root/tools/foo.sh" or "sh $root/tools/foo.sh"). Direct invocation
# relies on the kernel honoring the file's executable permission bit, which
# git tracks per-blob (100755 vs 100644). A fresh clone on a filesystem that
# respects git's mode bits will fail with "Permission denied" at the shell's
# exec() call if the tracked mode is 100644, even though the file's contents
# are a valid, syntactically correct script. Keep this list in sync with the
# direct "$root/tools/*.sh" call sites below.
helper_scripts_invoked_directly=(
    tools/run-workerd-vfs-demo.sh
    tools/run-workerd-storage-policy-demo.sh
    tools/run-wintertc-demo.sh
    tools/run-workerd-fetch-policy-demo.sh
)

require_helper_scripts_executable() {
    local helper
    for helper in "${helper_scripts_invoked_directly[@]}"; do
        local path="$root/$helper"
        if [[ ! -e "$path" ]]; then
            echo "missing $helper; run tools/setup-workerd-demo.sh first" >&2
            exit 2
        fi
        if [[ ! -x "$path" ]]; then
            echo "$helper is not executable (tracked without the executable bit, or permissions were lost on checkout/copy); run: chmod +x $path" >&2
            exit 2
        fi
    done
}

wait_for_server() {
