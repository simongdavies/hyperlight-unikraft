readonly_sqlite_query() {
    local database="$1"
    local sql="$2"
    local output="$3"
    local prefix="${output%.tsv}"
    printf "sqlite3 -readonly -batch -noheader -separator \$'\\t' %q %q\n" \
        "$database" "$sql" >"$prefix-command.txt"
    sha256sum "$database" >"$prefix.sha256"
    sqlite3 -readonly -batch -noheader -separator $'\t' \
        "$database" "$sql" >"$output"
}

clear_output() {
