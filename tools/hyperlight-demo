set -euo pipefail

configure_user_home() {
    local variable="$1"
    local fallback="$2"
    local value="${!variable:-$fallback}"
    local probe

    if ! mkdir -p "$value" 2>/dev/null ||
        ! probe="$(mktemp "$value/.hyperlight-write-test.XXXXXX" 2>/dev/null)"; then
        printf 'warning: %s=%s is not writable; using %s\n' \
            "$variable" "$value" "$fallback" >&2
        value="$fallback"
        mkdir -p "$value"
        probe="$(mktemp "$value/.hyperlight-write-test.XXXXXX")"
    fi
    rm -f -- "$probe"
    printf -v "$variable" '%s' "$value"
    export "$variable"
}

configure_user_home CARGO_HOME "$HOME/.cargo"
configure_user_home RUSTUP_HOME "$HOME/.rustup"

normalize_path() {
    local value
    value="$(realpath -m "$1")"
    if [[ "$value" =~ ^([A-Za-z]):/(.*)$ ]]; then
        value="/${BASH_REMATCH[1],,}/${BASH_REMATCH[2]}"
    fi
    printf '%s\n' "$value"
}

cpu_topology="$(LC_ALL=C lscpu 2>/dev/null || true)"
lscpu_value() {
    local label="$1"
    awk -F: -v label="$label" '
        $1 == label {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
            print $2
            exit
        }
    ' <<<"$cpu_topology"
}

logical_cpus="$(lscpu_value "CPU(s)")"
if [[ ! "$logical_cpus" =~ ^[1-9][0-9]*$ ]]; then
    logical_cpus="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)"
fi
cpu_sockets="$(lscpu_value "Socket(s)")"
cores_per_socket="$(lscpu_value "Core(s) per socket")"
threads_per_core="$(lscpu_value "Thread(s) per core")"
[[ "$threads_per_core" =~ ^[1-9][0-9]*$ ]] || threads_per_core=1
if [[ "$cpu_sockets" =~ ^[1-9][0-9]*$ ]] &&
    [[ "$cores_per_socket" =~ ^[1-9][0-9]*$ ]]; then
    physical_cores=$((cpu_sockets * cores_per_socket))
else
    physical_cores=$((logical_cpus / threads_per_core))
    ((physical_cores > 0)) || physical_cores=1
fi

root="$(normalize_path "$(cd "$(dirname "$0")/.." && pwd)")"
output_dir="${HYPERLIGHT_DEMO_OUTPUT:-$root/demo-output}"
demo_pid=""
upstream_pid=""
extra_pids=()
verbose=false
capability_proof_ran=false
benchmark_requests="${HYPERLIGHT_BENCHMARK_REQUESTS:-$((physical_cores * 100))}"
benchmark_concurrency="${HYPERLIGHT_BENCHMARK_CONCURRENCY:-$physical_cores}"
benchmark_vms="${HYPERLIGHT_BENCHMARK_VMS:-$physical_cores}"
benchmark_pool_vms="${HYPERLIGHT_BENCHMARK_POOL_VMS:-$((physical_cores + 1))}"
# benchmark-resident/benchmark-multi-app/benchmark-orchestrator-contract:
# number of independent/routed apps to spread load across. Reuses
# physical_cores like the other benchmark_* defaults (uncapped by design:
# document the resource implications rather than silently capping it).
benchmark_apps="${HYPERLIGHT_BENCHMARK_APPS:-$physical_cores}"
# Total requests for the three load benchmarks above. Distinct from
# benchmark_requests (which stays the on-demand/prewarmed default): its
# default depends on benchmark_apps, which --benchmark-apps may still
# change later in arg parsing, so the real default is deferred and
# computed once parsing finishes (see below the arg-parsing loop).
benchmark_load_requests="${HYPERLIGHT_BENCHMARK_LOAD_REQUESTS:-}"
benchmark_load_requests_explicit=false
[[ -n "$benchmark_load_requests" ]] && benchmark_load_requests_explicit=true
# launch_hey_jobs runs at most this many hey client processes at once
# regardless of app count; kept as a named constant (rather than
# launch_hey_jobs's previous hardcoded local) so benchmark-resident and
# benchmark-multi-app can report it alongside their timing/throughput
# numbers (see write_benchmark_summary) instead of leaving it undocumented.
#
# Left unset here (HYPERLIGHT_BENCHMARK_HEY_PARALLEL/--benchmark-hey-parallel
# not given): once --benchmark-apps finishes parsing, this defaults to
# --benchmark-apps itself -- i.e. every app's hey process is launched in a
# *single* synchronized wave, not split into sequential wave_1-completes-
# then-wave_2-starts batches of 16. Sequential wave-splitting was the
# original (now removed) default: it under-counted "concurrent" load at
# high --benchmark-apps (later waves only started once every job in the
# previous wave had *finished*, serializing what should be one benchmark
# run into several back-to-back ones) and is why the single-wave default
# is paired with a nonzero hey_ramp_ms below, to avoid every process
# hitting the CPU in the same instant instead. Still override with
# --benchmark-hey-parallel/HYPERLIGHT_BENCHMARK_HEY_PARALLEL to cap it
# below --benchmark-apps and restore (bounded) wave-splitting.
hey_max_parallel_jobs="${HYPERLIGHT_BENCHMARK_HEY_PARALLEL:-}"
hey_max_parallel_jobs_explicit=false
[[ -n "$hey_max_parallel_jobs" ]] && hey_max_parallel_jobs_explicit=true
# Per-job release stagger (milliseconds), applied within launch_hey_jobs's
# pre-spawn-paused/release-together wave model: every hey job in a wave is
# forked first (paused behind a gate, not yet sending requests), then
# released as a batch; with hey_ramp_ms > 0 each job's release is
# additionally delayed by its position in the batch times this value, so
# a large wave does not have every hey process start sending requests in
# the same instant (a CPU "blast" at wave release).
#
# Left unset here (HYPERLIGHT_BENCHMARK_HEY_RAMP_MS/--benchmark-hey-ramp-ms
# not given): defaults to 10ms per job once parsing finishes -- paired
# with the hey_max_parallel_jobs change above, this is what turns "launch
# every app's hey process in one wave" from a simultaneous CPU spike into
# a deliberate ramp-up: requests start arriving within milliseconds of
# each other in app order rather than all at the exact same instant, while
# the whole benchmark is still one synchronized run rather than several
# sequential waves. Set to 0 (via either override) to release every job
# in a wave at the same moment with no deliberate delay, matching the
# original behavior.
hey_ramp_ms="${HYPERLIGHT_BENCHMARK_HEY_RAMP_MS:-}"
hey_ramp_ms_explicit=false
[[ -n "$hey_ramp_ms" ]] && hey_ramp_ms_explicit=true
# benchmark-resident's setup loop forks each app's own `hluk workerd-host`
# process (which restores from the shared prewarm snapshot) and polls it
# for readiness; this bounds how many of those independent forks/restores
# are in flight at once. Left unset here (HYPERLIGHT_BENCHMARK_SETUP_PARALLEL/
# --benchmark-setup-parallel not given): defaults to physical_cores once
# parsing finishes, so restores spread across available cores instead of
# running one at a time (the original behavior, equivalent to passing 1).
benchmark_setup_parallel="${HYPERLIGHT_BENCHMARK_SETUP_PARALLEL:-}"
benchmark_setup_parallel_explicit=false
[[ -n "$benchmark_setup_parallel" ]] && benchmark_setup_parallel_explicit=true
# benchmark-resident's load phase defaults to launching one `hey` process
# per app (see launch_hey_jobs): at thousands of apps this means
# thousands of forked client processes, each with its own barrier-release
# wait and progress/logging overhead -- real, measured cost even after
# the throttling/de-forking fixes elsewhere in this script. Setting
# --benchmark-load-driver/HYPERLIGHT_BENCHMARK_LOAD_DRIVER to "vegeta"
# switches the load phase to a SINGLE `vegeta attack` process hitting
# every app's URL from one shared targets file instead, eliminating the
# N-process fork/barrier/progress overhead entirely for the load phase
# (setup/teardown, which still forks one `hluk workerd-host` per app,
# are unaffected). Requires the `vegeta` binary on PATH (installed by
# `tools/setup-workerd-demo.sh --install-deps`, same as `hey`). Left
# unset here: defaults to "hey" (today's behavior, unchanged) once
# parsing finishes.
benchmark_load_driver="${HYPERLIGHT_BENCHMARK_LOAD_DRIVER:-hey}"
go_bin="${GOBIN:-}"
if [[ -z "$go_bin" ]] && command -v go >/dev/null; then
    go_bin="$(go env GOBIN 2>/dev/null || true)"
    if [[ -z "$go_bin" ]]; then
        go_path="$(go env GOPATH 2>/dev/null || true)"
        [[ -n "$go_path" ]] && go_bin="$go_path/bin"
    fi
fi
go_bin="${go_bin:-${GOPATH:-$HOME/go}/bin}"
export PATH="$go_bin:$CARGO_HOME/bin:$PATH"

