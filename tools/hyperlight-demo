wait_for_pool_quiescence() {
    local mode="$1"
    local status_file="$2"
    local attempt
    for attempt in $(seq 1 600); do
        curl --fail-with-body --silent --show-error \
            http://127.0.0.1:8787/__hyperlight/pool-status >"$status_file"
        if jq -e --arg mode "$mode" '
            .admitted == 0 and
            .active == 0 and
            .queued == 0 and
            .execution_slots_in_use == 0 and
            .restore_slots_in_use == 0 and
            .recycle_queue_depth == 0 and
            .teardown_in_flight == 0 and
            .completion_queue_depth == 0 and
            .completion_in_flight == 0 and
            (
                $mode == "on-demand" or
                (
                    .prewarmed_replenishing == 0 and
                    .restore_permits_outstanding == 0 and
                    .refill_active == false and
                    .prewarmed_ready == .prewarmed_inventory
                )
            )
        ' "$status_file" >/dev/null; then
            return 0
        fi
        sleep 0.1
    done
    echo "pool did not become quiescent; see $status_file" >&2
    return 1
}

run_benchmark() {
    local mode="$1"
    local dir="$output_dir/benchmark-$mode"
    local queue_capacity=256
    local ready_high_watermark="$benchmark_pool_vms"
    local ready_low_watermark
    ((benchmark_concurrency > queue_capacity)) &&
        queue_capacity="$benchmark_concurrency"
    ready_low_watermark=$((ready_high_watermark / 2))
    ((ready_low_watermark > 1)) || ready_low_watermark=2
    local args=(
        --bundle "$root/examples/workerd-bundles/workerd-pool-benchmark.json"
        --scratch-mb 384
        --request-timeout-ms 30000
        --restore-mode "$mode"
        --max-concurrent-sandboxes "$benchmark_vms"
        --queue-capacity "$queue_capacity"
        --profile-log-every 64
    )
    if [[ "$mode" == prewarmed ]]; then
        args+=(
            --prewarmed-sandboxes "$benchmark_pool_vms"
            --max-concurrent-restores 1
            --warm-floor 1
            --ready-low-watermark "$ready_low_watermark"
            --ready-high-watermark "$ready_high_watermark"
            --max-replenish-batch 2
        )
    fi
    mkdir -p "$dir"
    LC_ALL=C lscpu |
        grep -E '^(CPU\(s\)|Socket|Core|Thread)' >"$dir/lscpu.txt"
    start_server "$dir/server.log" "${args[@]}"
    # Routed through the same spawn_hey_paused pause/release primitive as
    # every other hey launch site (see launch_hey_jobs), even though a
    # single job has nothing to stagger against itself: this keeps the
    # mechanism identical everywhere rather than special-casing the
    # legacy single-process benchmarks. Output is dumped to the console
    # after it completes (see print_demo_evidence's HEY OUTPUT section
    # too) rather than streamed live, matching how benchmark-resident/
    # benchmark-multi-app/benchmark-orchestrator-contract already present
    # their hey output.
    local legacy_hey_gate
    legacy_hey_gate="$(mktemp -u "${TMPDIR:-/tmp}/hyperlight-demo-hey-gate.XXXXXX")"
    rm -f "$legacy_hey_gate" 2>/dev/null
    spawn_hey_paused "$dir/hey.txt" "$legacy_hey_gate" 0 \
        -n "$benchmark_requests" -c "$benchmark_concurrency" \
        http://127.0.0.1:8787/sync
    local legacy_hey_pid=$!
    : >"$legacy_hey_gate"
    wait "$legacy_hey_pid"
    rm -f "$legacy_hey_gate" 2>/dev/null
    cat "$dir/hey.txt"
    grep -Eq "\\[200\\][[:space:]]+${benchmark_requests} responses" "$dir/hey.txt"
    wait_for_pool_quiescence "$mode" "$dir/pool-status.json"
    jq '{
            restore_mode,
            admitted,
            active,
            queued,
            ready,
            warm_floor,
            ready_low_watermark,
            ready_high_watermark,
            execution_slots_in_use,
            restore_slots_in_use,
            recycle_queue_depth,
            teardown_in_flight,
            completion_queue_depth,
            completion_in_flight,
            replenishment_paused,
            replenishment_pause_reason,
            refill_active,
            prewarmed_inventory,
            prewarmed_ready,
            prewarmed_replenishing
        }' "$dir/pool-status.json"
    stop_processes
    printf 'Compare demo-output/benchmark-on-demand/hey.txt and '
    printf 'demo-output/benchmark-prewarmed/hey.txt on this same host.\n'
}

run_benchmark_resident() {
    local dir="$output_dir/benchmark-resident"
    mkdir -p "$dir"
    LC_ALL=C lscpu | grep -E '^(CPU\(s\)|Socket|Core|Thread)' >"$dir/lscpu.txt"
    local t_start t_setup_done t_load_done t_results_done t_end
    local wave_active_seconds load_wall_seconds
    t_start="$(now_seconds)"
    local run_log="$dir/run.log"
    : >"$run_log"
    log_line "$run_log" "benchmark-resident start: apps=$benchmark_apps" \
        "load_requests=$benchmark_load_requests concurrency=$benchmark_concurrency" \
        "load_driver=$benchmark_load_driver" \
        "hey_max_parallel_jobs=$hey_max_parallel_jobs hey_ramp_ms=$hey_ramp_ms" \
        "benchmark_setup_parallel=$benchmark_setup_parallel max_requests_per_vm=unset(unbounded)" \
        "max_lifetime_secs=unset(unbounded)"

    local -a req_alloc conc_alloc
    allocate_evenly "$benchmark_load_requests" "$benchmark_apps" req_alloc
    allocate_evenly "$benchmark_concurrency" "$benchmark_apps" conc_alloc

    # Decide each app's concurrency first (same cap as before: never ask
    # for more concurrency than that app's proportional request share).
    local -a eff_conc
    local i
    for ((i = 0; i < benchmark_apps; i++)); do
        local c=$((conc_alloc[i] < req_alloc[i] ? conc_alloc[i] : req_alloc[i]))
        ((c > 0)) || c=1
        eff_conc[i]="$c"
    done
    local -a reqs_alloc_final
    local conservation_remainder=0
    if [[ "$benchmark_load_driver" == hey ]]; then
        # Then jointly allocate request counts across ALL apps at once so
        # every app's count stays an exact multiple of its OWN concurrency
        # (hey-achievable) while the grand total is still held to exactly
        # $benchmark_load_requests -- see allocate_requests_hey_achievable's
        # docstring for why snapping each app independently (as this used
        # to do) can silently under-deliver the user's requested total.
        # This hey-specific achievable-count snapping is not needed for
        # the vegeta driver below: vegeta delivers each app's exact
        # REQS_ARR[i] count via a finite target list (see
        # launch_vegeta_load), which has no per-app-concurrency
        # divisibility constraint to work around, so req_alloc's plain
        # even split is already exactly deliverable with zero remainder.
        allocate_requests_hey_achievable "$benchmark_load_requests" "$benchmark_apps" \
            eff_conc reqs_alloc_final conservation_remainder
    else
        reqs_alloc_final=("${req_alloc[@]}")
    fi
    log_line "$run_log" "request allocation: eff_conc=$(IFS=,; echo "${eff_conc[*]}")" \
        "reqs=$(IFS=,; echo "${reqs_alloc_final[*]}") conservation_remainder=$conservation_remainder"

    # Every app below boots the exact same bundle under the same shared
    # rootfs/executor/capability-policy, so one prewarmed snapshot covers
    # all of them: pay the boot+init cost once here, then every app
    # below restores from it (load -> init -> snapshot -> restore x N),
    # instead of each of the $benchmark_apps processes repeating its own
    # ~2s boot+init. This is what collapses the multi-minute setup phase
    # at large --benchmark-apps counts down to one prewarm plus N fast
    # restores.
    local bench_bundle="$root/examples/workerd-bundles/workerd-pool-benchmark.json"
    local snapshot_dir="$dir/prewarm-snapshot"
    # A prior run's snapshot directory is sealed read-only (every file and
    # directory under it, see WorkerdSnapshot::seal_or_check) so integrity
    # checks can verify it was not tampered with after saving. Plain `rm -rf`
    # cannot unlink entries from a read-only directory, so restore write
    # permission first; `|| true` tolerates a directory that does not exist yet.
    chmod -R u+w "$snapshot_dir" 2>/dev/null || true
    rm -rf "$snapshot_dir"
    printf 'preparing: building reusable resident-app snapshot (one-time boot+init)...\n'
    prewarm_shared_snapshot "$run_log" "$bench_bundle" "$snapshot_dir" || return 1
    phase_message "setup: generating $benchmark_apps configs in one batch (startup parallelism=$benchmark_setup_parallel)"
    write_resident_benchmark_configs "$dir" "$bench_bundle" "$snapshot_dir" eff_conc
    phase_message "setup: starting resident hosts (up to $benchmark_setup_parallel concurrent restores)"

    # Starting each resident app forks its own `hluk workerd-host`
    # process (restoring from the shared $snapshot_dir instead of
    # fresh-booting) and polls it for readiness. Up to
    # $benchmark_setup_parallel of these are forked together before any
    # of them are waited on, so independent restores proceed concurrently
    # across available cores instead of serializing one app's full
    # fork/restore/ready-poll behind the next's (set
    # --benchmark-setup-parallel 1 to restore the original fully serial
    # behavior). log_line only writes to run.log, not stdout, so a live
    # run otherwise prints nothing and looks hung even while it is
    # steadily making progress; print_progress_bar below renders this on
    # stdout so it is visibly not stuck.
    local -a reqs concs urls hosts timeouts outfiles statuses status_files
    local -a app_dirs app_binds app_t0s
    local launch_elapsed_start="$SECONDS"
    local launch_progress_step=$(((benchmark_apps + 39) / 40))
    local batch_start batch_end
    for ((batch_start = 0; batch_start < benchmark_apps; batch_start += benchmark_setup_parallel)); do
        batch_end=$((batch_start + benchmark_setup_parallel))
        ((batch_end <= benchmark_apps)) || batch_end="$benchmark_apps"

        # Phase 1: build each app's config and fork its process without
        # waiting for readiness.
        for ((i = batch_start; i < batch_end; i++)); do
            local app_dir="$dir/app-$i"
            local port=$((8320 + i))
            local bind="127.0.0.1:$port"
            local conc="${eff_conc[i]}"
            local queue_capacity=64
            ((conc * 4 > queue_capacity)) && queue_capacity=$((conc * 4))
            log_line "$run_log" "app bench-$i config generated: pool=resident capacity=$conc" \
                "queue_capacity=$queue_capacity bind=$bind requests=${req_alloc[i]}"
            app_dirs[i]="$app_dir"
            app_binds[i]="$bind"
            app_t0s[i]="$(now_seconds)"
            if ((i == 0)); then
                start_workerd_host_nowait "$app_dir/server.log" "$app_dir/config.json" "$bind"
            else
                start_workerd_host_extra_nowait "$app_dir/server.log" "$app_dir/config.json" "$bind"
            fi
            reqs[i]="${reqs_alloc_final[i]}"
            concs[i]="$conc"
            urls[i]="http://$bind/sync"
            hosts[i]="bench.resident.test"
            timeouts[i]=30
            outfiles[i]="$app_dir/hey.txt"
            status_files[i]="$app_dir/status.json"
            if (((i + 1) % launch_progress_step == 0 || i + 1 == benchmark_apps)); then
                print_progress_bar "$((i + 1))" "$benchmark_apps" "setup: resident hosts launched" \
                    "$((SECONDS - launch_elapsed_start))"
            fi
        done

        # Poll every host in this batch concurrently, retaining each
        # poller's PID so failure/interrupt cleanup still owns it.
        local -a ready_pids=() ready_tracks=()
        for ((i = batch_start; i < batch_end; i++)); do
            local app_pid=$((i == 0 ? demo_pid : extra_pids[i - 1]))
            wait_for_workerd_host_ready "${app_dirs[i]}/server.log" "${app_binds[i]}" "$app_pid" &
            ready_pids+=("$!")
        done
        for app_pid in "${ready_pids[@]}"; do
            ready_tracks+=("${#extra_pids[@]}")
            extra_pids+=("$app_pid")
        done
        for ((i = batch_start; i < batch_end; i++)); do
            local app_dir="${app_dirs[i]}" bind="${app_binds[i]}"
            local app_pid=$((i == 0 ? demo_pid : extra_pids[i - 1]))
            wait "${ready_pids[i - batch_start]}"
            local app_t1
            app_t1="$(now_seconds)"
            log_line "$run_log" "app bench-$i launched: pid=$app_pid bind=$bind" \
                "server_log=$app_dir/server.log"
            log_line "$run_log" "app bench-$i ready: elapsed=$(seconds_between "${app_t0s[i]}" "$app_t1")s"
            print_progress_bar "$((i + 1))" "$benchmark_apps" "setup: resident hosts ready" \
                "$(printf '%.0f' "$(seconds_between "$t_start" "$app_t1")")"
        done
        for app_pid in "${ready_tracks[@]}"; do unset "extra_pids[$app_pid]"; done
        extra_pids=("${extra_pids[@]}")
    done

    # If the per-app concurrency values could not express the full
    # requested total exactly (see allocate_requests_hey_achievable's
    # docstring -- e.g. every app shares one identical concurrency and the
    # deficit isn't a multiple of it), cover the shortfall with one extra
    # concurrency-1 job against the first app: a concurrency-1 hey
    # invocation always delivers exactly the count asked for (n/1 has no
    # remainder to truncate), so this always restores exact conservation,
    # and it is reported as its own distinct, clearly-labeled app summary
    # row rather than folded invisibly into another app's numbers.
    if ((conservation_remainder > 0)); then
        local remainder_idx="$benchmark_apps"
        reqs[remainder_idx]="$conservation_remainder"
        concs[remainder_idx]=1
        urls[remainder_idx]="${urls[0]}"
        hosts[remainder_idx]="${hosts[0]}"
        timeouts[remainder_idx]="${timeouts[0]}"
        outfiles[remainder_idx]="$dir/conservation-remainder-hey.txt"
        log_line "$run_log" "conservation remainder: $conservation_remainder request(s) could not be" \
            "expressed as a non-negative combination of any app's own concurrency;" \
            "covering via one extra concurrency-1 hey job against bench-0"
    fi

    t_setup_done="$(now_seconds)"
    log_line "$run_log" "setup phase complete: elapsed=$(seconds_between "$t_start" "$t_setup_done")s"
    log_line "$run_log" "load phase start: $benchmark_apps apps, $benchmark_load_requests total requests," \
        "driver=$benchmark_load_driver"
    if [[ "$benchmark_load_driver" == vegeta ]]; then
        launch_vegeta_load reqs concs urls hosts timeouts outfiles statuses "$run_log" \
            "$dir" "$benchmark_concurrency" wave_active_seconds load_wall_seconds
    else
        launch_hey_jobs reqs concs urls hosts timeouts outfiles statuses "$run_log" \
            wave_active_seconds load_wall_seconds
    fi
    t_load_done="$(now_seconds)"
    log_line "$run_log" "load phase complete: elapsed=$(seconds_between "$t_setup_done" "$t_load_done")s" \
        "wave_active_seconds=${wave_active_seconds}s load_wall_seconds=${load_wall_seconds}s"

    local -a app_ids cmds
    # Collected as a plain bash array of JSON object strings, not folded
    # into a growing JSON array one jq invocation at a time: folding would
    # re-parse and re-serialize an array that grows up to $benchmark_apps
    # elements on every single iteration (O(n^2) jq work, plus one extra
    # process fork per app), which is needless at the thousands-of-apps
    # scale this loop is meant to handle. Joined into one real JSON array
    # via a single `jq -cs` slurp after the loop instead (see below).
    local -a app_summary_list=()
    local -a vegeta_summaries=() status_args=()
    if [[ "$benchmark_load_driver" == vegeta ]]; then
        mapfile -t vegeta_summaries <"$dir/vegeta-app-summaries.jsonl"
    fi
    for ((i = 0; i < benchmark_apps; i++)); do
        ((i == 0)) || status_args+=(--next)
        status_args+=(--fail-with-body --silent --show-error --max-time 30
            --output "${status_files[i]}" "http://127.0.0.1:$((8320 + i))/__hyperlight/status")
    done
    run_with_progress "post-load: parallel host status collection" \
        curl --parallel --parallel-max "$benchmark_setup_parallel" "${status_args[@]}"
    local results_start="$SECONDS"
    local results_progress_step=$(((benchmark_apps + 39) / 40))
    for ((i = 0; i < benchmark_apps; i++)); do
        # These used to be bare `[[ ]]`/`grep -Eq` relying on `set -e` to
        # abort: that prints nothing to stdout/stderr, so run_one's
        # top-level per-demo log (which only captures this function's own
        # stdout/stderr, not the separate run_log that log_line writes to)
        # was left empty on failure. Printing the diagnostic to stderr
        # here ensures it lands in both logs.
        if [[ "${statuses[i]}" != 0 ]]; then
            log_line "$run_log" "FAILURE: app bench-$i $benchmark_load_driver exit=${statuses[i]}" \
                "see ${outfiles[i]} and $dir/app-$i/server.log"
            printf 'FAILURE: app bench-%d %s exited %s (see %s and %s)\n' \
                "$i" "$benchmark_load_driver" "${statuses[i]}" "${outfiles[i]}" "$dir/app-$i/server.log" >&2
            return 1
        fi
        if [[ "$benchmark_load_driver" == hey ]] && ((reqs[i] > 0)) &&
            ! grep -Eq "\\[200\\][[:space:]]+${reqs[i]} responses" "${outfiles[i]}"; then
            log_line "$run_log" "FAILURE: app bench-$i did not report ${reqs[i]} 200 responses" \
                "see ${outfiles[i]} and $dir/app-$i/server.log"
            printf 'FAILURE: app bench-%d did not report [200] %s responses (see %s and %s)\n' \
                "$i" "${reqs[i]}" "${outfiles[i]}" "$dir/app-$i/server.log" >&2
            tail -n 10 "${outfiles[i]}" | sed 's/^/  /' >&2
            return 1
        fi
        local one
        if [[ "$benchmark_load_driver" == vegeta ]]; then
            one="${vegeta_summaries[i]}"
        else
            one="$(build_app_summary "bench-$i" "${reqs[i]}" "${concs[i]}" "${outfiles[i]}")"
        fi
        app_summary_list+=("$one")
        app_ids[i]="bench-$i"
        if [[ "$benchmark_load_driver" == vegeta ]]; then
            cmds[i]="vegeta attack (shared, see $dir/run.log) target: GET ${urls[i]} Host: ${hosts[i]}"
        else
            cmds[i]="hey -n ${reqs[i]} -c ${concs[i]} -t ${timeouts[i]} -host ${hosts[i]} ${urls[i]}"
        fi
        if (((i + 1) % results_progress_step == 0 || i + 1 == benchmark_apps)); then
            print_progress_bar "$((i + 1))" "$benchmark_apps" \
                "post-load: host status/reports collected" "$((SECONDS - results_start))"
        fi
    done

    if ((conservation_remainder > 0)); then
        local remainder_idx="$benchmark_apps"
        if [[ "${statuses[remainder_idx]}" != 0 ]]; then
            log_line "$run_log" "FAILURE: conservation-remainder hey job exit=${statuses[remainder_idx]}" \
                "see ${outfiles[remainder_idx]}"
            printf 'FAILURE: conservation-remainder hey job exited %s (see %s)\n' \
                "${statuses[remainder_idx]}" "${outfiles[remainder_idx]}" >&2
            return 1
        fi
        if ! grep -Eq "\\[200\\][[:space:]]+${conservation_remainder} responses" "${outfiles[remainder_idx]}"; then
            log_line "$run_log" "FAILURE: conservation-remainder hey job did not report ${conservation_remainder} 200 responses" \
                "see ${outfiles[remainder_idx]}"
            printf 'FAILURE: conservation-remainder hey job did not report [200] %s responses (see %s)\n' \
                "$conservation_remainder" "${outfiles[remainder_idx]}" >&2
            tail -n 10 "${outfiles[remainder_idx]}" | sed 's/^/  /' >&2
            return 1
        fi
        local remainder_one
        remainder_one="$(build_app_summary "bench-0-remainder" "$conservation_remainder" 1 "${outfiles[remainder_idx]}")"
        app_summary_list+=("$remainder_one")
        app_ids[remainder_idx]="bench-0-remainder"
        cmds[remainder_idx]="hey -n ${reqs[remainder_idx]} -c ${concs[remainder_idx]} -t ${timeouts[remainder_idx]} -host ${hosts[remainder_idx]} ${urls[remainder_idx]}"
        log_line "$run_log" "conservation remainder covered: bench-0-remainder reported ${conservation_remainder} 200 responses"
    fi

    local app_summaries
    app_summaries="$(printf '%s\n' "${app_summary_list[@]}" | jq -cs '.')"

    write_collected_hey_report "$dir/hey.txt" app_ids urls cmds outfiles "$benchmark_load_driver"
    jq -s '.' "$dir"/app-*/status.json >"$dir/status.json"
    jq -c '.[]' "$dir/status.json" >>"$run_log"
    t_results_done="$(now_seconds)"
    log_line "$run_log" "post-load results collection complete: elapsed=$(seconds_between "$t_load_done" "$t_results_done")s"
    log_line "$run_log" "shutdown start"
    phase_message "shutdown: stopping $benchmark_apps resident hosts"
    stop_processes
    t_end="$(now_seconds)"
    log_line "$run_log" "shutdown complete: elapsed=$(seconds_between "$t_results_done" "$t_end")s"
    local timing_json
    timing_json="$(make_phase_timing \
        "$(seconds_between "$t_start" "$t_setup_done")" \
        "$(seconds_between "$t_setup_done" "$t_load_done")" \
        "$(seconds_between "$t_results_done" "$t_end")" \
        "$(seconds_between "$t_start" "$t_end")" \
        "$wave_active_seconds" "$load_wall_seconds" \
        "$(seconds_between "$t_load_done" "$t_results_done")")"
    local effective_max_parallel="$hey_max_parallel_jobs"
    [[ "$benchmark_load_driver" == vegeta ]] && effective_max_parallel=0
    write_benchmark_summary "benchmark-resident" "$app_summaries" "$timing_json" \
        "$effective_max_parallel" "$dir/summary.json" "$benchmark_load_driver"
    if [[ "$benchmark_load_driver" == vegeta ]]; then
        jq --slurpfile report "$dir/vegeta-report.json" '.vegeta = $report[0]' \
            "$dir/summary.json" >"$dir/summary.json.tmp"
        mv "$dir/summary.json.tmp" "$dir/summary.json"
    fi
    log_line "$run_log" "benchmark-resident complete: total_elapsed=$(seconds_between "$t_start" "$t_end")s"
    echo "All $benchmark_load_requests requests across $benchmark_apps independent resident apps succeeded; see $dir/summary.json, $dir/hey.txt, and $run_log"
}

run_benchmark_multi_app() {
    local dir="$output_dir/benchmark-multi-app"
    mkdir -p "$dir"
    LC_ALL=C lscpu | grep -E '^(CPU\(s\)|Socket|Core|Thread)' >"$dir/lscpu.txt"
    local bind=127.0.0.1:8330
    local t_start t_setup_done t_load_done t_end
    local wave_active_seconds load_wall_seconds
    t_start="$(now_seconds)"
    local run_log="$dir/run.log"
    : >"$run_log"
    log_line "$run_log" "benchmark-multi-app start: apps=$benchmark_apps" \
        "load_requests=$benchmark_load_requests concurrency=$benchmark_concurrency" \
        "hey_max_parallel_jobs=$hey_max_parallel_jobs hey_ramp_ms=$hey_ramp_ms" \
        "resident(even)=max_requests_per_vm=unset max_lifetime_secs=unset" \
        "disposable(odd)=one sandbox per request, no pool lifecycle limits"

    local -a req_alloc conc_alloc
    allocate_evenly "$benchmark_load_requests" "$benchmark_apps" req_alloc
    allocate_evenly "$benchmark_concurrency" "$benchmark_apps" conc_alloc

    # Same joint request/concurrency allocation as run_benchmark_resident
    # (see allocate_requests_hey_achievable's docstring): decide each
    # app's concurrency first, then allocate request counts across ALL
    # apps at once so every app's count is hey-achievable while the grand
    # total still sums to exactly $benchmark_load_requests.
    local -a eff_conc
    local i
    for ((i = 0; i < benchmark_apps; i++)); do
        local c=$((conc_alloc[i] < req_alloc[i] ? conc_alloc[i] : req_alloc[i]))
        ((c > 0)) || c=1
        eff_conc[i]="$c"
    done
    local -a reqs_alloc_final
    local conservation_remainder
    allocate_requests_hey_achievable "$benchmark_load_requests" "$benchmark_apps" \
        eff_conc reqs_alloc_final conservation_remainder
    log_line "$run_log" "request allocation: eff_conc=$(IFS=,; echo "${eff_conc[*]}")" \
        "reqs=$(IFS=,; echo "${reqs_alloc_final[*]}") conservation_remainder=$conservation_remainder"

    local -a app_json_lines
    for ((i = 0; i < benchmark_apps; i++)); do
        local pool
        if ((i % 2 == 0)); then
            pool="$(jq -n '{kind:"resident", capacity:4, queue_capacity:64, max_requests_per_vm:null, max_lifetime_secs:null}')"
        else
            pool="$(jq -n '{kind:"disposable", max_concurrent_sandboxes:4, queue_capacity:64}')"
        fi
        app_json_lines+=("$(app_config "app-$i" "app-$i.bench" \
            "$root/examples/workerd-bundles/workerd-pool-benchmark.json" "$pool")")
        local pool_kind
        ((i % 2 == 0)) && pool_kind="resident" || pool_kind="disposable"
        log_line "$run_log" "app app-$i config generated: pool=$pool_kind"
    done
    local apps_json
    apps_json="$(printf '%s\n' "${app_json_lines[@]}" | jq -s '.')"
    write_host_config "$dir/config.json" "$apps_json"
    local proc_t0 proc_t1
    proc_t0="$(now_seconds)"
    start_workerd_host "$dir/server.log" "$dir/config.json" "$bind"
    proc_t1="$(now_seconds)"
    log_line "$run_log" "shared process launched: pid=$demo_pid bind=$bind" \
        "server_log=$dir/server.log apps=$benchmark_apps"
    log_line "$run_log" "shared process ready: elapsed=$(seconds_between "$proc_t0" "$proc_t1")s"

    local -a reqs concs urls hosts timeouts outfiles statuses
    for ((i = 0; i < benchmark_apps; i++)); do
        local conc="${eff_conc[i]}"
        reqs[i]="${reqs_alloc_final[i]}"
        concs[i]="$conc"
        urls[i]="http://$bind/sync"
        hosts[i]="app-$i.bench"
        timeouts[i]=30
        outfiles[i]="$dir/app-$i-hey.txt"
    done

    # See the identical conservation-remainder handling in
    # run_benchmark_resident: cover any leftover that the per-app
    # concurrency values couldn't express exactly with one extra
    # concurrency-1 job (always exact, no truncation risk) against app-0.
    if ((conservation_remainder > 0)); then
        local remainder_idx="$benchmark_apps"
        reqs[remainder_idx]="$conservation_remainder"
        concs[remainder_idx]=1
        urls[remainder_idx]="${urls[0]}"
        hosts[remainder_idx]="${hosts[0]}"
        timeouts[remainder_idx]="${timeouts[0]}"
        outfiles[remainder_idx]="$dir/conservation-remainder-hey.txt"
        log_line "$run_log" "conservation remainder: $conservation_remainder request(s) could not be" \
            "expressed as a non-negative combination of any app's own concurrency;" \
            "covering via one extra concurrency-1 hey job against app-0"
    fi

    t_setup_done="$(now_seconds)"
    log_line "$run_log" "setup phase complete: elapsed=$(seconds_between "$t_start" "$t_setup_done")s"
    log_line "$run_log" "load phase start: $benchmark_apps apps, $benchmark_load_requests total requests"
    launch_hey_jobs reqs concs urls hosts timeouts outfiles statuses "$run_log" \
        wave_active_seconds load_wall_seconds
    t_load_done="$(now_seconds)"
    log_line "$run_log" "load phase complete: elapsed=$(seconds_between "$t_setup_done" "$t_load_done")s" \
        "wave_active_seconds=${wave_active_seconds}s load_wall_seconds=${load_wall_seconds}s"

    local -a app_ids addrs cmds
    local -a app_summary_list=()
    for ((i = 0; i < benchmark_apps; i++)); do
        # See the identical comment in run_benchmark_resident: a bare
        # `[[ ]]`/`grep -Eq` assertion here prints nothing on failure, so
        # the top-level per-demo log stayed empty. Print the diagnostic to
        # stderr so it lands there.
        if [[ "${statuses[i]}" != 0 ]]; then
            log_line "$run_log" "FAILURE: app app-$i hey exit=${statuses[i]}" \
                "see ${outfiles[i]} and $dir/server.log"
            printf 'FAILURE: app app-%d hey exited %s (see %s and %s)\n' \
                "$i" "${statuses[i]}" "${outfiles[i]}" "$dir/server.log" >&2
            return 1
        fi
        if ((reqs[i] > 0)) &&
            ! grep -Eq "\\[200\\][[:space:]]+${reqs[i]} responses" "${outfiles[i]}"; then
            log_line "$run_log" "FAILURE: app app-$i did not report ${reqs[i]} 200 responses" \
                "see ${outfiles[i]} and $dir/server.log"
            printf 'FAILURE: app app-%d did not report [200] %s responses (see %s and %s)\n' \
                "$i" "${reqs[i]}" "${outfiles[i]}" "$dir/server.log" >&2
            tail -n 10 "${outfiles[i]}" | sed 's/^/  /' >&2
            return 1
        fi
        local one
        one="$(build_app_summary "app-$i" "${reqs[i]}" "${concs[i]}" "${outfiles[i]}")"
        app_summary_list+=("$one")
        app_ids[i]="app-$i"
        addrs[i]="${urls[i]} (Host: ${hosts[i]})"
        cmds[i]="hey -n ${reqs[i]} -c ${concs[i]} -t ${timeouts[i]} -host ${hosts[i]} ${urls[i]}"
    done

    if ((conservation_remainder > 0)); then
        local remainder_idx="$benchmark_apps"
        if [[ "${statuses[remainder_idx]}" != 0 ]]; then
            log_line "$run_log" "FAILURE: conservation-remainder hey job exit=${statuses[remainder_idx]}" \
                "see ${outfiles[remainder_idx]}"
            printf 'FAILURE: conservation-remainder hey job exited %s (see %s)\n' \
                "${statuses[remainder_idx]}" "${outfiles[remainder_idx]}" >&2
            return 1
        fi
        if ! grep -Eq "\\[200\\][[:space:]]+${conservation_remainder} responses" "${outfiles[remainder_idx]}"; then
            log_line "$run_log" "FAILURE: conservation-remainder hey job did not report ${conservation_remainder} 200 responses" \
                "see ${outfiles[remainder_idx]}"
            printf 'FAILURE: conservation-remainder hey job did not report [200] %s responses (see %s)\n' \
                "$conservation_remainder" "${outfiles[remainder_idx]}" >&2
            tail -n 10 "${outfiles[remainder_idx]}" | sed 's/^/  /' >&2
            return 1
        fi
        local remainder_one
        remainder_one="$(build_app_summary "app-0-remainder" "$conservation_remainder" 1 "${outfiles[remainder_idx]}")"
        app_summary_list+=("$remainder_one")
        app_ids[remainder_idx]="app-0-remainder"
        addrs[remainder_idx]="${urls[remainder_idx]} (Host: ${hosts[remainder_idx]})"
        cmds[remainder_idx]="hey -n ${reqs[remainder_idx]} -c ${concs[remainder_idx]} -t ${timeouts[remainder_idx]} -host ${hosts[remainder_idx]} ${urls[remainder_idx]}"
        log_line "$run_log" "conservation remainder covered: app-0-remainder reported ${conservation_remainder} 200 responses"
    fi

    local app_summaries
    app_summaries="$(printf '%s\n' "${app_summary_list[@]}" | jq -cs '.')"

    curl --fail-with-body --silent --show-error \
        --header "Host: app-0.bench" \
        "http://$bind/__hyperlight/status" >"$dir/status.json"
    jq -e --argjson expected "$benchmark_apps" 'length == $expected' "$dir/status.json" >/dev/null
    log_line "$run_log" "pool status ($benchmark_apps apps): $(jq -c . "$dir/status.json")"

    write_collected_hey_report "$dir/hey.txt" app_ids addrs cmds outfiles
    log_line "$run_log" "shutdown start"
    stop_processes
    t_end="$(now_seconds)"
    log_line "$run_log" "shutdown complete: elapsed=$(seconds_between "$t_load_done" "$t_end")s"
    local timing_json
    timing_json="$(make_phase_timing \
        "$(seconds_between "$t_start" "$t_setup_done")" \
        "$(seconds_between "$t_setup_done" "$t_load_done")" \
        "$(seconds_between "$t_load_done" "$t_end")" \
        "$(seconds_between "$t_start" "$t_end")" \
        "$wave_active_seconds" "$load_wall_seconds")"
    write_benchmark_summary "benchmark-multi-app" "$app_summaries" "$timing_json" \
        "$hey_max_parallel_jobs" "$dir/summary.json"
    log_line "$run_log" "benchmark-multi-app complete: total_elapsed=$(seconds_between "$t_start" "$t_end")s"
    echo "All $benchmark_load_requests requests across $benchmark_apps routed apps succeeded, one process and port; see $dir/summary.json, $dir/hey.txt, and $run_log"
}

# classify_post_signal_probe CURL_EXIT HTTP_CODE
#
# Pure classification for the post-SIGTERM readyz probe in
# run_benchmark_orchestrator_contract, below. workerd-host's accept loop
# checks its shutting-down flag before each accept() and never admits a
# new connection once SIGTERM is observed, so a connection attempted
# after the signal gets no live HTTP response at all until the process
# actually exits and the OS drops the listening socket. Depending on the
# exact race between the probe's connect() and the process's exit, curl
# can observe that as a timeout (28), connection refused (7), an empty
# reply (52), or a reset (56) -- all four have been reproduced live in
# this exact probe and all four are equally "no new connection was
# admitted", so all four classify as the expected "no_response" outcome.
# Only an actual HTTP response (exit 0) is a genuine contract violation:
# 200 means a new connection was admitted after SIGTERM; any other status
# means readyz answered when the contract says it must not respond at
# all. Any other curl exit code (DNS failure, TLS error, malformed URL,
# etc.) is not one of the documented "no admission" failure modes and is
# classified as unexpected_error so it surfaces loudly instead of being
# silently folded into the expected outcome. This narrow, single-purpose
# helper is the only place that treats curl exit 28 (or 7/52/56) as
# expected; the pure validate_benchmark_flags above and the nearby
# admitted_status probe (which deliberately keeps its own unrelated
# `2>/dev/null || echo '[]'` fallback) are untouched, so a curl timeout
# elsewhere in this script is never silently ignored by this change.
classify_post_signal_probe() {
    local curl_exit="$1" http_code="$2"
    case "$curl_exit" in
        0)
            if [[ "$http_code" == 200 ]]; then
                echo "unexpected_200"
            else
                echo "unexpected_http_$http_code"
            fi
            ;;
        7 | 28 | 52 | 56)
            echo "no_response"
            ;;
        *)
            echo "unexpected_error"
            ;;
    esac
}

# Resolves phase B's (concurrency, request-count) pair for one app of
# run_benchmark_orchestrator_contract's drain benchmark, given that app's
# share of total --benchmark-concurrency (conc_alloc_for_app) and its share
# of the phase-B ~25% load split (phase_b_alloc_for_app). conc is capped to
# phase_b_alloc_for_app (an app with a tiny total shouldn't claim more
# concurrency than it has work allocated), floored to 1. reqs is *always*
# set equal to that capped conc, never to phase_b_alloc_for_app: phase B
# must be exactly one synchronized wave of `conc` requests that all become
# in-flight before SIGTERM (see the admit-wait loop below), not a longer
# queue where only the first wave is in flight when the signal fires and
# the rest race a listener that is about to close. Printed as "conc reqs"
# so callers can `read -r conc reqs < <(...)`.
resolve_phase_b_batch() {
    local conc_alloc_for_app="$1" phase_b_alloc_for_app="$2"
    local conc=$((conc_alloc_for_app < phase_b_alloc_for_app ? conc_alloc_for_app : phase_b_alloc_for_app))
    ((conc > 0)) || conc=1
    printf '%s %s\n' "$conc" "$conc"
}

run_benchmark_orchestrator_contract() {
    local dir="$output_dir/benchmark-orchestrator-contract"
    mkdir -p "$dir"
    local bind=127.0.0.1:8331

    local -a total_alloc
    allocate_evenly "$benchmark_load_requests" "$benchmark_apps" total_alloc

    local -a app_json_lines
    local i
    for ((i = 0; i < benchmark_apps; i++)); do
        local pool
        pool="$(jq -n '{kind:"disposable", max_concurrent_sandboxes:4, queue_capacity:64}')"
        app_json_lines+=("$(app_config "drain-$i" "drain-$i.bench" \
            "$root/examples/workerd-bundles/workerd-drain-benchmark.json" "$pool")")
    done
    local apps_json
    apps_json="$(printf '%s\n' "${app_json_lines[@]}" | jq -s '.')"
    write_host_config "$dir/config.json" "$apps_json"
    start_workerd_host "$dir/server.log" "$dir/config.json" "$bind" \
        --drain-timeout-ms 5000

    # Phase A/B split: ~75% of each app's allocation goes to the pre-drain
    # /sync reference load; the remaining ~25% (floor 1, borrowed from
    # Phase A when an app's total is very small) goes to /drain and is
    # launched right before SIGTERM, proving in-flight admitted work still
    # completes.
    local -a phase_a_alloc phase_b_alloc
    for ((i = 0; i < benchmark_apps; i++)); do
        local total="${total_alloc[i]}"
        local b=$((total / 4))
        ((b >= 1)) || b=1
        ((b <= total)) || b="$total"
        phase_a_alloc[i]=$((total - b))
        phase_b_alloc[i]="$b"
    done

    local -a conc_alloc
    allocate_evenly "$benchmark_concurrency" "$benchmark_apps" conc_alloc

    # Phase A: foreground, run to completion as the pre-drain reference.
    #
    # hey truncates its own request count to a multiple of -c when -n isn't
    # evenly divisible by -c (observed: `hey -n 75 -c 4` sends only 72, not
    # 75), so the allocated request count is snapped down to the nearest
    # multiple of its concurrency here (snap_reqs_to_hey_achievable, shared
    # with benchmark-resident and benchmark-multi-app), before launching
    # hey or asserting on its output, rather than asserting on the
    # originally allocated count and then failing against hey's own silent
    # truncation.
    local -a a_reqs a_concs a_urls a_hosts a_timeouts a_outfiles a_statuses
    for ((i = 0; i < benchmark_apps; i++)); do
        local conc=$((conc_alloc[i] < phase_a_alloc[i] ? conc_alloc[i] : phase_a_alloc[i]))
        ((conc > 0)) || conc=1
        a_reqs[i]="$(snap_reqs_to_hey_achievable "${phase_a_alloc[i]}" "$conc")"
        a_concs[i]="$conc"
        a_urls[i]="http://$bind/sync"
        a_hosts[i]="drain-$i.bench"
        a_timeouts[i]=30
        a_outfiles[i]="$dir/app-$i-phase-a.txt"
    done
    launch_hey_jobs a_reqs a_concs a_urls a_hosts a_timeouts a_outfiles a_statuses

    local -a pre_apps_list=()
    for ((i = 0; i < benchmark_apps; i++)); do
        # Every assertion in this function used to be a bare `[[ ]]`/
        # `grep -Eq`/`jq -e` relying on `set -e` to abort on failure: none
        # of those print anything, so a failure here left the demo's raw
        # log completely empty and the presenter's "FAIL + LAST 30 LOG
        # LINES" had nothing to show. Printing a diagnostic immediately
        # before each explicit `return 1` below ensures the log always
        # captures which app/phase/assertion failed and why.
        if [[ "${a_statuses[i]}" != 0 ]]; then
            printf 'phase A: app %d hey exited %s (see %s)\n' \
                "$i" "${a_statuses[i]}" "${a_outfiles[i]}" >&2
            return 1
        fi
        if ((a_reqs[i] > 0)) &&
            ! grep -Eq "\\[200\\][[:space:]]+${a_reqs[i]} responses" "${a_outfiles[i]}"; then
            printf 'phase A: app %d did not report [200] %s responses (see %s)\n' \
                "$i" "${a_reqs[i]}" "${a_outfiles[i]}" >&2
            tail -n 10 "${a_outfiles[i]}" | sed 's/^/  /' >&2
            return 1
        fi
        local one
        one="$(build_app_summary "drain-$i" "${a_reqs[i]}" "${a_concs[i]}" "${a_outfiles[i]}")"
        pre_apps_list+=("$one")
    done
    local pre_apps
    pre_apps="$(printf '%s\n' "${pre_apps_list[@]}" | jq -cs '.')"
    write_benchmark_summary "pre-drain" "$pre_apps" null 0 "$dir/pre-drain-summary.json"

    curl --fail-with-body --silent --show-error \
        "http://$bind/__hyperlight/healthz" >"$dir/healthz.json"
    jq -e '.status == "ok"' "$dir/healthz.json" >/dev/null
    curl --fail-with-body --silent --show-error \
        "http://$bind/__hyperlight/readyz" >"$dir/readyz-before.json"
    jq -e '.status == "ready"' "$dir/readyz-before.json" >/dev/null
    curl --fail-with-body --silent --show-error \
        --header "Host: drain-0.bench" \
        "http://$bind/__hyperlight/status" >"$dir/status.json"
    jq -e --argjson expected "$benchmark_apps" 'length == $expected' "$dir/status.json" >/dev/null

    # Phase B: launch the in-flight /drain batch in the background, give it
    # a head start to actually connect and be accepted/dispatched before
    # signaling: workerd-host's accept loop checks its shutdown flag before
    # each `accept()`, so a connection that has not yet been accepted when
    # the flag flips is never admitted and fails with a connection error
    # instead of draining. `tests/workerd_host_contract.rs`'s equivalent
    # test gets away with a fixed 30ms sleep because it dispatches the
    # in-flight request from an in-process thread; here each app's head
    # start is an external `hey` process, whose fork/exec and Go-runtime
    # startup latency is not bounded by a fixed sleep (observed, under WSL2
    # load, to occasionally exceed 30ms for one app while a later-launched
    # app's process happens to start faster). So instead of sleeping a
    # fixed duration, poll each app's real `/status` admitted-work counters
    # (active+queued) and only signal once every app shows at least one
    # in-flight request, bounded by a generous timeout; a timeout here
    # means a real failure to admit, which the grep assertions below will
    # then correctly surface as a demo FAIL rather than mask. Every app's
    # hey is still spawned paused and released together via
    # spawn_hey_paused (plus the usual hey_ramp_ms stagger when set), but
    # M is bounded by --benchmark-apps and documented to stay small, and
    # this phase must return control immediately to poll admission state
    # rather than block until hey exits, so it intentionally does not
    # route through launch_hey_jobs itself (which always waits out a full
    # wave before returning, and would wave-split for M > hey_max_parallel_jobs).
    local -a b_pids b_reqs b_concs b_outfiles
    local b_gate
    b_gate="$(mktemp -u "${TMPDIR:-/tmp}/hyperlight-demo-hey-gate.XXXXXX")"
    rm -f "$b_gate" 2>/dev/null
    for ((i = 0; i < benchmark_apps; i++)); do
        # See resolve_phase_b_batch above: reqs is always set equal to
        # conc (never to phase_b_alloc[i]'s full share of the load), so
        # that every phase-B request is part of the single
        # admitted-and-signaled wave the admit-wait loop below proves,
        # rather than racing a listener that is about to close. At the
        # default scale (benchmark_apps == benchmark_concurrency, so
        # conc_alloc[i] == 1 while phase_b_alloc[i] is in the hundreds)
        # the old reqs = floor(phase_b_alloc[i]/conc)*conc formula sent
        # hundreds of requests per app when only the first could ever be
        # in flight at signal time, and the grep assertion below failed
        # non-deterministically.
        local conc reqs
        read -r conc reqs < <(resolve_phase_b_batch "${conc_alloc[i]}" "${phase_b_alloc[i]}")
        b_reqs[i]="$reqs"
        b_concs[i]="$conc"
        b_outfiles[i]="$dir/app-$i-phase-b.txt"
        local b_release_sleep="0"
        if ((hey_ramp_ms > 0)); then
            local b_offset_ms=$((i * hey_ramp_ms))
            b_release_sleep="$(printf '%d.%03d' \
                $((b_offset_ms / 1000)) $((b_offset_ms % 1000)))"
        fi
        spawn_hey_paused "${b_outfiles[i]}" "$b_gate" "$b_release_sleep" \
            -n "${b_reqs[i]}" -c "$conc" -t 30 \
            -host "drain-$i.bench" "http://$bind/drain"
        b_pids[i]=$!
    done
    : >"$b_gate"

    # workerd-host's accept loop admits at most one new TCP connection per
    # listener per polling tick (not a backlog-draining loop), so a burst of
    # b_concs[i] concurrent connections per app is admitted gradually, not
    # all at once. Waiting for just one admitted request per app (as before)
    # lets SIGTERM race the rest of that same burst while they are still
    # sitting unaccepted in the OS backlog: the accept loop exits on the
    # very next tick once shutting_down is observed and never accepts them,
    # so they get reset when the listener is dropped at process exit,
    # instead of draining as admitted in-flight work. Waiting for the full
    # per-app concurrency to be admitted (not merely >= 1) ensures the whole
    # intended "in flight at signal time" batch has actually been accepted
    # before SIGTERM fires, matching what this phase documents proving.
    local admit_deadline=$((SECONDS + 10))
    while true; do
        local admitted_status all_admitted=1
        admitted_status="$(curl --silent --show-error --max-time 1 \
            --header "Host: drain-0.bench" "http://$bind/__hyperlight/status" 2>/dev/null || echo '[]')"
        for ((i = 0; i < benchmark_apps; i++)); do
            local in_flight
            in_flight="$(jq -r --arg id "drain-$i" \
                '[.[] | select(.app_id == $id) | (.active + .queued)] | add // 0' \
                <<<"$admitted_status" 2>/dev/null || echo 0)"
            ((in_flight >= b_concs[i])) || all_admitted=0
        done
        ((all_admitted == 1)) && break
        ((SECONDS < admit_deadline)) || break
        sleep 0.01
    done
    if ((all_admitted != 1)); then
        printf 'admit-wait: not every app reached in_flight >= concurrency within the deadline (last status: %s)\n' \
            "$admitted_status" >&2
        return 1
    fi

    local shutdown_start
    shutdown_start="$(date +%s%3N)"
    kill -TERM "$demo_pid"

    # Capture the probe's stderr to a file instead of letting it leak to
    # the terminal/log raw: curl's --show-error prints an error line on
    # any failure (e.g. "curl: (28) Operation timed out...") even with
    # --silent, and that failure is the *expected*, documented outcome
    # here (see classify_post_signal_probe above), not an unexplained
    # error. The file is kept for diagnosis if the outcome ever is
    # genuinely unexpected.
    local probe_err_file="$dir/post-signal-probe-stderr.txt"
    local probe_body probe_exit=0
    probe_body="$(curl --silent --show-error --max-time 1 --output /dev/null \
        --write-out '%{http_code}' "http://$bind/__hyperlight/readyz" \
        2>"$probe_err_file")" || probe_exit=$?
    local post_signal_probe
    post_signal_probe="$(classify_post_signal_probe "$probe_exit" "$probe_body")"
    if [[ "$post_signal_probe" != no_response ]]; then
        printf 'post-signal probe: unexpected result %s (curl exit %s, http %s)\n' \
            "$post_signal_probe" "$probe_exit" "$probe_body" >&2
        sed 's/^/  /' "$probe_err_file" >&2
    fi
    [[ "$post_signal_probe" == no_response ]]

    local -a b_statuses
    for ((i = 0; i < benchmark_apps; i++)); do
        local status=0
        wait "${b_pids[i]}" || status=$?
        b_statuses[i]="$status"
    done
    rm -f "$b_gate" 2>/dev/null

    local -a during_apps_list=()
    for ((i = 0; i < benchmark_apps; i++)); do
        if [[ "${b_statuses[i]}" != 0 ]]; then
            printf 'phase B (drain): app %d hey exited %s (see %s)\n' \
                "$i" "${b_statuses[i]}" "${b_outfiles[i]}" >&2
            return 1
        fi
        if ((b_reqs[i] > 0)) &&
            ! grep -Eq "\\[200\\][[:space:]]+${b_reqs[i]} responses" "${b_outfiles[i]}"; then
            printf 'phase B (drain): app %d did not report [200] %s responses (see %s)\n' \
                "$i" "${b_reqs[i]}" "${b_outfiles[i]}" >&2
            tail -n 10 "${b_outfiles[i]}" | sed 's/^/  /' >&2
            return 1
        fi
        local one
        one="$(build_app_summary "drain-$i" "${b_reqs[i]}" "${b_concs[i]}" "${b_outfiles[i]}")"
        during_apps_list+=("$one")
    done
    local during_apps
    during_apps="$(printf '%s\n' "${during_apps_list[@]}" | jq -cs '.')"
    write_benchmark_summary "during-drain" "$during_apps" null 0 "$dir/during-drain-summary.json"

    # Bounded poll for process exit (drain-timeout-ms 5000 + buffer), not a
    # blind wait: new connections after SIGTERM get no response until the
    # process actually exits, so this is the only reliable exit signal.
    local deadline=$((SECONDS + 15))
    while kill -0 "$demo_pid" 2>/dev/null; do
        if ((SECONDS >= deadline)); then
            echo "workerd-host did not exit within the drain timeout" >&2
            return 1
        fi
        sleep 0.05
    done
    local exit_code=0
    wait "$demo_pid" || exit_code=$?
    local shutdown_end
    shutdown_end="$(date +%s%3N)"
    demo_pid=""

    local shutdown_duration_ms=$((shutdown_end - shutdown_start))
    jq -n \
        --arg scenario "orchestrator-contract" \
        --slurpfile pre_drain "$dir/pre-drain-summary.json" \
        --slurpfile during_drain "$dir/during-drain-summary.json" \
        --arg post_signal_probe "$post_signal_probe" \
        --argjson post_signal_probe_curl_exit "$probe_exit" \
        --arg post_signal_probe_http_code "$probe_body" \
        --argjson shutdown_duration_ms "$shutdown_duration_ms" \
        --argjson exit_code "$exit_code" \
        '{
            scenario: $scenario,
            pre_drain: $pre_drain[0],
            during_drain: $during_drain[0],
            post_signal_probe: $post_signal_probe,
            post_signal_probe_detail: {
                curl_exit_code: $post_signal_probe_curl_exit,
                http_code: $post_signal_probe_http_code
            },
            shutdown_duration_ms: $shutdown_duration_ms,
            exit_code: $exit_code
        }' >"$dir/summary.json"

    if [[ "$exit_code" != 0 ]]; then
        printf 'workerd-host exited %s instead of 0 after drain (see %s)\n' \
            "$exit_code" "$dir/server.log" >&2
        tail -n 10 "$dir/server.log" | sed 's/^/  /' >&2
        return 1
    fi
    echo "$exit_code" >"$dir/exit-code.txt"
    echo "SIGTERM mid-flight drained admitted requests (post-signal probe: $post_signal_probe) and exited $exit_code within the drain timeout ($shutdown_duration_ms ms)."
}

