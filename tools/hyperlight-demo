        isolation) echo "Send a normal request, force a timeout, then send a recovery request." ;;
        policy) echo "Run permission, usage-limit, denial, activity-log, and reset checks." ;;
        ingress) echo "Pass a scheduled event and a named message batch into a temporary VM." ;;
        kv) echo "Write and read a deterministic KV entry before and after VM reset." ;;
        cache) echo "Populate a deterministic cache entry, replace the VM, and read it again." ;;
        sql) echo "Execute a transactional SQL batch, replace the VM, and verify committed rows." ;;
        durable-objects) echo "Write two objects' data, replace the VM, and verify the data stays separate." ;;
        storage) echo "Read and write declared paths, then probe traversal and quota boundaries." ;;
        node) echo "Load both common JavaScript module formats and use the supported file API." ;;
        core-wasm) echo "Invoke the packaged Wasm export across disposable request VMs." ;;
        component) echo "Run the included WebAssembly Component example." ;;
        wasi-p2) echo "Run portable HTTP, stream, clock, random, cleanup, and denial checks." ;;
        wasi-p3) echo "Run async ordering, backpressure, deadline, cancellation, and cleanup checks." ;;
        tcp-tls) echo "Connect to a host-listed TCP and TLS destination, then try one that is not listed." ;;
        udp) echo "Exchange UDP messages with an allowed address and port, then exceed the size limit." ;;
        websocket) echo "Open an allowed WebSocket, exchange messages, then exceed the message limit." ;;
        web-apis) echo "Call the timer, stream, handler, MessagePort, and fresh-state routes." ;;
        fetch) echo "Fetch one declared loopback endpoint and probe blocked network targets." ;;
        resident) echo "Send several sequential requests against one resident VM, then exceed its max-requests-per-VM limit and show explicit retirement." ;;
        multi-app) echo "Start one workerd-host process with two apps and request each by hostname." ;;
        orchestrator-contract) echo "Drive /healthz, /readyz, and /status, then send SIGTERM and observe the drain and exit code." ;;
        benchmark-on-demand) echo "Send $benchmark_requests requests, with up to $benchmark_concurrency requests and $benchmark_vms VMs running at once, while VMs are created as needed." ;;
        benchmark-prewarmed) echo "Send $benchmark_requests requests, with up to $benchmark_concurrency requests and $benchmark_vms VMs running at once, using a ready inventory of $benchmark_pool_vms VMs." ;;
        benchmark-resident) echo "Start $benchmark_apps independent resident apps on separate ports, then send $benchmark_load_requests total requests at $benchmark_concurrency aggregate concurrency, split evenly across apps." ;;
        benchmark-multi-app) echo "Start one workerd-host process with $benchmark_apps routed apps, then send $benchmark_load_requests total requests at $benchmark_concurrency aggregate concurrency against each app's hostname." ;;
        benchmark-orchestrator-contract) echo "Start one workerd-host process with $benchmark_apps apps, verify health/readiness/status under a reference load, then send the remaining in-flight share and SIGTERM together and measure the drain." ;;
        *) return 1 ;;
    esac
}

