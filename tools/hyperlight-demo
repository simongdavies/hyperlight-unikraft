# allocate_evenly TOTAL PARTS ARRNAME
#
# Deterministically splits TOTAL into PARTS non-negative integers summing
# to TOTAL: each part gets TOTAL/PARTS, and the remainder (TOTAL % PARTS)
# is assigned one-each to the first parts, so results are stable and
# reproducible regardless of divisibility. Writes the PARTS values into
# the caller's array ARRNAME.
allocate_evenly() {
    local total="$1" parts="$2"
    local -n out_arr="$3"
    local base=$((total / parts))
    local remainder=$((total % parts))
    out_arr=()
    local i share
    for ((i = 0; i < parts; i++)); do
        share="$base"
        ((i < remainder)) && share=$((share + 1))
        out_arr+=("$share")
    done
}

# compute_benchmark_classes MODE SELECTED
#
# Decides which benchmark flag-validation class(es) apply to the demo
# selection that is about to run/preview/describe, and sets the globals
# uses_benchmark_apps and uses_legacy_benchmark accordingly. "one"/
# "describe" narrow to exactly one class based on the selected demo name;
# every other mode (all/preview/clear/self-test, or an unrecognized name
# later rejected elsewhere) conservatively enables both classes, since no
# single demo's scope narrows them. Kept separate from
# validate_benchmark_flags so self_test can exercise both independently.
compute_benchmark_classes() {
    local mode="$1" selected="${2:-}"
    uses_benchmark_apps=false
    uses_legacy_benchmark=false
    case "$mode" in
        one | describe)
            case "$selected" in
                benchmark-resident | benchmark-multi-app | benchmark-orchestrator-contract)
                    uses_benchmark_apps=true
                    ;;
                benchmark-on-demand | benchmark-prewarmed)
                    uses_legacy_benchmark=true
                    ;;
                *) ;;
            esac
            ;;
        *)
            uses_benchmark_apps=true
            uses_legacy_benchmark=true
            ;;
    esac
}

# validate_benchmark_flags REQUESTS CONCURRENCY POOL_VMS APPS LOAD_REQUESTS
#                          USES_APPS USES_LEGACY
#
# Pure validation: prints an error to stderr and returns 2 on the first
# violated constraint, else returns 0. USES_LEGACY gates the
# benchmark-on-demand/benchmark-prewarmed-only check (--benchmark-requests
# vs --benchmark-concurrency); USES_APPS gates the three load-benchmark
# checks (--benchmark-apps vs --benchmark-concurrency/--benchmark-load-
# requests). Regression guard: --benchmark-concurrency cannot exceed
# --benchmark-requests used to run unconditionally, so a load-benchmark
# invocation with a large --benchmark-concurrency intended for
# --benchmark-load-requests incorrectly tripped the legacy-only
# --benchmark-requests default. Kept standalone (no arg parsing, no
# launching) so self_test can exercise exact reported flag combinations
# deterministically.
validate_benchmark_flags() {
    local requests="$1" concurrency="$2" pool_vms="$3"
    local apps="$4" load_requests="$5" uses_apps="$6" uses_legacy="$7"
    if ((pool_vms < 2)); then
        echo "--benchmark-pool-vms must be at least 2" >&2
        return 2
    fi
    if "$uses_legacy" && ((concurrency > requests)); then
        echo "--benchmark-concurrency cannot exceed --benchmark-requests" >&2
        return 2
    fi
    if "$uses_apps"; then
        if ((concurrency < apps)); then
            echo "--benchmark-concurrency must be at least --benchmark-apps" >&2
            return 2
        fi
        if ((apps > load_requests)); then
            echo "--benchmark-apps cannot exceed --benchmark-load-requests" >&2
            return 2
        fi
        if ((concurrency > load_requests)); then
            echo "--benchmark-concurrency cannot exceed --benchmark-load-requests" >&2
            return 2
        fi
    fi
    return 0
}

# self_test: lightweight, offline (no demo processes, no network) coverage
# for allocate_evenly's determinism/remainder handling, plus targeted
# regression guards. Run via the hidden `--self-test` flag; exits
# non-zero on the first failed assertion.
self_test() {
    local failures=0

    assert_alloc() {
        local total="$1" parts="$2" expected="$3"
        local -a got
        allocate_evenly "$total" "$parts" got
        local actual="${got[*]}"
        if [[ "$actual" != "$expected" ]]; then
            printf 'FAIL allocate_evenly %s %s: expected [%s] got [%s]\n' \
                "$total" "$parts" "$expected" "$actual" >&2
            failures=$((failures + 1))
            return
        fi
        local sum=0 x
        for x in "${got[@]}"; do sum=$((sum + x)); done
        if ((sum != total)); then
            printf 'FAIL allocate_evenly %s %s: parts sum to %s, not %s\n' \
                "$total" "$parts" "$sum" "$total" >&2
            failures=$((failures + 1))
        fi
    }

    assert_alloc 100 4 "25 25 25 25"
    assert_alloc 10 3 "4 3 3"
    assert_alloc 1 1 "1"
    assert_alloc 1 3 "1 0 0"
    assert_alloc 7 7 "1 1 1 1 1 1 1"
    assert_alloc 0 4 "0 0 0 0"

    # Regression guard for run_one's fail-fast fix: bash disables errexit
    # for a compound command (and everything nested inside it, including
    # nested `set -e`) whenever that compound command is the left-hand
    # side of `||`. `run_one` avoids that by toggling errexit off/on
    # around a plain (non-conditional) subshell invocation instead of
    # `(...) || status=$?`. Prove both the broken and the fixed pattern
    # here, offline, so a future edit that reintroduces the `||` form is
    # caught without needing a real demo process.
    _self_test_fails() { local x=5; [[ "$x" == 0 ]]; echo "unreachable"; }

    local broken_status=0
    ( set -e; _self_test_fails >/dev/null 2>&1 ) || broken_status=$?
    if ((broken_status == 0)); then
        echo "self-test: confirmed the broken '(...) || status=\$?' pattern" \
            "masks a failing assertion (status=0, as expected for this negative check)"
    else
        printf 'FAIL run_one regression guard: the broken pattern unexpectedly' >&2
        printf ' reported status=%s; the pattern this guards against may have' "$broken_status" >&2
        printf ' changed and this guard needs to be re-reasoned about\n' >&2
        failures=$((failures + 1))
    fi

    set +e
    ( set -e; _self_test_fails >/dev/null 2>&1 )
    local fixed_status=$?
    set -e
    if ((fixed_status != 0)); then
        echo "self-test: run_one's fail-fast pattern reports a nonzero status" \
            "for a failing demo (status=$fixed_status)"
    else
        echo "FAIL run_one regression guard: the fail-fast pattern reported" \
            "status=0 for a deliberately failing assertion" >&2
        failures=$((failures + 1))
    fi
    unset -f _self_test_fails

    # Regression guard: `tools/hyperlight-demo --benchmark-apps 32
    # --benchmark-load-requests 32768 --benchmark-concurrency 2048 --demo
    # benchmark-resident` used to fail with "--benchmark-concurrency
    # cannot exceed --benchmark-requests" because that legacy-only check
    # ran unconditionally. Prove the exact reported values now pass for a
    # load-benchmark demo, and prove the legacy check still rejects the
    # equivalent invalid combination for a legacy demo and the apps check
    # still rejects an invalid load-benchmark combination -- so the fix
    # narrows the check instead of disabling it universally.
    assert_benchmark_validation() {
        local label="$1" mode="$2" selected="$3"
        local requests="$4" concurrency="$5" pool_vms="$6" apps="$7" load_requests="$8"
        local expect="$9"
        compute_benchmark_classes "$mode" "$selected"
        local msg status=0
        msg="$(validate_benchmark_flags "$requests" "$concurrency" "$pool_vms" \
            "$apps" "$load_requests" "$uses_benchmark_apps" "$uses_legacy_benchmark" 2>&1)" ||
            status=$?
        if [[ "$expect" == pass ]]; then
            if ((status != 0)); then
                printf 'FAIL %s: expected validation to pass, got: %s\n' "$label" "$msg" >&2
                failures=$((failures + 1))
            fi
        else
            if ((status == 0)); then
                printf 'FAIL %s: expected validation to reject, but it passed\n' "$label" >&2
                failures=$((failures + 1))
            fi
        fi
    }

    assert_benchmark_validation \
        "reported benchmark-resident regression" one benchmark-resident \
        100 2048 2 32 32768 pass
    assert_benchmark_validation \
        "legacy benchmark-on-demand still rejects concurrency > requests" one benchmark-on-demand \
        100 2048 2 32 32768 fail
    assert_benchmark_validation \
        "benchmark-multi-app still rejects concurrency < apps" one benchmark-multi-app \
        100 10 2 32 32768 fail
    unset -f assert_benchmark_validation

    # Regression guard: tools/hyperlight-demo invokes several tools/*.sh
    # helpers directly by path (e.g. "$root/tools/run-workerd-vfs-demo.sh"),
    # which relies on the shell honoring the file's executable permission
    # bit. git tracks that bit per-blob (100755 vs 100644) independently of
    # file content, so a helper can be syntactically perfect yet still fail
    # with "Permission denied" on a fresh clone if it was ever committed, or
    # re-added, without the executable bit. Catch that offline, without
    # launching any demo process, by checking every script this file is
    # known to invoke directly (helper_scripts_invoked_directly) both on
    # disk and (when git metadata is available) in the index/HEAD tree.
    assert_helper_executable() {
        local helper="$1"
        local path="$root/$helper"
        if [[ ! -e "$path" ]]; then
            printf 'FAIL helper executability %s: file does not exist at %s\n' \
                "$helper" "$path" >&2
            failures=$((failures + 1))
            return
        fi
        if [[ ! -x "$path" ]]; then
            printf 'FAIL helper executability %s: not executable on disk (chmod +x %s)\n' \
                "$helper" "$path" >&2
            failures=$((failures + 1))
        fi
        if command -v git >/dev/null && git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            local tracked_mode
            tracked_mode="$(git -C "$root" ls-files -s -- "$helper" 2>/dev/null | awk '{print $1}')"
            if [[ -n "$tracked_mode" && "$tracked_mode" != "100755" ]]; then
                printf 'FAIL helper executability %s: git-tracked mode is %s, not 100755\n' \
                    "$helper" "$tracked_mode" >&2
                failures=$((failures + 1))
            fi
        fi
    }

    local helper
    for helper in "${helper_scripts_invoked_directly[@]}"; do
        assert_helper_executable "$helper"
    done
    unset -f assert_helper_executable

    if ((failures == 0)); then
        echo "self-test: all allocate_evenly, benchmark-flag-validation, and helper-executability assertions passed"
        return 0
    fi
    echo "self-test: $failures assertion(s) failed" >&2
    return 1
}

# spawn_hey_paused OUTFILE GATE_FILE RELEASE_SLEEP -- HEY_ARGS...
#
# Forks a single `hey` invocation as a background subshell that blocks
# until GATE_FILE exists before it execs `hey HEY_ARGS...`, writing
# combined stdout/stderr to OUTFILE; sets no state of its own, the caller
# reads $! for the subshell's pid (status/wait handling is the caller's
# job). This is the one place that actually forks `hey`, used by every
# hey launch site in this script (legacy benchmark-on-demand/
# benchmark-prewarmed, launch_hey_jobs's per-wave batches, and the
# orchestrator-contract drain test's phase B) so a `hey` process is
# always pre-spawned *paused* and only starts sending requests once its
# gate file is created by the caller, rather than requests starting as a
# side effect of whatever order/speed forking happened to occur in. When
# RELEASE_SLEEP is non-zero (a fractional-seconds string, e.g. "0.050"),
# it is slept after the gate opens and before `hey` starts, letting a
# caller stagger several jobs that share one gate file.
spawn_hey_paused() {
    local outfile="$1" gate_file="$2" release_sleep="$3"
    shift 3
    (
        while [[ ! -e "$gate_file" ]]; do sleep 0.005; done
        [[ "$release_sleep" != 0 ]] && sleep "$release_sleep"
        exec hey "$@"
    ) >"$outfile" 2>&1 &
}

# launch_hey_jobs REQS_ARR CONC_ARR URL_ARR HOST_ARR TIMEOUT_ARR OUTFILE_ARR STATUS_ARRNAME [LOG_FILE]
#
# Runs one `hey` invocation per index across the given parallel arrays, at
# most $hey_max_parallel_jobs concurrently (bounding heavy client
# processes in flight at any instant regardless of how many apps/indices
# there are), recording each job's exit status (0 = success) into
# STATUS_ARRNAME. A zero request count is treated as a trivial success
# (no `hey` invocation, empty output file): used by the
# orchestrator-contract benchmark's degenerate small-N per-app phase
# split. When the index count exceeds $hey_max_parallel_jobs, later
# indices only start once an earlier batch/wave has fully finished: each
# app's own hey-reported requests/sec reflects only its own wave, so
# summing every app's rate does not equal the true wall-clock aggregate
# throughput once more than one wave runs (see write_benchmark_summary's
# end_to_end_requests_per_sec for that number).
#
# Within one wave, every job is pre-spawned *paused*: each is forked as a
# subshell that blocks on a per-wave gate file before it execs `hey`, so
# the whole batch is already forked and ready before any of them starts
# sending requests. Once every job in the batch is forked, the gate file
# is created, releasing all of them together, rather than requests
# starting as a side effect of however long forking itself took. When
# $hey_ramp_ms is greater than 0, each job's release is additionally
# delayed by its position in the batch times that many milliseconds (job
# 0 starts immediately on release, job 1 after one ramp step, and so on),
# staggering actual request start without staggering (and thereby
# delaying) the forking itself; this adds roughly
# (batch_size - 1) * hey_ramp_ms to each wave's wall-clock time, which is
# folded into the reported phase timing like any other wave cost. When
# LOG_FILE is given, appends timestamped wave queue/release/finish and
# per-app hey start/finish (command, exit code, output path) entries to
# it.
launch_hey_jobs() {
    # Namerefs use a `_lhj_` prefix so they can never alias a caller-side
    # array of the same base name (bash namerefs otherwise self-reference
    # and fail with "circular name reference" when the caller's array
    # happens to share the parameter's name, e.g. `launch_hey_jobs reqs
    # concs ...`).
    local -n _lhj_reqs="$1" _lhj_concs="$2" _lhj_urls="$3" _lhj_hosts="$4"
    local -n _lhj_timeouts="$5" _lhj_outfiles="$6"
    local -n _lhj_statuses="$7"
    local _lhj_logfile="${8:-}"
    local max_parallel="$hey_max_parallel_jobs"
    local n="${#_lhj_reqs[@]}"
    _lhj_statuses=()
    local i=0
    local wave=0
    while ((i < n)); do
        wave=$((wave + 1))
        local -a batch_pids=() batch_indexes=()
        local batch_end=$((i + max_parallel))
        ((batch_end <= n)) || batch_end="$n"
        local gate_file
        gate_file="$(mktemp -u "${TMPDIR:-/tmp}/hyperlight-demo-hey-gate.XXXXXX")"
        rm -f "$gate_file" 2>/dev/null
        [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
            "hey wave $wave queue: apps $i-$((batch_end - 1)) of $n" \
            "${hey_ramp_ms:+ramp=${hey_ramp_ms}ms per job on release}"
        local wave_t0 wave_t1
        wave_t0="$(now_seconds)"
        local j
        for ((j = i; j < batch_end; j++)); do
            if ((_lhj_reqs[j] <= 0)); then
                _lhj_statuses[j]=0
                : >"${_lhj_outfiles[j]}"
                continue
            fi
            local -a host_args=()
            [[ -n "${_lhj_hosts[j]}" ]] && host_args=(-host "${_lhj_hosts[j]}")
            local release_sleep="0"
            if ((hey_ramp_ms > 0)); then
                local offset_ms=$(((j - i) * hey_ramp_ms))
                release_sleep="$(printf '%d.%03d' \
                    $((offset_ms / 1000)) $((offset_ms % 1000)))"
            fi
            [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
                "hey app #$j queued (paused): hey -n ${_lhj_reqs[j]} -c ${_lhj_concs[j]} -t ${_lhj_timeouts[j]} ${_lhj_hosts[j]:+-host ${_lhj_hosts[j]}} ${_lhj_urls[j]} ramp_offset=${release_sleep}s"
            spawn_hey_paused "${_lhj_outfiles[j]}" "$gate_file" "$release_sleep" \
                -n "${_lhj_reqs[j]}" -c "${_lhj_concs[j]}" -t "${_lhj_timeouts[j]}" \
                "${host_args[@]}" "${_lhj_urls[j]}"
            batch_pids+=("$!")
            batch_indexes+=("$j")
        done
        [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
            "hey wave $wave release: ${#batch_pids[@]} jobs"
        : >"$gate_file"
        local k
        for ((k = 0; k < ${#batch_pids[@]}; k++)); do
            local pid="${batch_pids[k]}" idx="${batch_indexes[k]}"
            local status=0
            wait "$pid" || status=$?
            _lhj_statuses[idx]="$status"
            [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
                "hey app #$idx finished: exit=$status output=${_lhj_outfiles[idx]}"
        done
        rm -f "$gate_file" 2>/dev/null
        wave_t1="$(now_seconds)"
        [[ -n "$_lhj_logfile" ]] && log_line "$_lhj_logfile" \
            "hey wave $wave finish: elapsed=$(seconds_between "$wave_t0" "$wave_t1")s"
        i="$batch_end"
    done
}

# write_collected_hey_report OUTPUT APP_IDS_ARRNAME ADDR_ARRNAME CMD_ARRNAME
#                            HEY_FILE_ARRNAME
#
# Concatenates each app's independent raw `hey` report into one top-level
# file for quick human review, with a clear per-app separator naming the
# app, its address, and the exact `hey` command used. This is a collected
# raw report, not a combined statistical distribution: parallel
# independent `hey` runs cannot be merged into one set of
# percentiles/latency histogram, and this file does not attempt that --
# see summary.json for the computed aggregate (sum of throughput,
# weighted mean latency).
write_collected_hey_report() {
    local output="$1"
    local -n _wchr_ids="$2" _wchr_addrs="$3" _wchr_cmds="$4" _wchr_files="$5"
    {
        echo "# Collected raw hey reports: one independent hey run per app below."
        echo "# NOT a combined statistical distribution -- see summary.json for"
        echo "# the computed aggregate (sum of throughput, weighted mean latency)."
        local i n="${#_wchr_ids[@]}"
        for ((i = 0; i < n; i++)); do
            echo
            echo "==== app: ${_wchr_ids[i]} ===================================="
            echo "address: ${_wchr_addrs[i]}"
            echo "command: ${_wchr_cmds[i]}"
            echo
            cat "${_wchr_files[i]}"
        done
    } >"$output"
}

# build_app_summary APP_ID REQUESTS CONCURRENCY HEY_OUTPUT_FILE
#
# Parses one `hey` text report into a per-app JSON summary object, using
# the requests/concurrency the caller already configured rather than
# re-deriving them from the report. Missing fields (e.g. a skipped
# zero-request job) default to 0.
build_app_summary() {
    local app_id="$1" requests="$2" concurrency="$3" hey_file="$4"
    local rps avg_s
    rps="$(grep -m1 'Requests/sec:' "$hey_file" | awk '{print $2}')"
    avg_s="$(grep -m1 '  Average:' "$hey_file" | awk '{print $2}')"
    jq -n \
        --arg app_id "$app_id" \
        --argjson requests "$requests" \
        --argjson concurrency "$concurrency" \
        --argjson rps "${rps:-0}" \
        --argjson avg_s "${avg_s:-0}" \
        '{
            app_id: $app_id,
            requests: $requests,
            concurrency: $concurrency,
            requests_per_sec: $rps,
            average_latency_ms: ($avg_s * 1000)
        }'
}

# now_seconds -> current wall-clock time, sub-second precision.
now_seconds() { date +%s.%N; }

# seconds_between START END -> (END - START) with 3 decimal places.
seconds_between() {
    awk -v start="$1" -v end="$2" 'BEGIN { printf "%.3f", end - start }'
}

# log_line LOGFILE MESSAGE...
#
# Appends one timestamped line to LOGFILE (created if missing). This is
# the orchestration-level log (phases, per-app launch/ready/hey/shutdown
# events, failures with the referenced per-app server log path) -- not a
# replacement for each app's own server.log, which keeps the raw workerd-
# host stdout/stderr untouched. Only written to the file: callers that
# also want the line on the terminal (e.g. a failure) should echo/printf
# it themselves in addition to calling this.
log_line() {
    local logfile="$1"
    shift
    printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$logfile"
}

# make_phase_timing SETUP_SECONDS LOAD_SECONDS TEARDOWN_SECONDS TOTAL_SECONDS
# -> prints the shared {setup_seconds, load_seconds, teardown_seconds,
#    total_seconds} JSON object used by benchmark-resident/benchmark-
#    multi-app's summary.json. setup_seconds covers starting the
#    workerd-host process(es) and writing configs, up to (not including)
#    the hey load; load_seconds is the wall-clock span of the hey load
#    phase itself (launch_hey_jobs, which may run in multiple sequential
#    waves -- see hey_max_parallel_jobs); teardown_seconds covers
#    post-load status collection and process shutdown; total_seconds is
#    the full run_benchmark_* function duration (may exceed the sum of
#    the other three by a small amount spent on bookkeeping between
#    phases).
make_phase_timing() {
    jq -n \
        --argjson setup_seconds "$1" \
        --argjson load_seconds "$2" \
        --argjson teardown_seconds "$3" \
        --argjson total_seconds "$4" \
        '{setup_seconds: $setup_seconds, load_seconds: $load_seconds, teardown_seconds: $teardown_seconds, total_seconds: $total_seconds}'
}

# write_benchmark_summary SCENARIO PER_APP_ARRAY_JSON TIMING_JSON MAX_PARALLEL
#                         OUTPUT_PATH
#
# Builds the common {scenario, apps, timing, aggregate} shape shared by
# all three new benchmarks' summary.json.
#
# aggregate.sum_of_app_requests_per_sec sums each app's independently
# measured requests/sec from its own hey run: a reasonable approximation
# ONLY while every app's hey process actually ran concurrently. Once the
# app count exceeds MAX_PARALLEL, launch_hey_jobs runs later apps in
# sequential waves (see its docstring), so this sum silently keeps adding
# up rates from waves that did not overlap in wall-clock time and
# overstates true throughput by roughly the wave count.
#
# aggregate.end_to_end_requests_per_sec instead divides total_requests by
# the load phase's measured wall-clock duration (timing.load_seconds):
# this is the number that matches what an external observer actually saw
# across however many waves the load took, and is the one to trust for
# true aggregate throughput. It is null when TIMING_JSON/MAX_PARALLEL are
# not supplied (orchestrator-contract's phase summaries do not currently
# measure this).
write_benchmark_summary() {
    local scenario="$1" per_app_json="$2" timing_json="${3:-null}"
    local max_parallel="${4:-0}" output="$5"
    jq -n \
        --arg scenario "$scenario" \
        --argjson apps "$per_app_json" \
        --argjson timing "$timing_json" \
        --argjson max_parallel "$max_parallel" '
        ($apps | map(.requests) | add) as $total_requests |
        {
            scenario: $scenario,
            apps: $apps,
            timing: $timing,
            aggregate: {
                total_requests: $total_requests,
                sum_of_app_requests_per_sec: ($apps | map(.requests_per_sec) | add),
                end_to_end_requests_per_sec: (
                    if ($timing | type) == "object" and (($timing.load_seconds // 0) > 0) then
                        ($total_requests / $timing.load_seconds)
                    else null end
                ),
                weighted_mean_latency_ms: (
                    ($apps | map(.average_latency_ms * .requests) | add) /
                    (if $total_requests > 0 then $total_requests else 1 end)
                ),
                max_parallel_hey_jobs: (if $max_parallel > 0 then $max_parallel else null end),
                hey_waves: (
                    if $max_parallel > 0 then
                        ((($apps | length) + $max_parallel - 1) / $max_parallel | floor)
                    else null end
                )
            }
        }' >"$output"
}

# host_http_get BIND HOST_HEADER PATH -> prints "STATUS\tBODY"
host_http_get() {
    local bind="$1" host_header="$2" path="$3"
    local body status
    body="$(curl --silent --show-error --output - --write-out '\n%{http_code}' \
        --header "Host: $host_header" "http://$bind$path")"
    status="${body##*$'\n'}"
    printf '%s\t%s\n' "$status" "${body%$'\n'*}"
}

run_resident() {
    local dir="$output_dir/resident"
    mkdir -p "$dir"
    local pool
    pool="$(jq -n '{kind:"resident", capacity:1, queue_capacity:4, max_requests_per_vm:5, max_lifetime_secs:null}')"
    local apps
    apps="$(jq -n --argjson app "$(app_config resident resident.test \
        "$root/examples/workerd-bundles/acceptance.json" "$pool")" '[$app]')"
    write_host_config "$dir/config.json" "$apps"
    start_workerd_host "$dir/server.log" "$dir/config.json" 127.0.0.1:8180
    local n
    for n in $(seq 1 6); do
        host_http_get 127.0.0.1:8180 resident.test "/resident/$n" \
            >"$dir/request-$n.txt"
        [[ "$(cut -f1 "$dir/request-$n.txt")" == 200 ]]
    done
    curl --fail-with-body --silent --show-error \
        --header "Host: resident.test" \
        http://127.0.0.1:8180/__hyperlight/status \
        | tee "$dir/status.json" \
        | jq -e '.[0].resident_requests_served == 6 and .[0].retirements == 1' \
        >/dev/null
    stop_processes
    echo "Six requests hit one resident VM; the sixth crossed max_requests_per_vm and retired it."
}

run_multi_app() {
    local dir="$output_dir/multi-app"
    mkdir -p "$dir"
    local resident_pool disposable_pool apps
    resident_pool="$(jq -n '{kind:"resident", capacity:1, queue_capacity:4, max_requests_per_vm:null, max_lifetime_secs:null}')"
    disposable_pool="$(jq -n '{kind:"disposable", max_concurrent_sandboxes:4, queue_capacity:16}')"
    apps="$(jq -n \
        --argjson a "$(app_config app-a a.test \
            "$root/examples/workerd-bundles/acceptance.json" "$resident_pool")" \
        --argjson b "$(app_config app-b b.test \
            "$root/examples/workerd-bundles/acceptance.json" "$disposable_pool")" \
        '[$a, $b]')"
    write_host_config "$dir/config.json" "$apps"
    start_workerd_host "$dir/server.log" "$dir/config.json" 127.0.0.1:8181
    host_http_get 127.0.0.1:8181 a.test /hello >"$dir/app-a.txt"
    host_http_get 127.0.0.1:8181 b.test /hello >"$dir/app-b.txt"
    [[ "$(cut -f1 "$dir/app-a.txt")" == 200 ]]
    [[ "$(cut -f1 "$dir/app-b.txt")" == 200 ]]
    curl --fail-with-body --silent --show-error \
        --header "Host: a.test" \
        http://127.0.0.1:8181/__hyperlight/status \
        | tee "$dir/status.json" \
        | jq -e '
            (map(select(.app_id == "app-a"))[0].kind == "resident") and
            (map(select(.app_id == "app-b"))[0].kind == "disposable")
        ' >/dev/null
    stop_processes
    echo "Both apps were served correctly and independently from one process and port."
}

run_orchestrator_contract() {
    local dir="$output_dir/orchestrator-contract"
    mkdir -p "$dir"
    local pool apps
    pool="$(jq -n '{kind:"disposable", max_concurrent_sandboxes:4, queue_capacity:16}')"
    apps="$(jq -n --argjson app "$(app_config contract contract.test \
        "$root/examples/workerd-bundles/acceptance.json" "$pool")" '[$app]')"
    write_host_config "$dir/config.json" "$apps"
    start_workerd_host "$dir/server.log" "$dir/config.json" 127.0.0.1:8182
    curl --fail-with-body --silent --show-error \
        http://127.0.0.1:8182/__hyperlight/healthz >"$dir/healthz.json"
    jq -e '.status == "ok"' "$dir/healthz.json" >/dev/null
    curl --fail-with-body --silent --show-error \
        http://127.0.0.1:8182/__hyperlight/readyz >"$dir/readyz.json"
    jq -e '.status == "ready"' "$dir/readyz.json" >/dev/null
    curl --fail-with-body --silent --show-error \
        --header "Host: contract.test" \
        http://127.0.0.1:8182/__hyperlight/status >"$dir/status.json"
    jq -e '.[0].app_id == "contract" and .[0].kind == "disposable"' \
        "$dir/status.json" >/dev/null
    kill -TERM "$demo_pid"
    local exit_code=0
    wait "$demo_pid" || exit_code=$?
    demo_pid=""
    echo "$exit_code" >"$dir/exit-code.txt"
    [[ "$exit_code" == 0 ]]
    echo "SIGTERM produced a clean drain and exit code $exit_code (0 = clean shutdown)."
}

run_isolation() {
    local dir="$output_dir/isolation"
    mkdir -p "$dir"
    start_server "$dir/server.log" \
        --bundle "$root/examples/workerd-bundles/acceptance.json" \
        --scratch-mb 384 \
        --request-timeout-ms 500 \
        --restore-mode on-demand \
        --max-concurrent-sandboxes 1 \
        --queue-capacity 1
    curl --fail-with-body --silent --show-error \
        http://127.0.0.1:8787/before |
        tee "$dir/before.json" |
        jq -e '.path == "/before" and .method == "GET"' >/dev/null
    local status
    status="$(curl --silent --show-error --output "$dir/timeout.json" \
        --write-out '%{http_code}' http://127.0.0.1:8787/busy)"
    [[ "$status" == 504 ]]
    curl --fail-with-body --silent --show-error \
        http://127.0.0.1:8787/after |
        tee "$dir/after.json" |
        jq -e '.path == "/after" and .method == "GET"' >/dev/null
    stop_processes
    echo "HTTP 504 was isolated; the following fresh-VM request succeeded."
}

run_policy() {
    ensure_capability_proof || return
}

check_capability_evidence() {
    local proof="$1"
    local label="$2"
    local predicate="$3"
    local actual="$4"
    if jq -e "$predicate" "$proof" >/dev/null; then
        return 0
    fi
    printf 'capability evidence mismatch: %s\n' "$label" >&2
    printf 'actual: ' >&2
    jq -c "$actual" "$proof" >&2 || true
    return 1
}

ensure_capability_proof() {
    local scope="${1:-all}"
    local proof="$output_dir/capability-proof.json"
    local state_dir="$output_dir/capability-state"
    if "$capability_proof_ran"; then
        return
    fi
    mkdir -p "$output_dir" "$state_dir"
    local database
    local databases=(kv cache sql durable)
    if [[ "$scope" == sql ]]; then
        databases=(sql)
    fi
    for database in "${databases[@]}"; do
        rm -f -- \
            "$state_dir/$database.sqlite" \
            "$state_dir/$database.sqlite-shm" \
            "$state_dir/$database.sqlite-wal"
        sqlite3 "$state_dir/$database.sqlite" "VACUUM;"
        readonly_sqlite_query \
            "$state_dir/$database.sqlite" \
            "SELECT name FROM sqlite_schema WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name" \
            "$output_dir/$database-before.tsv"
        [[ ! -s "$output_dir/$database-before.tsv" ]]
    done
    local temporary="$proof.tmp"
    rm -f -- "$output_dir/capability-proof.failed.json"
    if ! cargo +1.98.0 run --release --locked --example workerd-capability-proof -- \
        "$root/build-elfloader/workerd-executor/rootfs.img" \
        "$root/build-elfloader/workerd-executor/executor" \
        344 \
        "$state_dir" \
        "$scope" \
        >"$temporary"; then
        rm -f -- "$temporary"
        return 1
    fi
    if [[ "$scope" == sql ]]; then
        check_capability_evidence \
            "$temporary" "runtime" \
            '.runtime == "workerd-on-hyperlight"' '.runtime' &&
            check_capability_evidence \
                "$temporary" "SQL rows" \
                '.sql.query_after_fresh_vm.results[0].rows == [[{"type":"integer","value":1},{"type":"text","value":"Ada"}]]' \
                '.sql.query_after_fresh_vm.results[0].rows' || {
            mv -f -- "$temporary" "$output_dir/capability-proof.failed.json"
            printf 'failed evidence: %s\n' \
                "$output_dir/capability-proof.failed.json" >&2
            return 1
        }
    else
        check_capability_evidence \
            "$temporary" "runtime" \
            '.runtime == "workerd-on-hyperlight"' '.runtime' &&
            check_capability_evidence \
                "$temporary" "scheduled outcome" \
                '.scheduled.outcome == "ok"' '.scheduled' &&
            check_capability_evidence \
                "$temporary" "queue acknowledgements" \
                '.queue.explicit_acks == ["message-1"]' '.queue.explicit_acks' &&
            check_capability_evidence \
                "$temporary" "queue retries" \
                '.queue.retry_messages == [{"id":"message-2","delay_seconds":7}]' \
                '.queue.retry_messages' &&
            check_capability_evidence \
                "$temporary" "CommonJS result" \
                '.node.commonjs == 42' '.node.commonjs' &&
            check_capability_evidence \
                "$temporary" "node:buffer result" \
                '.node.bufferHex == "68797065726c69676874"' '.node.bufferHex' &&
            check_capability_evidence \
                "$temporary" "identity denial" \
                '.policy.identity_denied.code == "identity_mismatch"' \
                '.policy.identity_denied' &&
            check_capability_evidence \
                "$temporary" "binding denial" \
                '.policy.binding_denied.code == "binding_denied"' \
                '.policy.binding_denied' &&
            check_capability_evidence \
                "$temporary" "operation quota denial" \
                '.policy.quota_denied.status == "quota_exceeded"' \
                '.policy.quota_denied' &&
            check_capability_evidence \
                "$temporary" "KV value" \
                '.kv.get_after_fresh_vm.value_base64 == "ZGFyaw=="' \
                '.kv.get_after_fresh_vm' &&
            check_capability_evidence \
                "$temporary" "Cache status" \
                '.cache.match_after_fresh_vm.cached_status == 200' \
                '.cache.match_after_fresh_vm' &&
            check_capability_evidence \
                "$temporary" "SQL rows" \
                '.sql.query_after_fresh_vm.results[0].rows == [[{"type":"integer","value":1},{"type":"text","value":"Ada"}]]' \
                '.sql.query_after_fresh_vm.results[0].rows' &&
            check_capability_evidence \
                "$temporary" "Durable Object value" \
                '.durable_object.get_after_fresh_vm.value_base64 == "aHlwZXJsaWdodA=="' \
                '.durable_object.get_after_fresh_vm' || {
            mv -f -- "$temporary" "$output_dir/capability-proof.failed.json"
            printf 'failed evidence: %s\n' \
                "$output_dir/capability-proof.failed.json" >&2
            return 1
        }
    fi
    mv "$temporary" "$proof"
    capability_proof_ran=true
}

run_ingress() {
    ensure_capability_proof || return
}

readonly_sqlite_query() {
    local database="$1"
    local sql="$2"
    local output="$3"
    local prefix="${output%.tsv}"
    printf "sqlite3 -readonly -batch -noheader -separator \$'\\t' %q %q\n" \
        "$database" "$sql" >"$prefix-command.txt"
    sha256sum "$database" >"$prefix.sha256"
    sqlite3 -readonly -batch -noheader -separator $'\t' \
        "$database" "$sql" >"$output"
}

clear_output() {
    local resolved
    resolved="$(normalize_path "$output_dir")"
    case "$resolved" in
        "$root"/*) ;;
        *)
            printf 'refusing to clear output outside this checkout: output=%s root=%s\n' \
                "$resolved" "$root" >&2
            return 2
            ;;
    esac
    [[ "$resolved" != "$root" ]] || {
        echo "refusing to clear the repository root" >&2
        return 2
    }
    rm -rf -- "$resolved"
