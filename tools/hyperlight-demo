        fi
    fi
}

print_wrapped() {
    local prefix="$1"
    local text="$2"
    local first=true
    while IFS= read -r line; do
        if "$first"; then
            printf '%s%s\n' "$prefix" "$line"
            first=false
        else
            printf '%*s%s\n' "${#prefix}" "" "$line"
        fi
    done < <(printf '%s\n' "$text" | fold -s -w "$((96 - ${#prefix}))")
}

