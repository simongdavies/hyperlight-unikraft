run_fetch() {
    local dir="$output_dir/fetch"
    mkdir -p "$dir"
    python3 - <<'PY' >"$dir/upstream.log" 2>&1 &
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
BODY = b"allowed-upstream\n"
class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/redirect":
            self.send_response(302)
            self.send_header("location", "/ok")
            self.send_header("content-length", "0")
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("content-length", str(len(BODY)))
        self.end_headers()
        self.wfile.write(BODY)
    def log_message(self, *_):
        pass
ThreadingHTTPServer(("127.0.0.1", 18080), Handler).serve_forever()
PY
    upstream_pid=$!
    local attempt
    for attempt in $(seq 1 100); do
        curl --silent --fail http://127.0.0.1:18080/ok >/dev/null && break
        kill -0 "$upstream_pid" 2>/dev/null || return 1
        sleep 0.1
    done
    curl --silent --fail http://127.0.0.1:18080/ok >/dev/null
    start_server "$dir/server.log" \
        --bundle "$root/examples/workerd-bundles/fetch-policy-demo.json" \
