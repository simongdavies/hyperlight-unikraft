        isolation) echo "Disposable isolation and timeout recovery" ;;
        policy) echo "Who is running, permissions, and usage limits" ;;
        ingress) echo "Scheduled events and message batches" ;;
        kv) echo "KV persistence" ;;
        cache) echo "Cache persistence" ;;
        sql) echo "SQL transactions" ;;
        durable-objects) echo "Durable Objects keep separate state" ;;
        storage) echo "Virtual filesystems and named storage" ;;
        node) echo "Node-style modules and file access" ;;
        core-wasm) echo "Core WebAssembly" ;;
        component) echo "Component Model fixture" ;;
        wasi-p2) echo "WASI Preview 2 portability" ;;
        wasi-p3) echo "WASI Preview 3 async streaming" ;;
        tcp-tls) echo "Controlled TCP and TLS connections" ;;
        udp) echo "Controlled UDP messages" ;;
        websocket) echo "Controlled WebSocket connections" ;;
        web-apis) echo "WinterTC and common Web APIs" ;;
