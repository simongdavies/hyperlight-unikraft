    case "$1" in
        isolation) echo "A failed request VM is disposable and does not poison recovery." ;;
        policy) echo "The Worker cannot change its own permissions or usage limits." ;;
        ingress) echo "The result comes back out of the VM; another program must connect a real service." ;;
        kv) echo "Configuration and application state can outlive disposable request VMs." ;;
        cache) echo "Cached responses can be reused without coupling them to one request VM." ;;
        sql) echo "Relational updates remain atomic even though request VMs are disposable." ;;
        durable-objects) echo "Each Durable Object keeps its own data across temporary VMs." ;;
        storage) echo "Filesystem access remains named, bounded, and least-privileged." ;;
        node) echo "Node-style code can use included APIs and files but cannot control the host operating system." ;;
        core-wasm) echo "Core Wasm composes with the same disposable VM lifecycle." ;;
        component) echo "The WebAssembly Component example builds and runs in Workerd on Hyperlight." ;;
        wasi-p2|wasi-p3) echo "Portable interfaces remain narrow, bounded, and recoverable." ;;
        tcp-tls|udp|websocket|fetch) echo "Network access is denied by default; the host opens only listed destinations." ;;
        web-apis) echo "Common Web APIs remain useful across strict isolation boundaries." ;;
        resident) echo "A resident VM keeps guest-visible state across requests until it is explicitly recycled." ;;
        multi-app) echo "One host process can route many independently configured apps by hostname." ;;
        orchestrator-contract) echo "An external orchestrator can rely on deterministic health, readiness, status, and shutdown behavior." ;;
        benchmark-on-demand|benchmark-prewarmed) echo "The same local request run shows the difference between creating VMs when needed and keeping VMs ready." ;;
        benchmark-resident|benchmark-multi-app|benchmark-orchestrator-contract) echo "Real hey load, not just functional checks, backs the resident/multi-app/orchestrator-contract claims." ;;
        *) return 1 ;;
    esac
}

