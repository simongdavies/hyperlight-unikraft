{
  "name": "hyperlight-workerd-component-model-evaluation",
  "private": true,
  "type": "module",
  "scripts": {
    "build:component": "wasm-tools parse component.wat -o component.wasm && wasm-tools validate --features component-model component.wasm",
    "transpile": "node scripts/transpile-workerd.mjs",
    "lock": "node scripts/lock.mjs",
    "probe": "node scripts/probe.mjs",
    "test": "node --test test/*.test.mjs",
    "serve": "workerd serve workerd.capnp componentEvaluation"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.35.0",
    "@bytecodealliance/preview2-shim": "0.26.0",
    "workerd": "1.20260925.1"
  }
}
