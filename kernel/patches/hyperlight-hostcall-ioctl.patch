diff --git a/plat/hyperlight/include/hyperlight/step.h b/plat/hyperlight/include/hyperlight/step.h
index 01f0219..247828f 100644
--- a/plat/hyperlight/include/hyperlight/step.h
+++ b/plat/hyperlight/include/hyperlight/step.h
@@ -146,0 +147,44 @@ struct hlcall_hostcall {
+/* Frozen typed-v1 bridge: the encoded size distinguishes this request from
+ * the generic HostCall API above. Existing executor binaries retain it.
+ */
+#define HLCALL_HOST_ABI_VERSION 1
+#define HLCALL_HOST_MAX_ARGS 4
+#define HLCALL_HOST_MAX_NAME 128
+
+enum hlcall_host_value_type {
+	HLCALL_HOST_I32 = 1,
+	HLCALL_HOST_U64 = 2,
+	HLCALL_HOST_STRING = 3,
+	HLCALL_HOST_VECBYTES = 4,
+};
+
+struct hlcall_host_arg {
+	__u32 type;
+	__u32 reserved;
+	__u64 value;
+	const void *data;
+	__u64 len;
+};
+
+struct hlcall_host_call {
+	__u32 version;
+	__u32 return_type;
+	const char *function;
+	__u64 function_len;
+	__u32 arg_count;
+	__u32 reserved;
+	struct hlcall_host_arg args[HLCALL_HOST_MAX_ARGS];
+	void *output;
+	__u64 output_cap;
+	__u64 output_len;
+	__s32 output_i32;
+	__u32 reserved2;
+	__u64 output_u64;
+};
+
+#define HLCALL_IOC_TYPED_HOSTCALL_V1 _IOWR('H', 3, struct hlcall_host_call)
+_Static_assert(sizeof(struct hlcall_hostcall) == 56, "generic host call layout");
+_Static_assert(sizeof(struct hlcall_host_call) == 200, "typed v1 host call layout");
+_Static_assert(HLCALL_IOC_HOSTCALL != HLCALL_IOC_TYPED_HOSTCALL_V1,
+	       "host call requests must remain distinct");
+
diff --git a/plat/hyperlight/step.c b/plat/hyperlight/step.c
index 9c942b4..54cc25f 100644
--- a/plat/hyperlight/step.c
+++ b/plat/hyperlight/step.c
@@ -654,0 +655,120 @@ static int hl_host_call(struct hlcall_hostcall *arg)
+static int hl_typed_host_call_v1(struct hlcall_host_call *arg)
+{
+	struct hlcall_host_call call = *arg;
+	struct hl_param params[HLCALL_HOST_MAX_ARGS];
+	char function[HLCALL_HOST_MAX_NAME + 1];
+	__u64 max = hl_hcall_max_payload();
+	__u64 used = 0;
+	__sz output_len = 0;
+	__s32 output_i32 = 0;
+	__u64 output_u64 = 0;
+	int rc;
+
+	if (!hl_call_in_flight)
+		return EPERM;
+	if (call.version != HLCALL_HOST_ABI_VERSION || call.reserved ||
+	    call.reserved2 || !call.function || !call.function_len ||
+	    call.function_len > HLCALL_HOST_MAX_NAME ||
+	    call.arg_count > HLCALL_HOST_MAX_ARGS)
+		return EINVAL;
+	if (!hl_reply_buf || !hl_args_buf)
+		return ENOMEM;
+	if (call.function_len > max)
+		return E2BIG;
+	memcpy(function, call.function, call.function_len);
+	if (memchr(function, '\0', call.function_len))
+		return EINVAL;
+	if (!hl_utf8_valid((const __u8 *)function, call.function_len))
+		return EILSEQ;
+	function[call.function_len] = '\0';
+	memset(params, 0, sizeof(params));
+
+	for (__u32 i = 0; i < call.arg_count; i++) {
+		const struct hlcall_host_arg *in = &call.args[i];
+		struct hl_param *out = &params[i];
+
+		if (in->reserved || in->len > (__u64)UINT32_MAX)
+			return EINVAL;
+		if (in->len > max - call.function_len - used)
+			return E2BIG;
+		switch (in->type) {
+		case HLCALL_HOST_I32:
+			if (in->data || in->len || in->value > (__u64)UINT32_MAX)
+				return EINVAL;
+			out->type = HL_PV_HLINT;
+			out->i32_val = (__s32)(__u32)in->value;
+			break;
+		case HLCALL_HOST_U64:
+			if (in->data || in->len)
+				return EINVAL;
+			out->type = HL_PV_HLULONG;
+			out->u64_val = in->value;
+			break;
+		case HLCALL_HOST_STRING:
+		case HLCALL_HOST_VECBYTES:
+			if ((!in->data && in->len) ||
+			    (!in->data && in->type == HLCALL_HOST_STRING))
+				return EINVAL;
+			if (in->len)
+				memcpy(hl_args_buf + used, in->data, in->len);
+			if (in->type == HLCALL_HOST_STRING) {
+				if (!hl_utf8_valid(hl_args_buf + used, in->len))
+					return EILSEQ;
+				out->type = HL_PV_HLSTRING;
+				out->str.ptr = (const char *)hl_args_buf + used;
+				out->str.len = (__u32)in->len;
+			} else {
+				out->type = HL_PV_HLVECBYTES;
+				out->vec.ptr = hl_args_buf + used;
+				out->vec.len = (__u32)in->len;
+			}
+			used += in->len;
+			break;
+		default:
+			return EINVAL;
+		}
+	}
+
+	switch (call.return_type) {
+	case HLCALL_HOST_I32:
+		if (call.output || call.output_cap)
+			return EINVAL;
+		rc = hl_hcall_int(function, params, call.arg_count, &output_i32);
+		break;
+	case HLCALL_HOST_U64:
+		if (call.output || call.output_cap)
+			return EINVAL;
+		rc = hl_hcall_ulong(function, params, call.arg_count, &output_u64);
+		break;
+	case HLCALL_HOST_STRING:
+	case HLCALL_HOST_VECBYTES:
+		if (!call.output || call.output_cap != hl_call_cap)
+			return EINVAL;
+		if (call.return_type == HLCALL_HOST_STRING)
+			rc = hl_hcall_string(function, params, call.arg_count,
+					    (char *)hl_reply_buf, hl_reply_cap,
+					    &output_len);
+		else
+			rc = hl_hcall_vecbytes(function, params, call.arg_count,
+					      hl_reply_buf, hl_reply_cap,
+					      &output_len);
+		if (rc < 0)
+			break;
+		arg->output_len = output_len;
+		if (output_len > call.output_cap)
+			return ENOBUFS;
+		memcpy(call.output, hl_reply_buf, output_len);
+		break;
+	default:
+		return EINVAL;
+	}
+	if (rc < 0)
+		return EIO;
+	arg->output_i32 = output_i32;
+	arg->output_u64 = output_u64;
+	if (call.return_type != HLCALL_HOST_STRING &&
+	    call.return_type != HLCALL_HOST_VECBYTES)
+		arg->output_len = 0;
+	return 0;
+}
+
@@ -666,0 +787,2 @@ static int hlcall_ioctl(struct device *dev __unused, unsigned long cmd,
+	case HLCALL_IOC_TYPED_HOSTCALL_V1:
+		return hl_typed_host_call_v1(arg);
