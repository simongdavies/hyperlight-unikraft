# Reproducible build environment for the Unikraft elfloader kernel.
# Pinned to Ubuntu 24.04 (gcc-13) so every machine produces the same binary.
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

# gcc-aarch64-linux-gnu cross-builds the arm64 kernel.
RUN apt-get update -q && \
    apt-get install -y --no-install-recommends \
        build-essential bison ca-certificates flex libncurses-dev make \
        python3 wget gcc-aarch64-linux-gnu && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /kernel
