# Keep LF in every checkout.  Guest scripts (examples/*.sh, *.py, …) are
# read on the host and executed inside a Linux guest, and just recipes are
# bash/pwsh scripts — both break on CRLF.  Binaries are detected by content.
* text=auto eol=lf
*.cpio binary
kernel/elfloader_hyperlight-x86_64 binary
experiments/workerd-component-model/*.patch whitespace=-blank-at-eol
# Shared protocol hashes pin exact bytes across the host/guest/platform repos.
docs/workerd-runtime-contract-v1.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
